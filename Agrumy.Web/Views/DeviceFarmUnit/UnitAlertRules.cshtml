@model RuleEditorViewModel
@{
    ViewData["Title"] = "Alert rules";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Units</a></li>
        <li class="breadcrumb-item"><a asp-action="Zones" asp-route-idDeviceFarmUnit="@Model.ScopeId">Zones</a></li>
        <li class="breadcrumb-item active" aria-current="page">Alert rules</li>
    </ol>
</nav>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}
@if (TempData["Warning"] is string scopeWarning)
{
    <div class="alert alert-info">@scopeWarning</div>
}

<p class="text-secondary">
    Notification rules only - see Automation rules for this unit's relay rules. Applies to
    every zone in this unit that doesn't define its own rule for the same name (a zone's own
    rule always wins - see the Zone page's automation card).
</p>

<partial name="_RuleEditor" model="Model" />
