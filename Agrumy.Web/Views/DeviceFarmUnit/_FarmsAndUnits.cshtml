@model Agrumy.Web.ViewModels.GroupedUnitCubesViewModel
@{
    // A lone farm (or none at all) isn't shown as its own object - no name, no card wrapper, no Rules/Rename/Delete anywhere near the units. Units become their own object only once a second farm exists to actually distinguish them from.
    bool multipleFarms = Model.Farms.Count > 1;
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    bool canManage = hasAnyRole(RoleNames.DeviceManagers);
    var unassigned = Model.Units.Where(u => u.DeviceFarmID == null).ToList();
    const string allUnitsContainerId = "unitCubes-all";
    const string unassignedUnitsContainerId = "unitCubes-unassigned";
    // Crop.FarmOpenfieldID points at the Farm's FarmOpenfield extension row, not at the Farm directly - map Farm -> FarmOpenfieldID once here rather than per-card.
    var openfieldIdByFarm = Model.Openfields.ToDictionary(o => o.FarmID, o => o.IDFarmOpenfield);
}
@if (!multipleFarms && (Model.Farms.Count == 0 || Model.Farms[0].FarmType != FarmType.OpenField))
{
    <div class="card">
        <div class="card-header d-flex align-items-center flex-wrap gap-2">
            <h3 class="card-title mb-0">Units</h3>
            <input type="search" class="form-control form-control-sm ms-auto unit-search" data-filter-target="unitCubes-all" placeholder="Search units..." style="max-width:14rem" aria-label="Search units" />
            @if (canManage)
            {
                <form asp-action="UnitAdd" method="post" class="d-flex gap-2">
                    <input type="text" name="deviceFarmUnitName" class="form-control form-control-sm" placeholder="New unit name" required maxlength="100" />
                    <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add Unit</button>
                </form>
            }
        </div>
        <div class="card-body">
            <p class="text-secondary small">
                Click a unit to see its zones. For a flat, fast-triage list of every device instead,
                see <a asp-controller="Device" asp-action="Fleet">Fleet</a>.
            </p>
            @if (canManage && Model.Farms.Count == 1 && unassigned.Count > 0)
            {
                <form asp-action="UnitAssignFarm" method="post" class="d-flex gap-2 mb-3">
                    <input type="hidden" name="idDeviceFarm" value="@Model.Farms[0].IDDeviceFarm" />
                    <select name="idDeviceFarmUnit" class="form-select form-select-sm" style="width:auto" required>
                        <option value="">-- add unit to farm --</option>
                        @foreach (var unit in unassigned)
                        {
                            <option value="@unit.IDDeviceFarmUnit">@unit.DeviceFarmUnitName</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Add to farm</button>
                </form>
            }
            <partial name="_UnitCubes" model="new UnitCubesListViewModel { Units = Model.Units, Farms = Model.Farms, ContainerId = allUnitsContainerId }" />
        </div>
    </div>
}
else if (!multipleFarms)
{
    // The sole farm is Open-Field typed - show its crops instead of the Units card above.
    var farm = Model.Farms[0];
    int? openfieldId = openfieldIdByFarm.GetValueOrDefault(farm.IDDeviceFarm ?? 0);
    var crops = Model.Crops.Where(c => c.FarmOpenfieldID == openfieldId).ToList();
    <div class="card">
        <div class="card-header d-flex align-items-center flex-wrap gap-2">
            <h3 class="card-title mb-0">Crops</h3>
            @if (canManage && openfieldId is int ofid)
            {
                <form asp-controller="FarmOpenfield" asp-action="CropAdd" method="post" class="d-flex gap-2 ms-auto">
                    <input type="hidden" name="idFarmOpenfield" value="@ofid" />
                    <input type="text" name="farmOpenfieldCropName" class="form-control form-control-sm" placeholder="New crop name" required maxlength="100" />
                    <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add Crop</button>
                </form>
            }
        </div>
        <div class="card-body">
            @if (crops.Count == 0)
            {
                <p class="text-secondary small fst-italic mb-0">No crops yet.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var c in crops)
                    {
                        <div class="col-md-4">
                            <div class="small-box text-bg-primary position-relative">
                                <div class="inner">
                                    <h3 class="fs-4">@c.FarmOpenfieldCropName <partial name="_ZoneStatusBadge" model="(c.Status, c.ProblemAlerts)" /></h3>
                                    <p class="mb-2">@c.ParcelCount parcel@(c.ParcelCount == 1 ? "" : "s") &middot; @c.DeviceCount device@(c.DeviceCount == 1 ? "" : "s")</p>
                                    <partial name="_SensorAverages" model="new SensorSummaryViewModel { Averages = c.Averages, Trend = c.Trend }" />
                                </div>
                                <div class="small-box-icon"><i class="bi bi-flower1"></i></div>
                                <a asp-controller="FarmOpenfield" asp-action="Parcels" asp-route-idFarmOpenfieldCrop="@c.IDFarmOpenfieldCrop" class="stretched-link" aria-label="Open @c.FarmOpenfieldCropName"></a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    @* id'd so farms-reorder.js can find it after every live-refresh re-render; data-id-device-farm on each card is the drag payload. *@
    <div id="farmCardsContainer">
    @foreach (var farm in Model.Farms)
    {
        var unitsInFarm = Model.Units.Where(u => u.DeviceFarmID == farm.IDDeviceFarm).ToList();
        var otherFarms = Model.Farms.Where(f => f.IDDeviceFarm != farm.IDDeviceFarm).ToList();
        string farmUnitsContainerId = $"unitCubes-farm-{farm.IDDeviceFarm}";
        <div class="card mb-3" data-id-device-farm="@farm.IDDeviceFarm">
            <div class="card-header">
                @if (canManage)
                {
                    <i class="bi bi-grip-vertical farm-drag-handle me-2" title="Drag to reorder" style="cursor:grab"></i>
                }
                <h3 class="card-title">@farm.DeviceFarmName</h3>
                <div class="float-end d-flex gap-2">
                    <a asp-action="DeviceFarmAlertRules" asp-route-idDeviceFarm="@farm.IDDeviceFarm" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-bell"></i> Alert rules
                    </a>
                    <a asp-action="DeviceFarmManualActuate" asp-route-idDeviceFarm="@farm.IDDeviceFarm" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-hand-index-thumb"></i> Manual actuate
                    </a>
                    <a asp-action="DeviceFarmRules" asp-route-idDeviceFarm="@farm.IDDeviceFarm" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-diagram-3"></i> Automation rules
                    </a>
                    @if (canManage)
                    {
                        <form asp-action="ScanFarm" method="post" class="d-inline">
                            <input type="hidden" name="FarmID" value="@farm.IDDeviceFarm" />
                            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-broadcast"></i> Scan for new devices</button>
                        </form>
                        <form asp-action="FarmRename" method="post" class="d-flex gap-1">
                            <input type="hidden" name="idDeviceFarm" value="@farm.IDDeviceFarm" />
                            <input type="text" name="deviceFarmName" class="form-control form-control-sm" value="@farm.DeviceFarmName" required maxlength="100" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Rename</button>
                        </form>
                        @* Delegated in farm-delete.js (not a per-button listener) - this card is inside the 10s live-refresh target, so a freshly re-rendered button must still work without DOMContentLoaded re-running. *@
                        <button type="button" class="btn btn-sm btn-outline-danger farm-delete-button" title="Delete"
                                data-id-device-farm="@farm.IDDeviceFarm" data-farm-name="@farm.DeviceFarmName" data-other-farm-count="@otherFarms.Count">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (farm.FarmType == FarmType.OpenField)
                {
                    int? openfieldId = openfieldIdByFarm.GetValueOrDefault(farm.IDDeviceFarm ?? 0);
                    var cropsInFarm = Model.Crops.Where(c => c.FarmOpenfieldID == openfieldId).ToList();
                    @if (canManage && openfieldId is int ofid)
                    {
                        <form asp-controller="FarmOpenfield" asp-action="CropAdd" method="post" class="d-flex gap-2 mb-3">
                            <input type="hidden" name="idFarmOpenfield" value="@ofid" />
                            <input type="text" name="farmOpenfieldCropName" class="form-control form-control-sm" placeholder="New crop name" required maxlength="100" />
                            <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add Crop</button>
                        </form>
                    }
                    @if (cropsInFarm.Count == 0)
                    {
                        <p class="text-secondary small fst-italic mb-0">No crops yet.</p>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var c in cropsInFarm)
                            {
                                <div class="col-md-4">
                                    <div class="small-box bg-hierarchy-mid position-relative">
                                        <div class="inner"><h3 class="fs-4">@c.FarmOpenfieldCropName</h3></div>
                                        <div class="small-box-icon"><i class="bi bi-flower1"></i></div>
                                        <a asp-controller="FarmOpenfield" asp-action="Parcels" asp-route-idFarmOpenfieldCrop="@c.IDFarmOpenfieldCrop" class="stretched-link" aria-label="Open @c.FarmOpenfieldCropName"></a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="d-flex justify-content-end mb-2">
                        <input type="search" class="form-control form-control-sm unit-search" data-filter-target="@farmUnitsContainerId" placeholder="Search units..." style="max-width:14rem" aria-label="Search units" />
                    </div>
                    @if (canManage && unassigned.Count > 0)
                    {
                        <form asp-action="UnitAssignFarm" method="post" class="d-flex gap-2 mb-3">
                            <input type="hidden" name="idDeviceFarm" value="@farm.IDDeviceFarm" />
                            <select name="idDeviceFarmUnit" class="form-select form-select-sm" style="width:auto" required>
                                <option value="">-- add unit --</option>
                                @foreach (var unit in unassigned)
                                {
                                    <option value="@unit.IDDeviceFarmUnit">@unit.DeviceFarmUnitName</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Add to farm</button>
                        </form>
                    }
                    @if (unitsInFarm.Count == 0)
                    {
                        <p class="text-secondary small fst-italic mb-0">No units assigned.</p>
                    }
                    else
                    {
                        <partial name="_UnitCubes" model="new UnitCubesListViewModel { Units = unitsInFarm, Farms = Model.Farms, ContainerId = farmUnitsContainerId }" />
                    }
                }
            </div>
        </div>
    }
    </div>

    @* Always rendered (not just when non-empty) - a newly created unit lands here, so this is where "Add Unit" has to live once units are no longer grouped under one single "Units" card. *@
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center flex-wrap gap-2">
            <h3 class="card-title mb-0">Unassigned Units</h3>
            <input type="search" class="form-control form-control-sm ms-auto unit-search" data-filter-target="unitCubes-unassigned" placeholder="Search units..." style="max-width:14rem" aria-label="Search units" />
            @if (canManage)
            {
                <form asp-action="UnitAdd" method="post" class="d-flex gap-2">
                    <input type="text" name="deviceFarmUnitName" class="form-control form-control-sm" placeholder="New unit name" required maxlength="100" />
                    <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add Unit</button>
                </form>
            }
        </div>
        <div class="card-body">
            @if (unassigned.Count == 0)
            {
                <p class="text-secondary small fst-italic mb-0">No unassigned units.</p>
            }
            else
            {
                <partial name="_UnitCubes" model="new UnitCubesListViewModel { Units = unassigned, Farms = Model.Farms, ContainerId = unassignedUnitsContainerId }" />
            }
        </div>
    </div>
}
