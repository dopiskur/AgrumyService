@model Agrumy.Web.ViewModels.UnitZonesViewModel
@{
    ViewData["Title"] = Model.Unit.DeviceFarmUnitName;
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    var renameModel = new InlineRenameViewModel
    {
        Action = nameof(Agrumy.Web.Controllers.View.DeviceFarmUnitController.UnitRename),
        IdFieldName = "idDeviceFarmUnit",
        IdValue = Model.Unit.IDDeviceFarmUnit!.Value,
        NameFieldName = "deviceFarmUnitName",
        CurrentName = Model.Unit.DeviceFarmUnitName,
    };
}

@{
    // The Farm segment only appears once an organization has a second farm (same threshold as Farms.cshtml/the dashboard grouping).
    bool multipleFarms = Model.Farms.Count > 1;
    var unitFarm = multipleFarms ? Model.Farms.FirstOrDefault(f => f.IDDeviceFarm == Model.Unit.DeviceFarmID) : null;
    var otherUnits = Model.Units.Where(u => u.IDDeviceFarmUnit != Model.Unit.IDDeviceFarmUnit).ToList();
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        @if (multipleFarms)
        {
            <li class="breadcrumb-item"><a asp-action="Farms">Greenhouse</a></li>
            @if (unitFarm != null)
            {
                <li class="breadcrumb-item">@unitFarm.DeviceFarmName</li>
            }
        }
        <li class="breadcrumb-item"><a asp-action="Index">Units</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Unit.DeviceFarmUnitName</li>
    </ol>
</nav>

@if (TempData["Message"] is string manualMessage)
{
    <div class="alert alert-success">@manualMessage</div>
}
@if (TempData["Error"] is string manualError)
{
    <div class="alert alert-warning">@manualError</div>
}

@* Always visible, no scrolling needed - separate from the Discovered devices card below (which only renders when there's something to show) so these controls never disappear along with an empty results list. *@
@if (hasAnyRole(RoleNames.DeviceManagers))
{
    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
        <a asp-action="UnitAlertRules" asp-route-idDeviceFarmUnit="@Model.Unit.IDDeviceFarmUnit" class="btn btn-sm btn-outline-primary text-nowrap">
            <i class="bi bi-bell"></i> Alert rules
        </a>
        <a asp-action="UnitManualActuate" asp-route-idDeviceFarmUnit="@Model.Unit.IDDeviceFarmUnit" class="btn btn-sm btn-outline-primary text-nowrap">
            <i class="bi bi-hand-index-thumb"></i> Manual actuate
        </a>
        <a asp-action="UnitRules" asp-route-idDeviceFarmUnit="@Model.Unit.IDDeviceFarmUnit" class="btn btn-sm btn-outline-primary text-nowrap">
            <i class="bi bi-diagram-3"></i> Automation rules
        </a>
        <form asp-action="ScanUnit" method="post" class="d-inline">
            <input type="hidden" name="UnitID" value="@Model.Unit.IDDeviceFarmUnit" />
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-broadcast"></i> Scan for new devices</button>
        </form>
    </div>
    @if (Model.DiscoveredDevices.Count > 0)
    {
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Discovered devices</h3>
            </div>
            <div class="card-body">
                <partial name="_DiscoveredDevicesRows" model="Model.DiscoveredDevices" />
            </div>
        </div>
    }
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            @Model.Unit.DeviceFarmUnitName - Zones
            @if (hasAnyRole(RoleNames.DeviceManagers))
            {
                <partial name="_InlineRename" model="renameModel" />
            }
        </h3>
        @if (hasAnyRole(RoleNames.DeviceManagers))
        {
            <div class="float-end d-flex align-items-center gap-3">
                <partial name="_DeviceCommandButtons" model="new DeviceCommandButtonsViewModel { TargetType = CommandTargetType.Unit, TargetId = Model.Unit.IDDeviceFarmUnit!.Value }" />
                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#unitWifiUpdateModal">
                    <i class="bi bi-wifi"></i> Switch network
                </button>
                @if (Model.Zones.Count > 0 && otherUnits.Count > 0)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#zoneMigrateModal">
                        <i class="bi bi-signpost-split"></i> Migrate zone
                    </button>
                }
                <input type="search" class="form-control form-control-sm zone-search" data-filter-target="zoneCubes" placeholder="Search zones..." style="max-width:12rem" aria-label="Search zones" />
                <form asp-action="ZoneAdd" method="post" class="d-flex gap-2">
                    <input type="hidden" name="idDeviceFarmUnit" value="@Model.Unit.IDDeviceFarmUnit" />
                    <input type="text" name="deviceFarmUnitZoneName" class="form-control form-control-sm" placeholder="New zone name" required maxlength="120" />
                    <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add Zone</button>
                </form>
                <form asp-action="UnitDelete" method="post" onsubmit="return confirm('Delete this unit and every zone in it? Devices are unassigned, not deleted.');">
                    <input type="hidden" name="idDeviceFarmUnit" value="@Model.Unit.IDDeviceFarmUnit" />
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete unit"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        }
    </div>
    <div class="card-body">
        <div class="row" id="zoneCubes">
            <partial name="_ZoneCubes" model="Model.Zones" />
        </div>
    </div>
</div>

@* Outside #zoneCubes - a re-rendered ECharts instance on every 10s poll would reset zoom/pan for no reason. *@
<div class="card">
    <div class="card-header"><h3 class="card-title">Unit trends (last 24h, averaged across every zone's devices)</h3></div>
    <div class="card-body">
        @{ ViewBag.DisplayTimeZone = Model.DisplayTimeZone; }
        <partial name="_SensorCharts" model="new DeviceView { SensorDataJson = Model.SensorDataJson }" />
    </div>
</div>

<div class="modal fade" id="unitWifiUpdateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UnitWifiUpdate" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Switch network for this unit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="idDeviceFarmUnit" value="@Model.Unit.IDDeviceFarmUnit" />
                    <p>
                        This affects every device currently assigned to this unit (across all its
                        zones). Each device connects to the new network and verifies it can still
                        reach this server before switching - it stays on its current network if
                        that check fails, same as the per-device switch.
                    </p>
                    <div class="mb-3">
                        <label class="form-label" for="unitWifiSsid">SSID</label>
                        <input type="text" id="unitWifiSsid" name="ssid" class="form-control" required maxlength="32" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="unitWifiPassword">Password</label>
                        <input type="password" id="unitWifiPassword" name="wifiPassword" class="form-control" maxlength="64" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Switch network</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.Zones.Count > 0 && otherUnits.Count > 0)
{
    <div class="modal fade" id="zoneMigrateModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="ZoneMigrate" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">Migrate zone to another unit</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="idDeviceFarmUnit" value="@Model.Unit.IDDeviceFarmUnit" />
                        <div class="mb-3">
                            <label class="form-label" for="zoneMigrateZone">Zone</label>
                            <select class="form-select" id="zoneMigrateZone" name="idDeviceFarmUnitZone" required>
                                @foreach (var z in Model.Zones)
                                {
                                    <option value="@z.IDDeviceFarmUnitZone">@z.DeviceFarmUnitZoneName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-0">
                            <label class="form-label" for="zoneMigrateTarget">Target unit</label>
                            <select class="form-select" id="zoneMigrateTarget" name="idTargetDeviceFarmUnit" required>
                                <option value="" selected disabled>Choose a unit...</option>
                                @if (multipleFarms)
                                {
                                    @foreach (var farm in Model.Farms)
                                    {
                                        var unitsInFarm = otherUnits.Where(u => u.DeviceFarmID == farm.IDDeviceFarm).ToList();
                                        @if (unitsInFarm.Count > 0)
                                        {
                                            <optgroup label="@farm.DeviceFarmName">
                                                @foreach (var u in unitsInFarm)
                                                {
                                                    <option value="@u.IDDeviceFarmUnit">@u.DeviceFarmUnitName</option>
                                                }
                                            </optgroup>
                                        }
                                    }
                                    var unassignedUnits = otherUnits.Where(u => u.DeviceFarmID == null).ToList();
                                    @if (unassignedUnits.Count > 0)
                                    {
                                        <optgroup label="Unassigned">
                                            @foreach (var u in unassignedUnits)
                                            {
                                                <option value="@u.IDDeviceFarmUnit">@u.DeviceFarmUnitName</option>
                                            }
                                        </optgroup>
                                    }
                                }
                                else
                                {
                                    @foreach (var u in otherUnits)
                                    {
                                        <option value="@u.IDDeviceFarmUnit">@u.DeviceFarmUnitName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Migrate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="registerDeviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RegisterDiscoveredDeviceFarmUnit" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Register discovered device</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="DiscoveredApMac" id="registerApMac" />
                    <input type="hidden" name="UnitID" value="@Model.Unit.IDDeviceFarmUnit" />
                    <div class="mb-3">
                        <label class="form-label" for="registerDeviceName">Name (optional)</label>
                        <input type="text" name="DeviceName" id="registerDeviceName" class="form-control" maxlength="128" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="registerZoneSelect">Zone</label>
                        <select class="form-select" name="ZoneID" id="registerZoneSelect">
                            @foreach (var zone in Model.Zones)
                            {
                                <option value="@zone.IDDeviceFarmUnitZone">@zone.DeviceFarmUnitZoneName</option>
                            }
                        </select>
                    </div>
                    <partial name="_WifiConfigFields" model="Model.WifiConfigs" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/live-filter.js"></script>
    <script src="~/js/live-refresh.js"></script>
    <script nonce="@Context.CspNonce()">
        document.addEventListener('DOMContentLoaded', function () {
            wireLiveFilters('.zone-search', '.zone-cube');
            startLiveRefresh({
                url: '@Url.Action("ZonesCubes", new { idDeviceFarmUnit = Model.Unit.IDDeviceFarmUnit })',
                applyHtml: function (html) {
                    document.getElementById('zoneCubes').innerHTML = html;
                    document.querySelector('.zone-search')?.dispatchEvent(new Event('input'));
                }
            });

            var registerModal = document.getElementById('registerDeviceModal');
            if (registerModal)
            {
                registerModal.addEventListener('show.bs.modal', function (event) {
                    document.getElementById('registerApMac').value = event.relatedTarget.getAttribute('data-ap-mac');
                });
            }
        });
    </script>
}
