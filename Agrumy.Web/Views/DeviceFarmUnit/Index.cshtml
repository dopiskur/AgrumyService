@model Agrumy.Web.ViewModels.DashboardWizardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Step 1 - pick a zone</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary small">
            Build a zone's custom dashboard - sensor value, sensor trend, relay status, or text widgets.
            For the live status overview instead, see <a asp-action="Farms">Farm</a>.
        </p>
        @if (!Model.Zones.Any())
        {
            <p class="text-secondary fst-italic">No zones yet - add a unit on the <a asp-action="Farms">Farm</a> page first.</p>
        }
        else
        {
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <select name="idDeviceFarmUnitZone" class="form-select" style="max-width:24rem" onchange="this.form.requestSubmit()">
                    <option value="">-- select a zone --</option>
                    @foreach (var group in Model.Zones.GroupBy(z => z.GroupLabel))
                    {
                        <optgroup label="@group.Key">
                            @foreach (var z in group)
                            {
                                <option value="@z.IDDeviceFarmUnitZone" selected="@(z.IDDeviceFarmUnitZone == Model.SelectedZoneId ? "selected" : null)">@z.ZoneName</option>
                            }
                        </optgroup>
                    }
                </select>
                <noscript><button type="submit" class="btn btn-outline-secondary">Go</button></noscript>
            </form>
        }
    </div>
</div>

@if (Model.Selected != null)
{
    <div class="mt-3">
        <h6 class="fw-semibold mb-2">Step 2 - build the dashboard for @Model.Selected.Zone.DeviceFarmUnitZoneName</h6>
        <partial name="_DashboardWidgets" model="Model.Selected" />
    </div>
}
else if (Model.Zones.Any())
{
    <p class="text-secondary fst-italic mt-3">Pick a zone above to start building its dashboard.</p>
}
