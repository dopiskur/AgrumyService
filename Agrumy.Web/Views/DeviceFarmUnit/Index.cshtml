@model Agrumy.Web.ViewModels.DashboardWizardViewModel
@{
    ViewData["Title"] = "Build Dashboard";
    bool hasAny = Model.Zones.Any() || Model.Parcels.Any();
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Pick which zone or parcel's dashboard page to edit</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary small">
            Only picks which page you're building - each widget you add below chooses its own
            data source (a Farm-wide average, a Unit-specific average, or one specific zone) independently.
            For the live status overview instead, see <a asp-action="Farms">Farm</a>.
        </p>
        @if (!hasAny)
        {
            <p class="text-secondary fst-italic">No zones or parcels yet - add a unit or crop on the <a asp-action="Farms">Farm</a> page first.</p>
        }
        else
        {
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <select id="wizardTargetSelect" name="@(Model.SelectedParcelId != null ? "idFarmOpenfieldCropParcel" : "idDeviceFarmUnitZone")" class="form-select" style="max-width:24rem" onchange="this.form.requestSubmit()">
                    <option value="">-- select a zone or parcel --</option>
                    @if (Model.Zones.Any())
                    {
                        @foreach (var group in Model.Zones.GroupBy(z => z.GroupLabel))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var z in group)
                                {
                                    <option value="@z.IDDeviceFarmUnitZone" data-kind="zone" selected="@(z.IDDeviceFarmUnitZone == Model.SelectedZoneId ? "selected" : null)">@z.ZoneName</option>
                                }
                            </optgroup>
                        }
                    }
                    @if (Model.Parcels.Any())
                    {
                        @foreach (var group in Model.Parcels.GroupBy(p => p.GroupLabel))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var p in group)
                                {
                                    <option value="@p.IDFarmOpenfieldCropParcel" data-kind="parcel" selected="@(p.IDFarmOpenfieldCropParcel == Model.SelectedParcelId ? "selected" : null)">@p.ParcelName</option>
                                }
                            </optgroup>
                        }
                    }
                </select>
                <noscript><button type="submit" class="btn btn-outline-secondary">Go</button></noscript>
            </form>
            <script nonce="@Context.CspNonce()">
                document.getElementById('wizardTargetSelect').addEventListener('change', function () {
                    var kind = this.options[this.selectedIndex]?.dataset.kind;
                    this.name = kind === 'parcel' ? 'idFarmOpenfieldCropParcel' : 'idDeviceFarmUnitZone';
                });
            </script>
        }
    </div>
</div>

@if (Model.Selected != null)
{
    <div class="mt-3">
        <h6 class="fw-semibold mb-2">Widgets on @Model.Selected.Leaf.Name's dashboard page</h6>
        <partial name="_DashboardWidgets" model="Model.Selected" />
    </div>
}
else if (hasAny)
{
    <p class="text-secondary fst-italic mt-3">Pick a zone or parcel above to start building its dashboard.</p>
}
