@using Agrumy.Shared.Models
@model Agrumy.Web.ViewModels.DashboardWidgetsViewModel
@{
    // Farm/Unit/Zone only, matching the AlertStatus/SensorValue "aggregation level" pickers elsewhere - Crop/Parcel scopes aren't offered on the single-widget form either.
}
<label class="form-label d-block">2. Where should these apply? (pick one or more)</label>
<div class="mb-2 p-2 border rounded" style="max-height:12rem;overflow-y:auto">
    @if (Model.Farms.Any())
    {
        <div class="fw-semibold small text-secondary">Farms</div>
        @foreach (var f in Model.Farms)
        {
            <div class="form-check">
                <input type="checkbox" class="form-check-input" name="scopes" value="@($"{(int)HierarchyNodeKind.Farm}:{f.IDDeviceFarm}")" id="wizScopeFarm_@f.IDDeviceFarm" />
                <label class="form-check-label small" for="wizScopeFarm_@f.IDDeviceFarm">@f.DeviceFarmName</label>
            </div>
        }
    }
    @if (Model.Units.Any())
    {
        <div class="fw-semibold small text-secondary mt-1">Units</div>
        @foreach (var u in Model.Units)
        {
            <div class="form-check">
                <input type="checkbox" class="form-check-input" name="scopes" value="@($"{(int)HierarchyNodeKind.Unit}:{u.IDDeviceFarmUnit}")" id="wizScopeUnit_@u.IDDeviceFarmUnit" />
                <label class="form-check-label small" for="wizScopeUnit_@u.IDDeviceFarmUnit">@u.DeviceFarmUnitName</label>
            </div>
        }
    }
    @if (Model.Zones.Any())
    {
        <div class="fw-semibold small text-secondary mt-1">Zones</div>
        @foreach (var z in Model.Zones)
        {
            <div class="form-check">
                <input type="checkbox" class="form-check-input" name="scopes" value="@($"{(int)HierarchyNodeKind.Zone}:{z.IDDeviceFarmUnitZone}")" id="wizScopeZone_@z.IDDeviceFarmUnitZone" />
                <label class="form-check-label small" for="wizScopeZone_@z.IDDeviceFarmUnitZone">@z.GroupLabel / @z.ZoneName</label>
            </div>
        }
    }
</div>
