@model Agrumy.Web.ViewModels.FarmListViewModel
@{
    bool multipleFarms = Model.Farms.Count > 1;
    ViewData["Title"] = multipleFarms ? "Greenhouses" : "Greenhouse";
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    bool canManage = hasAnyRole(RoleNames.DeviceManagers);
}

@if (TempData["Message"] is string scanMessage)
{
    <div class="alert alert-success">@scanMessage</div>
}
@if (TempData["Error"] is string scanError)
{
    <div class="alert alert-warning">@scanError</div>
}

@* Manual actuate/Automation rules/Scan for the sole greenhouse - immediately visible above everything else, applies to every unit/zone assigned to it. Multi-greenhouse case gets the same buttons once you open an individual card instead. *@
@if (Model.Farms.Count == 1)
{
    <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
        <a asp-action="DeviceFarmAlertRules" asp-route-idDeviceFarm="@Model.Farms[0].IDDeviceFarm" class="btn btn-sm btn-outline-primary text-nowrap">
            <i class="bi bi-bell"></i> Alert rules
        </a>
        <a asp-action="DeviceFarmManualActuate" asp-route-idDeviceFarm="@Model.Farms[0].IDDeviceFarm" class="btn btn-sm btn-outline-primary text-nowrap">
            <i class="bi bi-hand-index-thumb"></i> Manual actuate
        </a>
        <a asp-action="DeviceFarmRules" asp-route-idDeviceFarm="@Model.Farms[0].IDDeviceFarm" class="btn btn-sm btn-outline-primary text-nowrap">
            <i class="bi bi-diagram-3"></i> Automation rules
        </a>
        <form asp-action="ScanFarm" method="post" class="d-inline">
            <input type="hidden" name="FarmID" value="@Model.Farms[0].IDDeviceFarm" />
            <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap"><i class="bi bi-broadcast"></i> Scan for new devices</button>
        </form>
    </div>
}
@* "Add Greenhouse" stays immediately visible above the greenhouse cards (roadmap correction - it used to sit below them, which meant scrolling past every existing greenhouse/unit cube just to find where to add a new one). Open-Field farms are added on their own page (D1), not here. *@
@if (canManage)
{
    <div class="mb-3 d-flex justify-content-end">
        <form asp-action="FarmAdd" method="post" class="d-flex gap-2">
            <input type="text" name="deviceFarmName" class="form-control form-control-sm" placeholder="New greenhouse name" required maxlength="100" />
            <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add Greenhouse</button>
        </form>
    </div>
}

@* Live-refreshed as a whole (10s) - farm cards and their nested unit cubes are one structural unit now, not two separately-refreshed pieces, so a farm's Rules/Rename/Delete controls live inside the same poll target as its units. *@
<div id="farmsAndUnits">
    <partial name="_FarmsAndUnits" model="new GroupedUnitCubesViewModel { Units = Model.Units, Farms = Model.Farms }" />
</div>

@* Delete is a real destructive cascade (farm + its units/zones/devices all go to the Recycle Bin together), not the old "units survive, just unassigned" behavior - offer migrating units to another farm first when one exists. *@
<form id="farmDeleteForm" asp-action="FarmDelete" method="post">
    <input type="hidden" id="farmDeleteId" name="idDeviceFarm" />
</form>

<div class="modal fade" id="farmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete farm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="farmDeleteMigrateSection" style="display:none">
                    <p>Move this farm's units to another farm first, or continue to delete everything.</p>
                    <select id="farmDeleteMigrateTarget" class="form-select mb-2">
                        <option value="">-- select a farm --</option>
                        @foreach (var f in Model.Farms)
                        {
                            <option value="@f.IDDeviceFarm">@f.DeviceFarmName</option>
                        }
                    </select>
                    <button type="button" id="farmDeleteMigrateButton" class="btn btn-outline-primary btn-sm mb-3">Migrate units, don't delete</button>
                    <hr />
                </div>
                <p class="text-danger">
                    This permanently deletes <strong id="farmDeleteNameLabel"></strong> AND every unit/zone/device
                    still assigned to it. Everything goes to the Recycle Bin (recoverable there for the
                    configured retention period), but this cannot be undone from this page.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="farmDeleteConfirmButton" class="btn btn-danger">Delete everything</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sortablejs/Sortable.min.js"></script>
    <script src="~/js/farm-delete.js"></script>
    <script src="~/js/farms-reorder.js"></script>
    <script src="~/js/units-reorder.js"></script>
    <script src="~/js/live-filter.js"></script>
    <script src="~/js/live-refresh.js"></script>
    <script nonce="@Context.CspNonce()">
        document.addEventListener('DOMContentLoaded', function () {
            wireLiveFilters('.unit-search', '.unit-cube');
            startLiveRefresh({
                url: '@Url.Action("IndexCubes")',
                applyHtml: function (html) {
                    // Skip this tick rather than yank the cards out from under an in-progress drag - the next tick picks up normally once the drop lands.
                    if (window.farmDragInProgress || window.unitDragInProgress) {
                        return;
                    }
                    document.getElementById('farmsAndUnits').innerHTML = html;
                    initFarmDragReorder();
                    initUnitDragReorder();
                    wireLiveFilters('.unit-search', '.unit-cube');
                }
            });
        });
    </script>
}
