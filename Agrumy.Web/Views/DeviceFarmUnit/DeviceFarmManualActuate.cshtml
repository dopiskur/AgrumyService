@model DeviceFarmManualActuateViewModel
@{
    ViewData["Title"] = "Manual actuate";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Farms">Farms</a></li>
        <li class="breadcrumb-item active" aria-current="page">Manual actuate</li>
    </ol>
</nav>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Manual actuate (all units/zones)</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary small">
            Fans out to every controller across every unit/zone assigned to this farm - a zone with
            no MaxRunSeconds configured for a Target-mode command is skipped, not failed outright.
        </p>
        <partial name="_ManualActuateFunction" model="Model.Heating" />
        <partial name="_ManualActuateFunction" model="Model.Ventilation" />
        <partial name="_ManualActuateFunction" model="Model.Irrigation" />
    </div>
</div>
