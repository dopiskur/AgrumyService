@model Agrumy.Web.ViewModels.GroupedUnitCubesViewModel
@{
    // While there's only one farm it stays invisible (same rule as Farms.cshtml), units render flat exactly as before. A second farm existing is what turns this into Farm > Unit grouping.
    bool multipleFarms = Model.Farms.Count > 1;
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    bool canManage = hasAnyRole(RoleNames.DeviceManagers);
    var unassigned = Model.Units.Where(u => u.DeviceFarmID == null).ToList();
}
@if (!multipleFarms)
{
    @* Roadmap #429 - a lone farm still isn't shown as its own object (no heading), but "add unit to farm" stays available - only the grouping chrome disappears, not the capability. *@
    @if (canManage && Model.Farms.Count == 1 && unassigned.Count > 0)
    {
        <div class="col-12 mb-2">
            <form asp-action="UnitAssignFarm" method="post" class="d-flex gap-2">
                <input type="hidden" name="idDeviceFarm" value="@Model.Farms[0].IDDeviceFarm" />
                <select name="idDeviceFarmUnit" class="form-select form-select-sm" style="width:auto" required>
                    <option value="">-- add unit to farm --</option>
                    @foreach (var unit in unassigned)
                    {
                        <option value="@unit.IDDeviceFarmUnit">@unit.DeviceFarmUnitName</option>
                    }
                </select>
                <button type="submit" class="btn btn-sm btn-outline-primary">Add to farm</button>
            </form>
        </div>
    }
    <partial name="_UnitCubes" model="new UnitCubesListViewModel { Units = Model.Units, Farms = Model.Farms }" />
}
else
{
    @foreach (var farm in Model.Farms)
    {
        var unitsInFarm = Model.Units.Where(u => u.DeviceFarmID == farm.IDDeviceFarm).ToList();
        if (unitsInFarm.Count == 0 && !canManage)
        {
            continue;
        }
        <div class="col-12 mt-2 mb-1 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="text-secondary mb-0"><i class="bi bi-map"></i> @farm.DeviceFarmName</h5>
            @if (canManage && unassigned.Count > 0)
            {
                <form asp-action="UnitAssignFarm" method="post" class="d-flex gap-2">
                    <input type="hidden" name="idDeviceFarm" value="@farm.IDDeviceFarm" />
                    <select name="idDeviceFarmUnit" class="form-select form-select-sm" style="width:auto" required>
                        <option value="">-- add unit --</option>
                        @foreach (var unit in unassigned)
                        {
                            <option value="@unit.IDDeviceFarmUnit">@unit.DeviceFarmUnitName</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Add to farm</button>
                </form>
            }
        </div>
        @if (unitsInFarm.Count == 0)
        {
            <div class="col-12 mb-2"><p class="text-secondary small fst-italic">No units assigned.</p></div>
        }
        else
        {
            <partial name="_UnitCubes" model="new UnitCubesListViewModel { Units = unitsInFarm, Farms = Model.Farms }" />
        }
    }
    @if (unassigned.Count > 0)
    {
        <div class="col-12 mt-2 mb-1">
            <h5 class="text-secondary">Unassigned</h5>
        </div>
        <partial name="_UnitCubes" model="new UnitCubesListViewModel { Units = unassigned, Farms = Model.Farms }" />
    }
}
