@model RuleEditorViewModel
@{
    ViewData["Title"] = "Alert rules";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Farms">Greenhouse</a></li>
        <li class="breadcrumb-item active" aria-current="page">Alert rules</li>
    </ol>
</nav>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}
@if (TempData["Warning"] is string scopeWarning)
{
    <div class="alert alert-info">@scopeWarning</div>
}

<p class="text-secondary">
    Notification rules only - see Automation rules for this farm's relay rules. Applies to
    every unit/zone assigned to this farm that doesn't define its own rule for the same name
    (a unit or zone's own rule always wins - Zone &gt; Unit &gt; Farm &gt; Global).
</p>

<partial name="_RuleEditor" model="Model" />
