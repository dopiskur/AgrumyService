@model Agrumy.Shared.Models.DeviceDto

@{
    ViewData["Title"] = "Details";
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    bool isReadOnly = ViewBag.IsReadOnly is true;
    var renameModel = new InlineRenameViewModel
    {
        Action = nameof(Agrumy.Web.Controllers.View.DeviceController.RenameDevice),
        IdFieldName = "idDevice",
        IdValue = Model.IDDevice!.Value,
        NameFieldName = "deviceName",
        CurrentName = Model.DeviceName,
    };

    var sensorToggle = new EnabledToggleFieldViewModel { Name = "deviceSensorEnabled", Label = "Sensor", Value = Model.DeviceSensorEnabled };
    var controllerToggle = new EnabledToggleFieldViewModel { Name = "deviceControllerEnabled", Label = "Controller", Value = Model.DeviceControllerEnabled };
    var sleepDeepToggle = new EnabledToggleFieldViewModel { Name = "sleepDeepEnabled", Label = "SleepDeep", Value = Model.SleepDeepEnabled };
    var powerRailPrimaryToggle = new EnabledToggleFieldViewModel { Name = "powerRailPrimaryEnabled", Label = "Power rail - analog", Value = Model.PowerRailPrimaryEnabled };
    var powerRailSecondaryToggle = new EnabledToggleFieldViewModel { Name = "powerRailSecondaryEnabled", Label = "Power rail - digital", Value = Model.PowerRailSecondaryEnabled };
    // Standalone/dual-role LoRa Gateway relay; firmware only actually starts listening if it detects the LoRa radio chip physically present (see the event log otherwise).
    var loRaGatewayToggle = new EnabledToggleFieldViewModel { Name = "loRaGatewayEnabled", Label = "LoRa", Value = Model.LoRaGatewayEnabled };
    var batteryToggle = new EnabledToggleFieldViewModel { Name = "batteryEnabled", Label = "Device battery", Value = Model.BatteryEnabled };
    var debugToggle = new EnabledToggleFieldViewModel { Name = "debug", Label = "Debug", Value = Model.Debug };
    var enabledToggle = new EnabledToggleFieldViewModel { Name = "enabled", Label = "Device", Value = Model.Enabled };
}

@if (TempData["HardResetMessage"] is string hardResetMessage)
{
    <div class="alert alert-success">@hardResetMessage</div>
}
@if (TempData["HardResetError"] is string hardResetError)
{
    <div class="alert alert-warning">@hardResetError</div>
}
@if (ViewBag.MqttCredentialsPendingSync == true)
{
    <div class="alert alert-info">
        MQTT credentials pending sync - this device's ApiId/ApiKey aren't in the broker's ACL yet
        (agrumy-mqtt-sync.timer runs every 5 minutes). It can still reach the server over the normal
        HTTP poll cycle in the meantime.
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            @Model.DeviceName
            @if (hasAnyRole(RoleNames.DeviceManagers) || isReadOnly)
            {
                <partial name="_InlineRename" model="renameModel" />
            }
        </h3>
        <div class="float-end d-flex align-items-center gap-2">
            @if (hasAnyRole(RoleNames.DeviceManagers) || isReadOnly)
            {
                <partial name="_DeviceCommandButtons" model="new DeviceCommandButtonsViewModel { TargetType = CommandTargetType.Device, TargetId = Model.IDDevice!.Value }" />
            }
            <a asp-action="Edit" asp-route-idDevice="@Model.IDDevice" class="btn btn-sm btn-primary">Advanced</a>
            <a asp-action="EditSensor" asp-route-idDevice="@Model.IDDevice" class="btn btn-sm btn-primary">Sensor config</a>
            @* Hidden when there's no relay-hardware signal (DeviceRole choice AND no recognized Kit) - avoids a control that does nothing. *@
            @if (ViewBag.ControllerCapable == true)
            {
                <a asp-action="EditController" asp-route-idDevice="@Model.IDDevice" class="btn btn-sm btn-primary">Controller config</a>
            }
            <a asp-action="Events" asp-route-idDevice="@Model.IDDevice" class="btn btn-sm btn-secondary">Events</a>
            @* Delete's own GET is already DeviceManagersOrGlobalReader - a reader can open the confirm page, its own Confirm button is what's disabled. *@
            <a asp-action="Delete" asp-route-idDevice="@Model.IDDevice" class="btn btn-sm btn-danger">Delete</a>
            @if (hasAnyRole(RoleNames.GlobalAdmin) || isReadOnly)
            {
                <form asp-action="HardReset" asp-route-idDevice="@Model.IDDevice" method="post" class="d-inline"
                      data-confirm="This wipes the device completely (factory reset) - it will need physical/captive-portal re-provisioning afterward. Continue?">
                    <button type="submit" class="btn btn-sm btn-danger" disabled="@isReadOnly"><i class="bi bi-exclamation-octagon"></i> Hard Reset</button>
                </form>
            }
            <a asp-action="Fleet" class="btn btn-sm btn-outline-secondary">Back to List</a>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <div class="border rounded p-3 h-100">
                    <form asp-action="QuickSettings" method="post" id="quick-settings-form">
                        <fieldset disabled="@isReadOnly" class="border-0 p-0 m-0">
                            <input type="hidden" name="idDevice" value="@Model.IDDevice" />
                            <partial name="_EnabledToggleField" model="sensorToggle" />
                            <partial name="_EnabledToggleField" model="controllerToggle" />
                            <partial name="_EnabledToggleField" model="loRaGatewayToggle" />
                            <partial name="_EnabledToggleField" model="batteryToggle" />
                            <partial name="_EnabledToggleField" model="debugToggle" />
                            <partial name="_EnabledToggleField" model="enabledToggle" />
                            <hr class="my-3" />
                            <div class="mb-2 fw-semibold">Power saving options</div>
                            <partial name="_EnabledToggleField" model="sleepDeepToggle" />
                            <div id="sleep-seconds-field" class="mb-3" hidden="@(Model.SleepDeepEnabled != true)">
                                <label class="form-label">Sleep seconds</label>
                                <input type="number" name="sleepSeconds" value="@Model.SleepSeconds" class="form-control" />
                            </div>
                            <partial name="_EnabledToggleField" model="powerRailPrimaryToggle" />
                            <partial name="_EnabledToggleField" model="powerRailSecondaryToggle" />
                        </fieldset>
                    </form>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="border rounded p-3 h-100">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.MacAddress)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.MacAddress)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.ServicePoint)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.ServicePoint)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.ServicePublicKey)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.ServicePublicKey)
                        </dd>
                        @if (ViewBag.Kit is string { Length: > 0 } kit)
                        {
                            <dt class="col-sm-3">Kit</dt>
                            <dd class="col-sm-9">@kit</dd>
                        }
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.ConfigVersion)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.ConfigVersion)
                        </dd>
                        <dt class="col-sm-3">
                            Free heap
                        </dt>
                        <dd class="col-sm-9">
                            @(ViewBag.FreeHeapBytes is long heap ? $"{heap / 1024} KB" : "-")
                            @(ViewBag.MinFreeHeapBytes is long minHeap ? $"(min {minHeap / 1024} KB)" : "")
                        </dd>
                        <dt class="col-sm-3">
                            Max allocatable block
                        </dt>
                        <dd class="col-sm-9">
                            @(ViewBag.MaxAllocHeapBytes is long maxAlloc ? $"{maxAlloc / 1024} KB" : "-")
                        </dd>
                        <dt class="col-sm-3">
                            Stack margin
                        </dt>
                        <dd class="col-sm-9">
                            @(ViewBag.StackHighWaterMarkBytes is long stackMargin ? $"{stackMargin} bytes" : "-")
                        </dd>
                        <dt class="col-sm-3">
                            Network task stack margin
                        </dt>
                        <dd class="col-sm-9">
                            @(ViewBag.NetworkStackHighWaterMarkBytes is long netStackMargin ? $"{netStackMargin} bytes" : "-")
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.DateCreated)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.DateCreated)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.DateModified)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.DateModified)
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_DeviceFirmware" model="(DeviceFirmwareViewModel)ViewBag.Firmware" />
@if (ViewBag.LoRaSession is Agrumy.Shared.Models.DeviceLoRaSessionInfo loRaSession)
{
    <div class="card mt-3">
        <div class="card-header"><h3 class="card-title">LoRa v2 session</h3></div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Boot nonce</dt>
                <dd class="col-sm-9"><code>@loRaSession.BootNonceHex[..Math.Min(8, loRaSession.BootNonceHex.Length)]&hellip;</code></dd>
                <dt class="col-sm-3">Max counter</dt>
                <dd class="col-sm-9">@loRaSession.MaxCounter</dd>
                <dt class="col-sm-3">Last seen</dt>
                <dd class="col-sm-9">@loRaSession.LastSeenUtc.ToString("u")</dd>
            </dl>
        </div>
    </div>
}
@if (hasAnyRole(RoleNames.DeviceManagers) || isReadOnly)
{
    <partial name="_DeviceWifiUpdate" model="Model.IDDevice!.Value" />
    <partial name="_DeviceLoRaPrivateKey" model="Model.IDDevice!.Value" />
}

@section Scripts {
    <script nonce="@Context.CspNonce()">
        var quickSettingsForm = document.getElementById('quick-settings-form');
        // SleepSeconds only makes sense once SleepDeep is on - mirror the toggle's state instead of waiting for the reload below.
        document.querySelectorAll('input[name="sleepDeepEnabled"]').forEach(function (input) {
            input.addEventListener('change', function () {
                document.getElementById('sleep-seconds-field').hidden = document.querySelector('input[name="sleepDeepEnabled"]:checked') === null;
            });
        });
        // No Save button - every switch and the sleep-seconds field submit (and persist) the moment they change.
        quickSettingsForm.querySelectorAll('input[type="checkbox"], input[type="number"]').forEach(function (input) {
            input.addEventListener('change', function () {
                quickSettingsForm.submit();
            });
        });
    </script>
}
