@model Agrumy.Shared.Models.DeviceView
@using Microsoft.AspNetCore.Html
@using System.Text.Json

@{
    ViewData["Title"] = "Sensor config";
    var sensorCfg = Model.DeviceConfigSensor!;
    string SensorField(string name) => $"{nameof(Model.DeviceConfigSensor)}.{name}";
    string SensorFieldId(string name) => SensorField(name).Replace(".", "_");

    var sensorSlots = new (string Name, Func<DeviceTypeSensor, int?> SupportsFlag, int? Selected, string Tab)[]
    {
        (nameof(sensorCfg.SensorTemp), s => s.Temperature, sensorCfg.SensorTemp, "Environment"),
        (nameof(sensorCfg.SensorHumid), s => s.Humidity, sensorCfg.SensorHumid, "Environment"),
        (nameof(sensorCfg.SensorBarometer), s => s.Barometer, sensorCfg.SensorBarometer, "Environment"),
        (nameof(sensorCfg.SensorLight), s => s.Light, sensorCfg.SensorLight, "Environment"),
        (nameof(sensorCfg.SensorCo2), s => s.Co2, sensorCfg.SensorCo2, "Environment"),
        (nameof(sensorCfg.SensorTvoc), s => s.Tvoc, sensorCfg.SensorTvoc, "Environment"),

        (nameof(sensorCfg.SensorTempSoil), s => s.TemperatureSoil, sensorCfg.SensorTempSoil, "Soil & Water"),
        (nameof(sensorCfg.SensorMoist), s => s.Moisture, sensorCfg.SensorMoist, "Soil & Water"),
        (nameof(sensorCfg.SensorPH), s => s.WaterPH, sensorCfg.SensorPH, "Soil & Water"),
        (nameof(sensorCfg.SensorRainLevel), s => s.RainLevel, sensorCfg.SensorRainLevel, "Soil & Water"),
        (nameof(sensorCfg.SensorWaterLevel), s => s.WaterTankLevel, sensorCfg.SensorWaterLevel, "Soil & Water"),
        (nameof(sensorCfg.SensorEc), s => s.Ec, sensorCfg.SensorEc, "Soil & Water"),

        (nameof(sensorCfg.SensorBattery), s => s.Battery, sensorCfg.SensorBattery, "Other"),
        (nameof(sensorCfg.SensorWind), s => s.Wind, sensorCfg.SensorWind, "Other"),
        (nameof(sensorCfg.SensorWeight), s => s.Weight, sensorCfg.SensorWeight, "Other"),
    };

    Task<IHtmlContent> RenderSlot((string Name, Func<DeviceTypeSensor, int?> SupportsFlag, int? Selected, string Tab) slot)
    {
        var items = new SelectList(Model.DeviceTypeSensor!.Where(s => slot.SupportsFlag(s) == 1).ToList(), nameof(DeviceTypeSensor.IDDeviceTypeSensor), nameof(DeviceTypeSensor.SensorName), slot.Selected);
        var selectModel = new SelectFieldViewModel { Name = SensorField(slot.Name), Label = slot.Name, Items = items };
        return Html.PartialAsync("_SelectField", selectModel);
    }

    // Lets sensor-detection.js turn a detected SensorTypeIds candidate straight into "which <select> field(s) can this go in" without duplicating the SupportsFlag capability rules in JavaScript.
    var detectionSlotMap = Model.DeviceTypeSensor!.Where(s => s.IDDeviceTypeSensor.HasValue).ToDictionary(
        s => s.IDDeviceTypeSensor!.Value.ToString(),
        s => new
        {
            name = s.SensorName,
            slots = sensorSlots.Where(slot => slot.SupportsFlag(s) == 1)
                .Select(slot => new { fieldId = SensorFieldId(slot.Name), label = slot.Name }).ToArray(),
        });
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Edit Sensor - @Html.DisplayFor(model => model.Device!.DeviceName)</h3>
    </div>
    <div class="card-body">
        <form asp-action="EditSensor">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.HiddenFor(m => m.Device!.IDDevice)

            <div class="mb-3" id="sensor-detect-panel" data-device-id="@Model.Device!.IDDevice">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-device-command
                        data-target-type="@((int)CommandTargetType.Device)" data-target-id="@Model.Device!.IDDevice" data-action-type="@((int)CommandActionType.DetectSensors)">
                    <i class="bi bi-search"></i> Detect now
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="sensor-detect-check-btn">Check result</button>
                <div id="sensor-detect-results" class="mt-2"></div>
            </div>

            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-environment" type="button" role="tab">Environment</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-soil-water" type="button" role="tab">Soil &amp; Water</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-other" type="button" role="tab">Other</button>
                </li>
            </ul>
            <div class="tab-content border border-top-0 rounded-bottom p-3 mb-3">
                <div class="tab-pane fade show active" id="tab-environment" role="tabpanel">
                    @foreach (var slot in sensorSlots.Where(s => s.Tab == "Environment")) { @await RenderSlot(slot) }
                </div>
                <div class="tab-pane fade" id="tab-soil-water" role="tabpanel">
                    @foreach (var slot in sensorSlots.Where(s => s.Tab == "Soil & Water")) { @await RenderSlot(slot) }
                </div>
                <div class="tab-pane fade" id="tab-other" role="tabpanel">
                    @foreach (var slot in sensorSlots.Where(s => s.Tab == "Other")) { @await RenderSlot(slot) }

                    @* R1/R2 only apply when Battery = Analog voltage (Agrumy.Shared.Models.SensorTypeIds.AnalogVoltage); MAX17048 ignores them - shown/hidden by battery-divider-designer.js, not a toggle here. *@
                    <div id="battery-divider-fields">
                        <hr />
                        <h6>Voltage divider calibration</h6>
                        <p class="text-secondary">
                            Only used when Battery is set to <strong>Analog voltage</strong> above.
                            Enter the ACTUAL resistors wired on the board (V<sub>battery</sub> =
                            V<sub>measured</sub> &times; (R1+R2)/R2) - not a preset ratio, the real
                            values, so a different pair still converts correctly.
                        </p>

                        <div id="battery-divider-designer" class="card bg-light mb-3">
                            <div class="card-body">
                                <h6 class="card-title">Divider Designer</h6>
                                <p class="text-secondary mb-2">
                                    Haven't picked resistors yet? Choose your battery's nominal
                                    voltage and get a standard-value pair to buy/use.
                                </p>
                                <div class="row g-2 align-items-end">
                                    <div class="col-auto">
                                        <label for="divider-nominal-voltage" class="form-label">Nominal battery voltage</label>
                                        <select id="divider-nominal-voltage" class="form-select">
                                            <option value="3.7">3.7V (1S LiPo)</option>
                                            <option value="7.4">7.4V (2S LiPo)</option>
                                            <option value="custom">Custom&hellip;</option>
                                        </select>
                                    </div>
                                    <div class="col-auto" id="divider-custom-voltage-wrap" hidden>
                                        <label for="divider-custom-voltage" class="form-label">Custom voltage (V)</label>
                                        <input type="number" step="0.1" min="0.1" id="divider-custom-voltage" class="form-control" />
                                    </div>
                                    <div class="col-auto">
                                        <button type="button" id="divider-recommend-btn" class="btn btn-outline-secondary">Recommend</button>
                                    </div>
                                </div>
                                <p id="divider-recommendation" class="mt-2 mb-2"></p>
                                <button type="button" id="divider-use-values-btn" class="btn btn-sm btn-primary" disabled>Use these values</button>
                                <button type="button" id="divider-preset-1to1-btn" class="btn btn-sm btn-outline-secondary">Standard 1:1, 100k&Omega;/100k&Omega;</button>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-auto">
                                <label asp-for="DeviceConfigSensor!.BatteryDividerR1" class="form-label">R1 (&Omega;)</label>
                                <input asp-for="DeviceConfigSensor!.BatteryDividerR1" id="battery-divider-r1" class="form-control" />
                                <span asp-validation-for="DeviceConfigSensor!.BatteryDividerR1" class="text-danger"></span>
                            </div>
                            <div class="col-auto">
                                <label asp-for="DeviceConfigSensor!.BatteryDividerR2" class="form-label">R2 (&Omega;)</label>
                                <input asp-for="DeviceConfigSensor!.BatteryDividerR2" id="battery-divider-r2" class="form-control" />
                                <span asp-validation-for="DeviceConfigSensor!.BatteryDividerR2" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    @* No universal analog-EC-probe or load-cell formula exists, same reason the battery divider above needs real per-install values, not a preset. *@
                    <div id="weight-ec-fields">
                        <hr />
                        <h6>Weight &amp; EC calibration</h6>
                        <p class="text-secondary">Only used when Weight/EC above is set to a real sensor - HX711 needs its scale factor, the ADS1115 EC probe needs a slope/offset against known reference solutions.</p>
                        <div class="row g-3 mb-3">
                            <div class="col-auto">
                                <label asp-for="DeviceConfigSensor!.WeightCalibrationFactor" class="form-label">HX711 scale factor</label>
                                <input asp-for="DeviceConfigSensor!.WeightCalibrationFactor" class="form-control" />
                                <span asp-validation-for="DeviceConfigSensor!.WeightCalibrationFactor" class="text-danger"></span>
                            </div>
                            <div class="col-auto">
                                @* Set once with the scale physically empty (e.g. via the device's own serial output), then left as-is - applied on every boot via set_offset() instead of tare()ing against whatever's on the scale at boot time. *@
                                <label asp-for="DeviceConfigSensor!.WeightTareOffset" class="form-label">HX711 tare offset</label>
                                <input asp-for="DeviceConfigSensor!.WeightTareOffset" class="form-control" />
                                <span asp-validation-for="DeviceConfigSensor!.WeightTareOffset" class="text-danger"></span>
                            </div>
                            <div class="col-auto">
                                <label asp-for="DeviceConfigSensor!.EcCalibrationSlope" class="form-label">EC slope</label>
                                <input asp-for="DeviceConfigSensor!.EcCalibrationSlope" class="form-control" />
                                <span asp-validation-for="DeviceConfigSensor!.EcCalibrationSlope" class="text-danger"></span>
                            </div>
                            <div class="col-auto">
                                <label asp-for="DeviceConfigSensor!.EcCalibrationOffset" class="form-label">EC offset</label>
                                <input asp-for="DeviceConfigSensor!.EcCalibrationOffset" class="form-control" />
                                <span asp-validation-for="DeviceConfigSensor!.EcCalibrationOffset" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-0">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Details" asp-route-idDevice="@Model.Device!.IDDevice" class="btn btn-outline-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        // DropDownList/DropDownListFor render the element id with dots flattened to underscores
        // (same convention _SelectField.cshtml's label already relies on).
        string sensorBatterySelectId = SensorField(nameof(sensorCfg.SensorBattery)).Replace(".", "_");
    }
    <script src="~/js/battery-divider-designer.js"
            data-voltage-divider-id="@Agrumy.Shared.Models.SensorTypeIds.AnalogVoltage" data-sensor-battery-select-id="@sensorBatterySelectId"></script>

    <script type="application/json" id="sensor-detect-slot-map">@Html.Raw(JsonSerializer.Serialize(detectionSlotMap))</script>
    <script src="~/js/sensor-detection.js"></script>
}
