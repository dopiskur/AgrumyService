@model Agrumy.Web.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

@if (TempData["ProfileMessage"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Profile - @Model.Email</h3>
            </div>
            <div class="card-body">
                <form asp-action="Index">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Profile.FirstName" class="form-label">First Name</label>
                        <input asp-for="Profile.FirstName" class="form-control" />
                        <span asp-validation-for="Profile.FirstName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.LastName" class="form-label">Last Name</label>
                        <input asp-for="Profile.LastName" class="form-control" />
                        <span asp-validation-for="Profile.LastName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.TimeZone" class="form-label"></label>
                        <select asp-for="Profile.TimeZone" asp-items="Model.TimeZones" class="form-select">
                            <option value="">UTC (no time zone selected)</option>
                        </select>
                        <span asp-validation-for="Profile.TimeZone" class="text-danger"></span>
                        <div class="form-text">Timestamps (sensor charts, device events) are stored in UTC and shown in this time zone.</div>
                    </div>
                    <div class="mb-0">
                        <input type="submit" value="Save" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <partial name="_ChangePassword" model="new Agrumy.Web.ViewModels.ChangePasswordViewModel()" />

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Device Registration PIN</h3>
            </div>
            <div class="card-body">
                @if (string.IsNullOrEmpty(Model.DevicePin))
                {
                    <p class="mb-2">No active PIN. Generate one right before registering a new device.</p>
                }
                else if (Model.DevicePinExpires is DateTimeOffset expired && expired < DateTimeOffset.UtcNow)
                {
                    <p class="mb-2">Your PIN has expired. Generate a new one to register a device.</p>
                }
                else
                {
                    <p class="mb-1">Enter this PIN on the device's setup portal:</p>
                    <p class="mb-2"><code class="fs-4">@Model.DevicePin</code></p>
                    @if (Model.DevicePinExpires is DateTimeOffset expires)
                    {
                        <p class="text-muted mb-2">Valid until @expires.ToString("yyyy-MM-dd HH:mm") UTC - reusable for as many devices as you register in that window.</p>
                    }
                }
                <form asp-action="DevicePin" class="mb-0">
                    <input type="submit" value="Generate new PIN" class="btn btn-outline-primary" />
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Notification Preferences</h3>
            </div>
            <div class="card-body">
                <p class="text-secondary">Everything below is enabled by default - untick a box to stop getting that alert on that channel. This only changes what reaches you personally; other tenant admins are unaffected.</p>
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Alert</th>
                            @foreach (string channel in new[] { "email", "push-fcm" })
                            {
                                <th class="text-center">@(channel == "email" ? "Email" : "Push")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Agrumy.Shared.Models.NotificationEventType eventType in Enum.GetValues<Agrumy.Shared.Models.NotificationEventType>())
                        {
                            <tr>
                                <td>
                                    @(eventType switch
                                    {
                                        Agrumy.Shared.Models.NotificationEventType.Offline => "Device offline",
                                        Agrumy.Shared.Models.NotificationEventType.LowBattery => "Low battery",
                                        Agrumy.Shared.Models.NotificationEventType.TankRefill => "Tank needs refill",
                                        Agrumy.Shared.Models.NotificationEventType.RuleTriggered => "Rule-triggered alert",
                                        Agrumy.Shared.Models.NotificationEventType.SatelliteQuotaPaused => "Satellite quota paused",
                                        Agrumy.Shared.Models.NotificationEventType.SatelliteSyncFailed => "Satellite sync failed",
                                        Agrumy.Shared.Models.NotificationEventType.SatelliteBackfillCompleted => "Satellite backfill completed",
                                        _ => eventType.ToString(),
                                    })
                                </td>
                                @foreach (string channel in new[] { "email", "push-fcm" })
                                {
                                    bool enabled = Model.NotificationPreferences.FirstOrDefault(p => p.EventType == eventType && p.Channel == channel)?.Enabled ?? true;
                                    <td class="text-center">
                                        <form asp-action="NotificationPreferenceToggle" class="d-inline">
                                            <input type="hidden" name="eventType" value="@((int)eventType)" />
                                            <input type="hidden" name="channel" value="@channel" />
                                            <input type="hidden" name="enabled" value="@(!enabled)" />
                                            <button type="submit" class="btn btn-sm @(enabled ? "btn-success" : "btn-outline-secondary")" title="@(enabled ? "Enabled - click to disable" : "Disabled - click to enable")">
                                                @(enabled ? "On" : "Off")
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
