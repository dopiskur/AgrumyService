@model Agrumy.Shared.Models.UserView

@{
    ViewData["Title"] = "Edit";
    var userUpdate = Model.UserUpdate!;
    string UserField(string name) => $"{nameof(Model.UserUpdate)}.{name}";

    var enabledToggle = new EnabledToggleFieldViewModel { Name = UserField(nameof(userUpdate.Enabled)), Label = "Account", Value = userUpdate.Enabled };
    var phoneEnabledToggle = new EnabledToggleFieldViewModel { Name = UserField(nameof(userUpdate.PhoneEnabled)), Label = "Phone", Value = userUpdate.PhoneEnabled };
    bool viewerIsAdmin = User.IsInRole(RoleNames.GlobalAdmin) || User.IsInRole(RoleNames.TenantAdmin);
    List<string> assignedRoles = userUpdate.RoleNames ?? new();
    bool isReadOnly = ViewBag.IsReadOnly is true;
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Edit User</h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.HiddenFor(m => m.UserUpdate!.IDUser)
            @Html.HiddenFor(m => m.UserUpdate!.TenantID)
            @* Unlike Device.TenantID, this one is real and editable - UserApiController.UserUpdate applies the Migrate flow's TenantID only for Global-tier callers (RoleNames.GlobalUserManagers), silently ignored otherwise. *@
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <div>
                    <label class="form-label mb-0">Tenant</label>
                    <p class="form-control-plaintext mb-0">@(ViewBag.TenantName ?? "Unassigned")</p>
                </div>
                @if (ViewBag.CanMigrateTenant is true && !isReadOnly)
                {
                    <a asp-action="MigrateTenant" asp-route-idUser="@userUpdate.IDUser" class="btn btn-outline-secondary btn-sm" title="Move this user to a different tenant">Migrate</a>
                }
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.Email" class="form-label"></label>
                <input asp-for="UserUpdate.Email" class="form-control" disabled="@isReadOnly" />
                <span asp-validation-for="UserUpdate.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.Password" class="form-label"></label>
                <input asp-for="UserUpdate.Password" class="form-control" disabled="@isReadOnly" />
                <span asp-validation-for="UserUpdate.Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.Username" class="form-label"></label>
                <input asp-for="UserUpdate.Username" class="form-control" disabled="@isReadOnly" />
                <span asp-validation-for="UserUpdate.Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.FirstName" class="form-label"></label>
                <input asp-for="UserUpdate.FirstName" class="form-control" disabled="@isReadOnly" />
                <span asp-validation-for="UserUpdate.FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.LastName" class="form-label"></label>
                <input asp-for="UserUpdate.LastName" class="form-control" disabled="@isReadOnly" />
                <span asp-validation-for="UserUpdate.LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserUpdate.Phone" class="form-label"></label>
                <input asp-for="UserUpdate.Phone" class="form-control" disabled="@isReadOnly" />
                <span asp-validation-for="UserUpdate.Phone" class="text-danger"></span>
            </div>
            <partial name="_EnabledToggleField" model="phoneEnabledToggle" />

            <div class="mb-3">
                <label class="form-label">Roles</label>
                @if (viewerIsAdmin)
                {
                    @foreach (var role in RoleNames.All)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="@UserField(nameof(userUpdate.RoleNames))" value="@role"
                                   id="role_@role.Replace(" ", "_")" checked="@assignedRoles.Contains(role)" />
                            <label class="form-check-label" for="role_@role.Replace(" ", "_")">@role</label>
                        </div>
                    }
                }
                else
                {
                    <p class="form-text">@string.Join(", ", assignedRoles) (contact an admin to change roles)</p>
                }
            </div>
            <partial name="_EnabledToggleField" model="enabledToggle" />

            <div class="mb-0">
                @if (!isReadOnly)
                {
                    <input type="submit" value="Save" class="btn btn-primary" data-action="save" />
                }
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
