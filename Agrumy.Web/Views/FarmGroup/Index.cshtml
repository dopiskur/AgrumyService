@model FarmGroupIndexViewModel
@{
    ViewData["Title"] = "Farm Groups";
    bool canManage = RoleNames.DeviceManagers.Split(',').Any(User.IsInRole);
}

<p class="text-secondary">
    A Farm Group is a cross-cutting overview above individual farms - a site with both a greenhouse
    and open fields is simply two farms placed in the same group. Each group has its own Greenhouse,
    Crop and Fruit sections.
</p>

@if (canManage)
{
    <form asp-action="Create" method="post" class="d-flex gap-2 mb-3">
        <input type="text" name="name" class="form-control form-control-sm" placeholder="New farm group name" required maxlength="100" style="max-width:18rem" />
        <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add Farm Group</button>
    </form>
}

@if (Model.Groups.Count == 0)
{
    <p class="text-secondary">No farm groups yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var g in Model.Groups)
        {
            <a asp-action="Details" asp-route-id="@g.Group.IDFarmGroup" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                @g.Group.Name
                <span class="badge text-bg-secondary">@g.FarmCount farm@(g.FarmCount == 1 ? "" : "s")</span>
            </a>
        }
    </div>
}
