@model FarmGroupIndexViewModel
@{
    ViewData["Title"] = "Farm Groups";
    bool canManage = RoleNames.DeviceManagers.Split(',').Any(User.IsInRole);
}

<p class="text-secondary">
    A Farm Group is a cross-cutting overview above individual farms - a site with both a greenhouse
    and open fields is simply two farms placed in the same group. Each group has its own Greenhouse,
    Crop and Fruit sections.
</p>

@if (canManage)
{
    <button type="button" class="btn btn-sm btn-primary text-nowrap mb-3" data-bs-toggle="modal" data-bs-target="#farmGroupAddModal">
        <i class="bi bi-plus-lg"></i> Add Farm Group
    </button>

    <div class="modal fade" id="farmGroupAddModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Create" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">Add farm group</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="farmGroupAddName">Name</label>
                        <input type="text" id="farmGroupAddName" name="name" class="form-control" placeholder="New farm group name" required maxlength="100" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Farm Group</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.Groups.Count == 0)
{
    <p class="text-secondary">No farm groups yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var g in Model.Groups)
        {
            <a asp-action="Details" asp-route-id="@g.Group.IDFarmGroup" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                @g.Group.Name
                <span class="badge text-bg-secondary">@g.FarmCount farm@(g.FarmCount == 1 ? "" : "s")</span>
            </a>
        }
    </div>
}
