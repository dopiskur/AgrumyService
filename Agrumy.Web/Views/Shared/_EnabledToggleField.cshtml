@model Agrumy.Web.ViewModels.EnabledToggleFieldViewModel
@{
    // "." isn't valid inside a CSS id selector without escaping - flatten to underscores instead.
    var idBase = Model.Name.Replace(".", "_");
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <label class="form-check-label mb-0" for="@idBase">@Model.Label</label>
    <div class="form-check form-switch mb-0">
        <input type="checkbox" class="form-check-input" role="switch" id="@idBase" name="@Model.Name" value="true" checked="@(Model.Value == true)" />
        <input type="hidden" name="@Model.Name" value="false" />
    </div>
</div>
