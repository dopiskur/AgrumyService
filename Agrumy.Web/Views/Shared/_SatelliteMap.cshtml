@model SatelliteMapViewModel
@{
    string mapId = $"satMap-{Model.Scope}-{Model.Id}";
    bool canManage = Model.CanManage;
}

<div class="card" data-sat-role="widget">
    <div class="card-header d-flex align-items-center flex-wrap gap-2">
        <h3 class="card-title mb-0"><i class="bi bi-globe"></i> Satellite (@Model.Scope)</h3>
        @if (canManage)
        {
            <button type="button" class="btn btn-sm btn-outline-primary ms-auto" data-sat-role="syncNow"><i class="bi bi-arrow-repeat"></i> Sync now</button>
        }
    </div>
    <div class="card-body">
        @if (canManage)
        {
            @Html.AntiForgeryToken()
        }
        <div data-sat-role="root" data-scope="@Model.Scope" data-id="@Model.Id" data-can-manage="@(canManage ? "1" : "0")">
            @await Html.PartialAsync("_SatelliteIndexPicker", (mapId, (IEnumerable<Agrumy.Shared.Models.SatelliteIndex>)Model.AvailableIndices))
            <div class="mb-2">
                <label class="form-label small mb-0" data-sat-role="reliabilityLabel">Minimum reliability: @(Model.DefaultReliabilityThreshold)%</label>
                <input type="range" class="form-range" min="0" max="100" value="@Model.DefaultReliabilityThreshold" data-sat-role="reliabilityThreshold" />
            </div>
            <div class="alert alert-danger py-1 px-2 small mb-2" data-sat-role="unreliableBanner" hidden>Unreliable</div>
            <div id="@mapId" data-sat-role="map" style="height:420px;"></div>
            <div class="d-flex align-items-center gap-2 mt-2">
                <span class="small text-secondary" data-sat-role="dateLabel">No dates yet</span>
                <input type="range" class="form-range flex-grow-1" min="0" max="0" value="0" data-sat-role="dateSlider" disabled />
            </div>
            <div class="small text-secondary mt-1" data-sat-role="legend"></div>
            <div class="small text-secondary" data-sat-role="sceneClassification"></div>
            <p class="small text-secondary fst-italic mt-2" data-sat-role="emptyNotice" hidden>No satellite data yet for this scope - configure the satellite module and wait for the next daily sync, or use Sync now.</p>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
<script src="~/lib/leaflet/leaflet.js"></script>
<script src="~/js/satellite-map.js"></script>
<script nonce="@Context.CspNonce()">
    document.addEventListener('DOMContentLoaded', function () {
        initSatelliteMap('@mapId');
    });
</script>
