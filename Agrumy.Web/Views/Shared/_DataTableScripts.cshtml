@model string

<script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.min.js"></script>
<script src="~/lib/adminlte/plugins/datatables-bs5/dataTables.bootstrap5.min.js"></script>
<script nonce="@Context.CspNonce()">
    document.addEventListener('DOMContentLoaded', function () {
        const el = document.getElementById('@Model');
        if (!el) {
            return; // table conditionally omitted (e.g. an empty-state page) - nothing to wire up
        }
        new DataTable(el, {
            paging: true,
            searching: true,
            order: [[0, 'asc']],
            columnDefs: [{ orderable: false, targets: -1 }]
        });
    });
</script>
