@using System.Text.Json
@using Microsoft.AspNetCore.Html
@model Agrumy.Web.ViewModels.RuleEditorViewModel
@{
    // Recursive ConditionNode tree, Name/Description/IsSafetyRule per rule - shared across the Zone page, the Unit/Farm "Rules" tabs, and the tenant-wide Global Rules page.
    var relayRules = Model.Rules.Where(r => r.ActionType == Agrumy.Shared.Models.ActionType.Relay).ToList();
    var notificationRules = Model.Rules.Where(r => r.ActionType == Agrumy.Shared.Models.ActionType.Notification).ToList();
    var rulesByFunction = relayRules.GroupBy(r => r.RelayFunction!.Value).ToDictionary(g => g.Key, g => g.ToList());

    (Agrumy.Shared.Models.RelayFunction Value, string Label)[] functions =
    [
        (Agrumy.Shared.Models.RelayFunction.Ventilation, "Ventilation"),
        (Agrumy.Shared.Models.RelayFunction.Light, "Light"),
        (Agrumy.Shared.Models.RelayFunction.Heating, "Heating"),
        (Agrumy.Shared.Models.RelayFunction.WaterPump, "Water pump"),
        (Agrumy.Shared.Models.RelayFunction.Screen, "Screen"),
        (Agrumy.Shared.Models.RelayFunction.Vent, "Vent"),
    ];
    (Agrumy.Shared.Models.SensorMetric Value, string Label)[] metrics =
    [
        (Agrumy.Shared.Models.SensorMetric.Temperature, "Temperature"), (Agrumy.Shared.Models.SensorMetric.SoilTemperature, "SoilTemperature"),
        (Agrumy.Shared.Models.SensorMetric.Humidity, "Humidity"), (Agrumy.Shared.Models.SensorMetric.Vpd, "Vpd"),
        (Agrumy.Shared.Models.SensorMetric.DewPoint, "DewPoint"), (Agrumy.Shared.Models.SensorMetric.DewPointSpread, "DewPointSpread"),
        (Agrumy.Shared.Models.SensorMetric.Moisture, "Moisture"), (Agrumy.Shared.Models.SensorMetric.Light, "Light"),
        (Agrumy.Shared.Models.SensorMetric.Co2, "Co2"), (Agrumy.Shared.Models.SensorMetric.Tvoc, "Tvoc"),
        (Agrumy.Shared.Models.SensorMetric.Barometer, "Barometer"), (Agrumy.Shared.Models.SensorMetric.LiquidPH, "LiquidPH"),
        (Agrumy.Shared.Models.SensorMetric.RainLevel, "RainLevel"), (Agrumy.Shared.Models.SensorMetric.WaterLevel, "WaterLevel"),
        (Agrumy.Shared.Models.SensorMetric.Wind, "Wind"),
        (Agrumy.Shared.Models.SensorMetric.Ec, "Ec"), (Agrumy.Shared.Models.SensorMetric.Weight, "Weight"),
        (Agrumy.Shared.Models.SensorMetric.OutdoorTemperature, "Outdoor temperature"), (Agrumy.Shared.Models.SensorMetric.OutdoorHumidity, "Outdoor humidity"),
        (Agrumy.Shared.Models.SensorMetric.OutdoorWind, "Outdoor wind"),
    ];
    // Computed from other readings, not a raw sensor value - hidden from the metric picker in Simple mode along with every non-comparison node type (see rule-builder.js's allowedTypes()).
    HashSet<Agrumy.Shared.Models.SensorMetric> derivedMetrics = [Agrumy.Shared.Models.SensorMetric.Vpd, Agrumy.Shared.Models.SensorMetric.DewPoint, Agrumy.Shared.Models.SensorMetric.DewPointSpread];
    // Live weather data, not a device reading - only valid on a Notification-action rule (DeviceFarmUnitZoneRule.Validate() rejects it on Relay), hidden from the Relay tree's metric picker (see rule-builder.js's metrics filter).
    HashSet<Agrumy.Shared.Models.SensorMetric> outdoorMetrics = [Agrumy.Shared.Models.SensorMetric.OutdoorTemperature, Agrumy.Shared.Models.SensorMetric.OutdoorHumidity, Agrumy.Shared.Models.SensorMetric.OutdoorWind];
    bool simpleUIMode = User.GetUIMode() == UIMode.Simple;
    bool isReadOnly = ViewBag.IsReadOnly is true;
    var jsonOpts = new JsonSerializerOptions(JsonSerializerDefaults.Web);

    string SummarizeTree(Agrumy.Shared.Models.ConditionNode? node)
    {
        if (node == null) { return "?"; }
        string body = node.Type switch
        {
            Agrumy.Shared.Models.NodeType.Comparison => $"{node.Metric} {OpSymbol(node.Operator)} {node.Value1:0.##}{(node.Operator == Agrumy.Shared.Models.ComparisonOperator.Between ? $"-{node.Value2:0.##}" : "")}{(node.Hysteresis is > 0 ? $" (hyst {node.Hysteresis:0.##})" : "")}",
            Agrumy.Shared.Models.NodeType.Interval => $"on {node.IntervalLength}s / every {node.Interval}s",
            Agrumy.Shared.Models.NodeType.Schedule => ScheduleText(node.DaysOfWeek, node.Start, node.Duration),
            Agrumy.Shared.Models.NodeType.Astronomical => $"sunrise {node.SunriseOffsetMinutes:+#;-#;0}min / sunset {node.SunsetOffsetMinutes:+#;-#;0}min",
            Agrumy.Shared.Models.NodeType.RuleTriggered => $"rule #{node.ReferencedRuleId} fired",
            Agrumy.Shared.Models.NodeType.RateOfChange => $"{node.Metric} changes by &gt;={node.ChangeThreshold:0.##} vs {node.WindowHours}h ago",
            Agrumy.Shared.Models.NodeType.DifDisruption => $"day-night dif &lt; {node.MinDifDegrees:0.##}&deg; (night {node.NightWindowHours}h vs day {node.DayWindowHours}h before it)",
            Agrumy.Shared.Models.NodeType.Group => "(" + string.Join($" {node.GroupOperator} ", node.Children.Select(SummarizeTree)) + ")",
            _ => "?",
        };
        return $"<span class=\"badge text-bg-secondary me-1\">{node.Type}</span>{body}";
    }
    string OpSymbol(Agrumy.Shared.Models.ComparisonOperator? op) => op switch
    {
        Agrumy.Shared.Models.ComparisonOperator.GreaterThan => ">", Agrumy.Shared.Models.ComparisonOperator.LessThan => "<",
        Agrumy.Shared.Models.ComparisonOperator.GreaterThanOrEqual => ">=", Agrumy.Shared.Models.ComparisonOperator.LessThanOrEqual => "<=",
        Agrumy.Shared.Models.ComparisonOperator.Equal => "=", Agrumy.Shared.Models.ComparisonOperator.Between => "between",
        _ => "?",
    };
    string ScheduleText(int? daysOfWeek, int? start, int? duration)
    {
        if (start == null || duration == null) { return "?"; }
        int s = start.Value, end = s + duration.Value;
        return $"{s / 3600:00}:{s % 3600 / 60:00}-{end / 3600:00}:{end % 3600 / 60:00}, days 0b{Convert.ToString(daysOfWeek ?? 0, 2).PadLeft(7, '0')}";
    }

    IHtmlContent TreeBuilder(string idSuffix, bool isNotification, IList<Agrumy.Shared.Models.DeviceFarmUnitZoneRule> referenceable)
    {
        string metricsJson = JsonSerializer.Serialize(metrics.Select(m => new { value = (int)m.Value, label = m.Label, derived = derivedMetrics.Contains(m.Value), outdoor = outdoorMetrics.Contains(m.Value) }), jsonOpts).Replace("\"", "&quot;");
        string rulesJson = JsonSerializer.Serialize(referenceable.Select(r => new { id = r.IDDeviceFarmUnitZoneRule, name = r.Name }), jsonOpts).Replace("\"", "&quot;");
        var html = $"""
        <div class="rule-tree-builder" data-metrics="{metricsJson}" data-referenceable-rules="{rulesJson}" data-notification="{(isNotification ? "true" : "false")}" data-simple-mode="{(simpleUIMode ? "true" : "false")}">
            <input type="hidden" name="RootConditionJson" />
            <div class="rule-tree-container mb-2"></div>
        </div>
        """;
        return new HtmlString(html);
    }
}

@if (Model.ShowRelayCard)
{
<div class="card mb-3" id="ruleEditorCard">
    <div class="card-header">
        <h3 class="card-title">Automation rules</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary small">
            A function may have several rules - any rule that evaluates "on" wins (OR). Screen/Vent are
            positional instead: the highest target percent among the currently-true rules wins. A safety
            rule always survives being overridden by a more specific scope.
        </p>
        @if (simpleUIMode)
        {
            <p class="text-secondary small">
                <i class="bi bi-info-circle"></i> Simple mode - new rules are a single "if metric compares to
                value" condition. <a asp-controller="Profile" asp-action="Index">Switch to Advanced</a> for
                condition groups, derived metrics, schedules, and more.
            </p>
        }
        @foreach (var (function, label) in functions)
        {
            var rules = rulesByFunction.GetValueOrDefault(function, []);
            <div class="mb-4">
                <h6 class="fw-semibold">
                    @label
                    @if (rules.Count > 0)
                    {
                        <span class="badge text-bg-success">configured</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">unconfigured</span>
                    }
                </h6>
                @if (rules.Count > 0)
                {
                    <ul class="list-group list-group-flush mb-2">
                        @foreach (var rule in rules)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>
                                    <strong>@rule.Name</strong>
                                    @if (rule.IsSafetyRule) { <span class="badge text-bg-warning">safety</span> }
                                    @if (rule.TargetPercent is int targetPercent) { <span class="badge text-bg-info">&rarr; @targetPercent%</span> }
                                    - @Html.Raw(SummarizeTree(rule.Root))
                                </span>
                                @if (!isReadOnly)
                                {
                                    <form asp-action="@Model.DeleteActionName" method="post" onsubmit="return confirm('Remove this rule?');">
                                        <input type="hidden" name="idDeviceFarmUnitZoneRule" value="@rule.IDDeviceFarmUnitZoneRule" />
                                        @if (!string.IsNullOrEmpty(Model.ScopeHiddenFieldName))
                                        {
                                            <input type="hidden" name="@Model.ScopeHiddenFieldName" value="@Model.ScopeId" />
                                        }
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove" data-action="delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        }
        @if (!isReadOnly)
        {
        <div class="rule-add-wizard">
            <button type="button" class="btn btn-sm btn-outline-primary rule-add-toggle">+ Add rule</button>
            <form asp-action="@Model.AddActionName" method="post" class="mt-2 p-2 border rounded rule-add-form" hidden>
                @if (!string.IsNullOrEmpty(Model.ScopeHiddenFieldName))
                {
                    <input type="hidden" name="@Model.ScopeHiddenFieldName" value="@Model.ScopeId" />
                }
                <input type="hidden" name="ActionType" value="@((int)Agrumy.Shared.Models.ActionType.Relay)" />
                <div class="rule-wizard-step">
                    <div class="row g-2 mb-2">
                        <div class="col-12">
                            <label class="form-label small mb-0 d-block">Function</label>
                            @foreach (var (function, label) in functions)
                            {
                                <div class="form-check form-check-inline">
                                    <input type="radio" class="form-check-input" name="RelayFunction" value="@((int)function)" id="relayfn-@function" required />
                                    <label class="form-check-label small" for="relayfn-@function">@label</label>
                                </div>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary rule-wizard-next">Next</button>
                </div>
                <div class="rule-wizard-step" hidden>
                    <div class="row g-2 mb-2">
                        <div class="col-auto">
                            <label class="form-label small mb-0">Name</label>
                            <input type="text" name="Name" class="form-control form-control-sm" style="width:14rem" required />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small mb-0">Description (optional)</label>
                            <input type="text" name="Description" class="form-control form-control-sm" style="width:18rem" />
                        </div>
                        <div class="col-auto align-self-end">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" name="IsSafetyRule" value="true" id="safety-relay-add" />
                                <label class="form-check-label small" for="safety-relay-add">Safety rule (survives being overridden)</label>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary rule-wizard-back">Back</button>
                    <button type="button" class="btn btn-sm btn-primary rule-wizard-next">Next</button>
                </div>
                <div class="rule-wizard-step" hidden>
                    <div class="row g-2 mb-2">
                        <div class="col-auto">
                            <label class="form-label small mb-0">Target % (0-100)</label>
                            <input type="number" name="TargetPercent" class="form-control form-control-sm" style="width:7rem" min="0" max="100" value="100" required />
                        </div>
                    </div>
                    @TreeBuilder("relay", isNotification: false, notificationRules)
                    <button type="button" class="btn btn-sm btn-outline-secondary rule-wizard-back">Back</button>
                    <button type="submit" class="btn btn-sm btn-primary" data-action="add">Add rule</button>
                </div>
            </form>
        </div>
        }
        <p class="text-secondary small mb-0">
            Astronomical conditions need a location set under Server Settings &rarr; Weather (or this
            tenant's own, under Tenants &rarr; Edit) - a day with no location configured drops the whole
            rule that day (function stays off).
        </p>
    </div>
</div>
}

<div class="card mb-3" id="notificationRuleEditorCard">
    <div class="card-header">
        <h3 class="card-title">Notification automation</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary small">
            Sent via the same email/webhook/push channels as other alerts, once per false-&gt;true
            transition. A more specific scope's rule with the SAME name replaces a less specific one;
            different names always coexist. "Another rule fired" can only reference a Notification rule
            in this same scope from this form (the API itself allows any Notification rule in the
            tenant, including cross-zone).
        </p>
        @if (simpleUIMode)
        {
            <p class="text-secondary small">
                <i class="bi bi-info-circle"></i> Simple mode - new rules are a single "if metric compares to
                value" condition. <a asp-controller="Profile" asp-action="Index">Switch to Advanced</a> for
                condition groups, derived metrics, schedules, and more.
            </p>
        }
        @if (notificationRules.Count > 0)
        {
            <ul class="list-group list-group-flush mb-2">
                @foreach (var rule in notificationRules)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span>
                            <strong>@rule.Name</strong>
                            @if (rule.IsSafetyRule) { <span class="badge text-bg-warning">safety</span> }
                            - @rule.NotificationSubject - @Html.Raw(SummarizeTree(rule.Root))
                        </span>
                        @if (!isReadOnly)
                        {
                            <form asp-action="@Model.DeleteActionName" method="post" onsubmit="return confirm('Remove this rule?');">
                                <input type="hidden" name="idDeviceFarmUnitZoneRule" value="@rule.IDDeviceFarmUnitZoneRule" />
                                @if (!string.IsNullOrEmpty(Model.ScopeHiddenFieldName))
                                {
                                    <input type="hidden" name="@Model.ScopeHiddenFieldName" value="@Model.ScopeId" />
                                }
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove" data-action="delete"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }

        @if (!isReadOnly)
        {
        <div class="rule-add-wizard">
            <button type="button" class="btn btn-sm btn-outline-primary rule-add-toggle">+ Add notification rule</button>
            <form asp-action="@Model.AddActionName" method="post" class="mt-2 p-2 border rounded rule-add-form" hidden>
                @if (!string.IsNullOrEmpty(Model.ScopeHiddenFieldName))
                {
                    <input type="hidden" name="@Model.ScopeHiddenFieldName" value="@Model.ScopeId" />
                }
                <input type="hidden" name="ActionType" value="@((int)Agrumy.Shared.Models.ActionType.Notification)" />
                <div class="rule-wizard-step">
                    <div class="row g-2 mb-2">
                        <div class="col-auto">
                            <label class="form-label small mb-0">Name</label>
                            <input type="text" name="Name" class="form-control form-control-sm" style="width:14rem" required />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small mb-0">Description (optional)</label>
                            <input type="text" name="Description" class="form-control form-control-sm" style="width:16rem" />
                        </div>
                        <div class="col-auto align-self-end">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" name="IsSafetyRule" value="true" id="safety-notif" />
                                <label class="form-check-label small" for="safety-notif">Safety rule</label>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary rule-wizard-next">Next</button>
                </div>
                <div class="rule-wizard-step" hidden>
                    <div class="row g-2 mb-2">
                        <div class="col-auto">
                            <label class="form-label small mb-0">Subject</label>
                            <input type="text" name="NotificationSubject" class="form-control form-control-sm" style="width:16rem" required />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small mb-0">Body ({value}/{metric} placeholders)</label>
                            <input type="text" name="NotificationBody" class="form-control form-control-sm" style="width:20rem" />
                        </div>
                    </div>
                    @TreeBuilder("notification", isNotification: true, notificationRules)
                    <button type="button" class="btn btn-sm btn-outline-secondary rule-wizard-back">Back</button>
                    <button type="submit" class="btn btn-sm btn-primary" data-action="add">Add notification rule</button>
                </div>
            </form>
        </div>
        }
    </div>
</div>

<style>
    /* AND stacks group children vertically, OR lays them out side by side - the operator radio toggles this class in rule-builder.js. */
    .rt-children { display: flex; gap: .5rem; }
    .rt-children.rt-children-and { flex-direction: column; }
    .rt-children.rt-children-or { flex-direction: row; flex-wrap: wrap; }
    .rt-children > .rt-node { flex: 1 1 16rem; min-width: 14rem; }
    .rt-node[draggable="true"] { cursor: grab; }
    .rt-node[draggable="true"]:active { cursor: grabbing; }
    .rt-node.rt-dragging { opacity: .4; }
    .rt-drag-handle { cursor: grab; color: var(--bs-secondary-color, #6c757d); }
</style>
<script src="~/js/rule-builder.js"></script>
