@using System.Text.Json
@using Microsoft.AspNetCore.Html
@model api.ViewModels.RuleEditorViewModel
@{
    // Roadmap #396(4): recursive ConditionNode tree (replaces the old flat conditions[]+ops[] fold),
    // Name/Description/IsSafetyRule per rule - shared across the Zone page, the Unit/Farm "Rules"
    // tabs, and the tenant-wide Global Rules page.
    var relayRules = Model.Rules.Where(r => r.ActionType == api.Models.ActionType.Relay).ToList();
    var notificationRules = Model.Rules.Where(r => r.ActionType == api.Models.ActionType.Notification).ToList();
    var rulesByFunction = relayRules.GroupBy(r => r.RelayFunction!.Value).ToDictionary(g => g.Key, g => g.ToList());

    (api.Models.RelayFunction Value, string Label)[] functions =
    [
        (api.Models.RelayFunction.Ventilation, "Ventilation"),
        (api.Models.RelayFunction.Light, "Light"),
        (api.Models.RelayFunction.Heating, "Heating"),
        (api.Models.RelayFunction.WaterPump, "Water pump"),
    ];
    (api.Models.SensorMetric Value, string Label)[] metrics =
    [
        (api.Models.SensorMetric.Temperature, "Temperature"), (api.Models.SensorMetric.SoilTemperature, "SoilTemperature"),
        (api.Models.SensorMetric.Humidity, "Humidity"), (api.Models.SensorMetric.Vpd, "Vpd"),
        (api.Models.SensorMetric.DewPoint, "DewPoint"), (api.Models.SensorMetric.DewPointSpread, "DewPointSpread"),
        (api.Models.SensorMetric.Moisture, "Moisture"), (api.Models.SensorMetric.Light, "Light"),
        (api.Models.SensorMetric.Co2, "Co2"), (api.Models.SensorMetric.Tvoc, "Tvoc"),
        (api.Models.SensorMetric.Barometer, "Barometer"), (api.Models.SensorMetric.LiquidPH, "LiquidPH"),
        (api.Models.SensorMetric.RainLevel, "RainLevel"), (api.Models.SensorMetric.WaterLevel, "WaterLevel"),
        (api.Models.SensorMetric.Wind, "Wind"),
    ];
    var jsonOpts = new JsonSerializerOptions(JsonSerializerDefaults.Web);

    string SummarizeTree(api.Models.ConditionNode? node)
    {
        if (node == null) { return "?"; }
        string body = node.Type switch
        {
            api.Models.NodeType.Comparison => $"{node.Metric} {OpSymbol(node.Operator)} {node.Value1:0.##}{(node.Operator == api.Models.ComparisonOperator.Between ? $"-{node.Value2:0.##}" : "")}{(node.Hysteresis is > 0 ? $" (hyst {node.Hysteresis:0.##})" : "")}",
            api.Models.NodeType.Interval => $"on {node.IntervalLength}s / every {node.Interval}s",
            api.Models.NodeType.Schedule => ScheduleText(node.DaysOfWeek, node.Start, node.Duration),
            api.Models.NodeType.Astronomical => $"sunrise {node.SunriseOffsetMinutes:+#;-#;0}min / sunset {node.SunsetOffsetMinutes:+#;-#;0}min",
            api.Models.NodeType.RuleTriggered => $"rule #{node.ReferencedRuleId} fired",
            api.Models.NodeType.RateOfChange => $"{node.Metric} changes by &gt;={node.ChangeThreshold:0.##} vs {node.WindowHours}h ago",
            api.Models.NodeType.DifDisruption => $"day-night dif &lt; {node.MinDifDegrees:0.##}&deg; (night {node.NightWindowHours}h vs day {node.DayWindowHours}h before it)",
            api.Models.NodeType.Group => "(" + string.Join($" {node.GroupOperator} ", node.Children.Select(SummarizeTree)) + ")",
            _ => "?",
        };
        return $"<span class=\"badge text-bg-secondary me-1\">{node.Type}</span>{body}";
    }
    string OpSymbol(api.Models.ComparisonOperator? op) => op switch
    {
        api.Models.ComparisonOperator.GreaterThan => ">", api.Models.ComparisonOperator.LessThan => "<",
        api.Models.ComparisonOperator.GreaterThanOrEqual => ">=", api.Models.ComparisonOperator.LessThanOrEqual => "<=",
        api.Models.ComparisonOperator.Equal => "=", api.Models.ComparisonOperator.Between => "between",
        _ => "?",
    };
    string ScheduleText(int? daysOfWeek, int? start, int? duration)
    {
        if (start == null || duration == null) { return "?"; }
        int s = start.Value, end = s + duration.Value;
        return $"{s / 3600:00}:{s % 3600 / 60:00}-{end / 3600:00}:{end % 3600 / 60:00}, days 0b{Convert.ToString(daysOfWeek ?? 0, 2).PadLeft(7, '0')}";
    }

    IHtmlContent TreeBuilder(string idSuffix, bool isNotification, IList<api.Models.DeviceFarmUnitZoneRule> referenceable)
    {
        string metricsJson = JsonSerializer.Serialize(metrics.Select(m => new { value = (int)m.Value, label = m.Label }), jsonOpts).Replace("\"", "&quot;");
        string rulesJson = JsonSerializer.Serialize(referenceable.Select(r => new { id = r.IDDeviceFarmUnitZoneRule, name = r.Name }), jsonOpts).Replace("\"", "&quot;");
        var html = $"""
        <div class="rule-tree-builder" data-metrics="{metricsJson}" data-referenceable-rules="{rulesJson}" data-notification="{(isNotification ? "true" : "false")}">
            <input type="hidden" name="RootConditionJson" />
            <div class="rule-tree-container mb-2"></div>
        </div>
        """;
        return new HtmlString(html);
    }
}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Relay automation</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary small">
            A function may have several rules - any rule that evaluates "on" wins (OR). A safety rule
            always survives being overridden by a more specific scope (roadmap #396(5)).
        </p>
        @foreach (var (function, label) in functions)
        {
            var rules = rulesByFunction.GetValueOrDefault(function, []);
            <div class="mb-4">
                <h6 class="fw-semibold">
                    @label
                    @if (rules.Count > 0)
                    {
                        <span class="badge text-bg-success">configured</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">unconfigured</span>
                    }
                </h6>
                @if (rules.Count > 0)
                {
                    <ul class="list-group list-group-flush mb-2">
                        @foreach (var rule in rules)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>
                                    <strong>@rule.Name</strong>
                                    @if (rule.IsSafetyRule) { <span class="badge text-bg-warning">safety</span> }
                                    - @Html.Raw(SummarizeTree(rule.Root))
                                </span>
                                <form asp-action="@Model.DeleteActionName" method="post" onsubmit="return confirm('Remove this rule?');">
                                    <input type="hidden" name="idDeviceFarmUnitZoneRule" value="@rule.IDDeviceFarmUnitZoneRule" />
                                    @if (!string.IsNullOrEmpty(Model.ScopeHiddenFieldName))
                                    {
                                        <input type="hidden" name="@Model.ScopeHiddenFieldName" value="@Model.ScopeId" />
                                    }
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove"><i class="bi bi-trash"></i></button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                <details>
                    <summary class="btn btn-sm btn-outline-primary" style="cursor:pointer;">+ Add rule</summary>
                    <form asp-action="@Model.AddActionName" method="post" class="mt-2 p-2 border rounded">
                        @if (!string.IsNullOrEmpty(Model.ScopeHiddenFieldName))
                        {
                            <input type="hidden" name="@Model.ScopeHiddenFieldName" value="@Model.ScopeId" />
                        }
                        <input type="hidden" name="ActionType" value="@((int)api.Models.ActionType.Relay)" />
                        <input type="hidden" name="RelayFunction" value="@((int)function)" />
                        <div class="row g-2 mb-2">
                            <div class="col-auto">
                                <label class="form-label small mb-0">Name</label>
                                <input type="text" name="Name" class="form-control form-control-sm" style="width:14rem" required />
                            </div>
                            <div class="col-auto">
                                <label class="form-label small mb-0">Description (optional)</label>
                                <input type="text" name="Description" class="form-control form-control-sm" style="width:18rem" />
                            </div>
                            <div class="col-auto align-self-end">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" name="IsSafetyRule" value="true" id="safety-@function" />
                                    <label class="form-check-label small" for="safety-@function">Safety rule (survives being overridden)</label>
                                </div>
                            </div>
                        </div>
                        @TreeBuilder($"relay-{function}", isNotification: false, notificationRules)
                        <button type="submit" class="btn btn-sm btn-primary mt-2">Add rule</button>
                    </form>
                </details>
            </div>
        }
        <p class="text-secondary small mb-0">
            Astronomical conditions need a location set under Server Settings &rarr; Weather (or this
            tenant's own, under Tenants &rarr; Edit) - a day with no location configured drops the whole
            rule that day (function stays off).
        </p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Notification automation</h3>
    </div>
    <div class="card-body">
        <p class="text-secondary small">
            Sent via the same email/webhook/push channels as other alerts, once per false-&gt;true
            transition. A more specific scope's rule with the SAME name replaces a less specific one;
            different names always coexist. "Another rule fired" can only reference a Notification rule
            in this same scope from this form (the API itself allows any Notification rule in the
            tenant, including cross-zone).
        </p>
        @if (notificationRules.Count > 0)
        {
            <ul class="list-group list-group-flush mb-2">
                @foreach (var rule in notificationRules)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span>
                            <strong>@rule.Name</strong>
                            @if (rule.IsSafetyRule) { <span class="badge text-bg-warning">safety</span> }
                            - @rule.NotificationSubject - @Html.Raw(SummarizeTree(rule.Root))
                        </span>
                        <form asp-action="@Model.DeleteActionName" method="post" onsubmit="return confirm('Remove this rule?');">
                            <input type="hidden" name="idDeviceFarmUnitZoneRule" value="@rule.IDDeviceFarmUnitZoneRule" />
                            @if (!string.IsNullOrEmpty(Model.ScopeHiddenFieldName))
                            {
                                <input type="hidden" name="@Model.ScopeHiddenFieldName" value="@Model.ScopeId" />
                            }
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove"><i class="bi bi-trash"></i></button>
                        </form>
                    </li>
                }
            </ul>
        }

        <details>
            <summary class="btn btn-sm btn-outline-primary" style="cursor:pointer;">+ Add notification rule</summary>
            <form asp-action="@Model.AddActionName" method="post" class="mt-2 p-2 border rounded">
                @if (!string.IsNullOrEmpty(Model.ScopeHiddenFieldName))
                {
                    <input type="hidden" name="@Model.ScopeHiddenFieldName" value="@Model.ScopeId" />
                }
                <input type="hidden" name="ActionType" value="@((int)api.Models.ActionType.Notification)" />
                <div class="row g-2 mb-2">
                    <div class="col-auto">
                        <label class="form-label small mb-0">Name</label>
                        <input type="text" name="Name" class="form-control form-control-sm" style="width:14rem" required />
                    </div>
                    <div class="col-auto">
                        <label class="form-label small mb-0">Description (optional)</label>
                        <input type="text" name="Description" class="form-control form-control-sm" style="width:16rem" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label small mb-0">Subject</label>
                        <input type="text" name="NotificationSubject" class="form-control form-control-sm" style="width:16rem" required />
                    </div>
                    <div class="col-auto">
                        <label class="form-label small mb-0">Body ({value}/{metric} placeholders)</label>
                        <input type="text" name="NotificationBody" class="form-control form-control-sm" style="width:20rem" />
                    </div>
                    <div class="col-auto align-self-end">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="IsSafetyRule" value="true" id="safety-notif" />
                            <label class="form-check-label small" for="safety-notif">Safety rule</label>
                        </div>
                    </div>
                </div>
                @TreeBuilder("notification", isNotification: true, notificationRules)
                <button type="submit" class="btn btn-sm btn-primary mt-2">Add notification rule</button>
            </form>
        </details>
    </div>
</div>

<script src="~/js/rule-builder.js"></script>
