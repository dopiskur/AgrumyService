@inject Agrumy.Web.Dal.Interface.IApi Api
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    Func<string, string> navActive = c => string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    Func<string, string, string> navActiveAction = (c, a) => string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase) && string.Equals(a, currentAction, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var currentUserEmail = User.Identity?.Name;
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    bool isGlobalReader = User.IsInRole(RoleNames.GlobalReader);
    Func<string, bool> hasAnyRoleOrReads = csv => hasAnyRole(csv) || isGlobalReader;
    // Horticulture Catalog (shared, read-only browse) and Alerts (now per-organization, see TenantAlertConfig) are the two Global-only items an Organization admin also gets; everything else Global-gated below stays Global admin/reader only.
    bool hasCatalogOrAlertsAccess = User.IsInRole(RoleNames.GlobalAdmin) || isGlobalReader || User.IsInRole(RoleNames.TenantAdmin);
    // Fetched for a Global admin or Global reader, the only two roles that can ever see the menu
    // items this gates. Swallowed on failure (just hides the item) since this runs in the shared
    // layout on every page - a transient Api hiccup must not take down the whole navigation shell.
    bool tenantManagementEnabled = false;
    bool gatewayEnabled = false;
    if (User.IsInRole(RoleNames.GlobalAdmin) || isGlobalReader)
    {
        try
        {
            var serverConfig = await Api.ServerConfigGet();
            tenantManagementEnabled = serverConfig.TenantManagementEnabled;
            gatewayEnabled = serverConfig.GatewayEnabled;
        }
        catch (Agrumy.Web.Utils.ApiException) { }
    }

    // "Farm" (singular) until a second one exists, then "Farms" - swallowed on failure same as the GlobalAdmin-only calls above, defaults to singular (the more common case).
    int farmCount = 1;
    try
    {
        farmCount = (await Api.DeviceFarmsGet()).Count;
    }
    catch (Agrumy.Web.Utils.ApiException) { }

    bool canEmergencyStop = hasAnyRole(RoleNames.DeviceManagers);
    bool emergencyStopActive = false;
    if (canEmergencyStop)
    {
        try
        {
            emergencyStopActive = await Api.EmergencyStopStatus();
        }
        catch (Agrumy.Web.Utils.ApiException) { }
    }
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <title>@ViewData["Title"] - Agrumy</title>

    <!-- Applies the visitor's saved light/dark preference before first paint, avoiding a flash of the wrong theme. -->
    <script nonce="@Context.CspNonce()">
        (() => {
            'use strict';
            const root = document.documentElement;
            const STORAGE_KEY = 'lte-theme';
            let stored = null;
            try { stored = localStorage.getItem(STORAGE_KEY); } catch { }
            const resolved = (stored === 'dark' || stored === 'light')
                ? stored
                : (globalThis.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            root.setAttribute('data-bs-theme', resolved);
            root.style.colorScheme = resolved;
        })();
    </script>

    <link rel="stylesheet" href="~/lib/adminlte/plugins/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/adminlte/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/adminlte/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/lib/adminlte/plugins/datatables-bs5/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/hierarchy-colors.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Toggle sidebar">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    @if (canEmergencyStop && !emergencyStopActive)
                    {
                        <li class="nav-item me-2">
                            <form asp-controller="EmergencyStop" asp-action="Activate" method="post">
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="btn btn-sm btn-danger fw-bold" title="@Localizer["Immediately stop every actuator in this tenant"]">
                                    <i class="bi bi-exclamation-octagon-fill me-1"></i>@Localizer["E-STOP"]
                                </button>
                            </form>
                        </li>
                    }
                    <li class="nav-item me-2">
                        <partial name="_LanguageSwitcher" />
                    </li>
                    @if (!string.IsNullOrEmpty(currentUserEmail))
                    {
                        <li class="nav-item dropdown me-2">
                            <a class="nav-link" href="#" id="user-menu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i><span class="d-none d-sm-inline">@currentUserEmail</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="user-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                        <i class="bi bi-person-gear me-2"></i>@Localizer["My Profile"]
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    <li class="nav-item dropdown">
                        <a class="nav-link" href="#" id="lte-theme-toggle" aria-label="Toggle color scheme" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-sun-fill" data-lte-theme-icon="light"></i>
                            <i class="bi bi-moon-fill d-none" data-lte-theme-icon="dark"></i>
                            <i class="bi bi-circle-half d-none" data-lte-theme-icon="auto"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="lte-theme-toggle">
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="light">
                                    <i class="bi bi-sun-fill me-2"></i>Light
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="dark">
                                    <i class="bi bi-moon-fill me-2"></i>Dark
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="auto">
                                    <i class="bi bi-circle-half me-2"></i>Auto
                                </button>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="brand-link">
                    <i class="bi bi-flower1 fs-4 ms-1 me-2"></i>
                    <span class="brand-text fw-bold">Agrumy</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2" aria-label="Main navigation">
                    <ul class="nav sidebar-menu flex-column" id="navigation">
                        @* D1 (Detaljni dizajn R) - two separate root items instead of one mixed Farms page; Greenhouse keeps its own page, Open-Field farming gets its own (with Crop Seasons/Parcels nested under it). *@
                        <li class="nav-item">
                            <a asp-area="" asp-controller="DeviceFarmUnit" asp-action="Index" class="nav-link @navActive("DeviceFarmUnit")">
                                <i class="nav-icon bi bi-sliders"></i>
                                <p>@Localizer["Dashboard"]</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="FarmGroup" asp-action="Index" class="nav-link @navActive("FarmGroup")">
                                <i class="nav-icon bi bi-diagram-3"></i>
                                <p>@Localizer["Farm Groups"]</p>
                            </a>
                        </li>
                        @{
                            bool openfieldSectionActive = string.Equals(currentController, "FarmOpenfield", StringComparison.OrdinalIgnoreCase)
                                && !string.Equals(currentAction, "FarmSatellite", StringComparison.OrdinalIgnoreCase);
                        }
                        <li class="nav-item @(openfieldSectionActive ? "menu-open" : "")">
                            <a href="#" data-lte-toggle="treeview" class="nav-link @(openfieldSectionActive ? "active" : "")" aria-expanded="@(openfieldSectionActive ? "true" : "false")">
                                <i class="nav-icon bi bi-flower1"></i>
                                <p>
                                    @Localizer["Open-Field farming"]
                                    <i class="nav-arrow bi bi-chevron-right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="FarmOpenfield" asp-action="Index" class="nav-link @navActiveAction("FarmOpenfield", "Index")">
                                        <i class="nav-icon bi bi-house-door"></i>
                                        <p>@Localizer["Farms"]</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="FarmOpenfield" asp-action="CropSeasons" class="nav-link @navActiveAction("FarmOpenfield", "CropSeasons")">
                                        <i class="nav-icon bi bi-calendar3"></i>
                                        <p>@Localizer["Crop Seasons"]</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="FarmOpenfield" asp-action="ParcelsRegistry" class="nav-link @navActiveAction("FarmOpenfield", "ParcelsRegistry")">
                                        <i class="nav-icon bi bi-map"></i>
                                        <p>@Localizer["Parcels"]</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="DeviceFarmUnit" asp-action="Farms" class="nav-link @(string.Equals(currentAction, "Farms", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                <i class="nav-icon bi bi-house-door"></i>
                                <p>@Localizer["Greenhouse"]</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Device" asp-action="Fleet" class="nav-link @navActive("Device")">
                                <i class="nav-icon bi bi-broadcast"></i>
                                <p>@Localizer["Device fleet"]</p>
                            </a>
                        </li>
                        @if (hasCatalogOrAlertsAccess)
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Alerts" asp-action="Index" class="nav-link @navActive("Alerts")">
                                    <i class="nav-icon bi bi-bell"></i>
                                    <p>@Localizer["Alerts"]</p>
                                </a>
                            </li>
                        }
                        @if (hasAnyRoleOrReads(RoleNames.DeviceManagers))
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="DeviceFarmUnit" asp-action="GlobalRules" class="nav-link @(string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "GlobalRules", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <i class="nav-icon bi bi-diagram-3"></i>
                                    <p>@Localizer["Global Rules"]</p>
                                </a>
                            </li>
                        }
                        @if (hasAnyRoleOrReads(RoleNames.UserManagers))
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="User" asp-action="Index" class="nav-link @navActive("User")">
                                    <i class="nav-icon bi bi-people"></i>
                                    <p>@Localizer["Users"]</p>
                                </a>
                            </li>
                        }
                        @if (hasAnyRoleOrReads(RoleNames.SimulationManagers))
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Simulation" asp-action="Index" class="nav-link @navActive("Simulation")">
                                    <i class="nav-icon bi bi-cpu-fill"></i>
                                    <p>@Localizer["Simulations"]</p>
                                </a>
                            </li>
                        }
                        @if (hasAnyRoleOrReads(RoleNames.DeviceManagers))
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Experiment" asp-action="Index" class="nav-link @navActive("Experiment")">
                                    <i class="nav-icon bi bi-flask"></i>
                                    <p>@Localizer["Experiments"]</p>
                                </a>
                            </li>
                        }
                        @if (hasCatalogOrAlertsAccess)
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="HorticultureCatalog" asp-action="Index" class="nav-link @navActive("HorticultureCatalog")">
                                    <i class="nav-icon bi bi-flower1"></i>
                                    <p>@Localizer["Horticulture Catalog"]</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Satellite" asp-action="Index" class="nav-link @navActive("Satellite")">
                                    <i class="nav-icon bi bi-globe"></i>
                                    <p>@Localizer["Satellite"]</p>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole(RoleNames.GlobalAdmin) || isGlobalReader)
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Firmware" asp-action="Index" class="nav-link @navActive("Firmware")">
                                    <i class="nav-icon bi bi-cpu"></i>
                                    <p>@Localizer["Firmware"]</p>
                                </a>
                            </li>
                        }
                        @if (hasAnyRoleOrReads(RoleNames.DeviceManagers))
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="WifiConfig" asp-action="Index" class="nav-link @navActive("WifiConfig")">
                                    <i class="nav-icon bi bi-wifi"></i>
                                    <p>@Localizer["WiFi Networks"]</p>
                                </a>
                            </li>
                        }
                        @if (hasAnyRoleOrReads(RoleNames.Admins))
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="AuditLog" asp-action="Index" class="nav-link @navActive("AuditLog")">
                                    <i class="nav-icon bi bi-clock-history"></i>
                                    <p>@Localizer["Audit Log"]</p>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole(RoleNames.GlobalAdmin) || isGlobalReader)
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="ServerConfig" asp-action="Index" class="nav-link @navActive("ServerConfig")">
                                    <i class="nav-icon bi bi-sliders"></i>
                                    <p>@Localizer["Server Settings"]</p>
                                </a>
                            </li>
                            @if (tenantManagementEnabled)
                            {
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="Tenant" asp-action="Index" class="nav-link @navActive("Tenant")">
                                        <i class="nav-icon bi bi-buildings"></i>
                                        <p>@Localizer["Tenants"]</p>
                                    </a>
                                </li>
                            }
                            @if (gatewayEnabled)
                            {
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="Gateway" asp-action="Index" class="nav-link @navActive("Gateway")">
                                        <i class="nav-icon bi bi-router"></i>
                                        <p>@Localizer["LoRa Gateway"]</p>
                                    </a>
                                </li>
                            }
                        }
                        @if (hasAnyRoleOrReads(RoleNames.DeviceManagers))
                        {
                            <li class="nav-item">
                                <a asp-area="" asp-controller="DeviceFarmUnit" asp-action="RecycleBin" class="nav-link @(string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "RecycleBin", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <i class="nav-icon bi bi-trash3"></i>
                                    <p>@Localizer["Recycle Bin"]</p>
                                </a>
                            </li>
                        }
                        <li class="nav-item mt-2 border-top border-secondary border-opacity-25 pt-2">
                            <a asp-area="" asp-controller="Login" asp-action="Logout" class="nav-link">
                                <i class="nav-icon bi bi-box-arrow-right"></i>
                                <p>@Localizer["Logout"]</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>
        <main class="app-main">
            @if (emergencyStopActive)
            {
                <div class="alert alert-danger rounded-0 mb-0 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-exclamation-octagon-fill me-2"></i><strong>@Localizer["Emergency stop is active"]</strong> - @Localizer["every actuator in this tenant is forced off."]</span>
                    @if (canEmergencyStop)
                    {
                        <form asp-controller="EmergencyStop" asp-action="Clear" method="post" onsubmit="return confirm('@Localizer["Resume normal operation? Actuators will follow their rules again."]');">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-sm btn-outline-light">@Localizer["Resume normal operation"]</button>
                        </form>
                    }
                </div>
            }
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <h1 class="mb-0 fs-3">@ViewData["Title"]</h1>
                        </div>
                        <div class="col-sm-6">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb float-sm-end">
                                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">@Localizer["Home"]</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">
                    <partial name="_ReadOnlyBanner" />
                    @RenderBody()
                </div>
            </div>
        </main>
        <footer class="app-footer">
            <strong>&copy; 2016-2026 <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Agrumy</a>.</strong> @Localizer["All rights reserved."]
        </footer>
    </div>

    @Html.AntiForgeryToken()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/adminlte/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/adminlte/dist/js/adminlte.min.js"></script>
    <script src="~/js/device-commands.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
