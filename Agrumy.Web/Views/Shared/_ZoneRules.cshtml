@model Agrumy.Web.ViewModels.ZoneViewModel
@{
    var ruleEditorModel = new Agrumy.Web.ViewModels.RuleEditorViewModel
    {
        Scope = Agrumy.Web.ViewModels.RuleScope.Zone,
        ScopeId = Model.Zone!.IDDeviceFarmUnitZone,
        Rules = Model.Rules,
        RedirectActionName = "Zone",
    };

    int idZone = Model.Zone!.IDDeviceFarmUnitZone!.Value;
    DeviceManualOverride? ActiveFor(RelayFunction f) => Model.ManualOverrides.FirstOrDefault(o => o.RelayFunction == f);

    var heatingModel = new ManualActuateFunctionViewModel
    {
        ScopeId = idZone, RelayFunction = RelayFunction.Heating, Label = "Heating",
        MaxRunSeconds = Model.Zone.HeatingMaxRunSeconds, AllowedTargetMetrics = [SensorMetric.Temperature],
        Active = ActiveFor(RelayFunction.Heating), DisplayTimeZone = Model.DisplayTimeZone,
    };
    var ventilationModel = new ManualActuateFunctionViewModel
    {
        ScopeId = idZone, RelayFunction = RelayFunction.Ventilation, Label = "Ventilation",
        MaxRunSeconds = Model.Zone.VentilationMaxRunSeconds, AllowedTargetMetrics = [SensorMetric.Temperature, SensorMetric.Humidity],
        Active = ActiveFor(RelayFunction.Ventilation), DisplayTimeZone = Model.DisplayTimeZone,
    };
    var irrigationModel = new ManualActuateFunctionViewModel
    {
        ScopeId = idZone, RelayFunction = RelayFunction.WaterPump, Label = "Irrigation",
        MaxRunSeconds = Model.Zone.WaterPumpMaxRunSeconds, AllowedTargetMetrics = [SensorMetric.Moisture],
        Active = ActiveFor(RelayFunction.WaterPump), DisplayTimeZone = Model.DisplayTimeZone,
    };
    var screenModel = new ManualActuateFunctionViewModel
    {
        ScopeId = idZone, RelayFunction = RelayFunction.Screen, Label = "Screen",
        AllowedTargetMetrics = [SensorMetric.Light],
        Active = ActiveFor(RelayFunction.Screen), DisplayTimeZone = Model.DisplayTimeZone,
    };
}

<partial name="_RuleEditor" model="ruleEditorModel" />

@{
    (string Label, IList<HorticultureCatalogEntry> Entries)[] catalogs =
    [
        ("Crop", Model.CropCatalog),
        ("Fruit", Model.FruitCatalog),
        ("Hydroponic", Model.HydroponicCatalog),
        ("Perma", Model.PermaCatalog),
    ];
}
@if (catalogs.Any(c => c.Entries.Count > 0))
{
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="fw-semibold">Apply Horticulture Catalog template</h6>
            <p class="text-secondary small">
                Adds a starter set of rules from the picked entry's recommended ranges - a reasonable
                default, not a finished configuration. Fine-tune (or delete) the generated rules above
                afterward like any other rule.
            </p>
            @foreach (var (label, entries) in catalogs)
            {
                if (entries.Count == 0)
                {
                    continue;
                }
                <form asp-action="ApplyHorticultureCatalog" method="post" class="d-flex align-items-end gap-2 mb-2">
                    <input type="hidden" name="idDeviceFarmUnitZone" value="@Model.Zone!.IDDeviceFarmUnitZone" />
                    <input type="hidden" name="catalogType" value="@label" />
                    <div>
                        <label class="form-label small mb-0">@label</label>
                        <select name="catalogId" class="form-select form-select-sm" style="min-width:16rem">
                            @foreach (var entry in entries)
                            {
                                <option value="@entry.ID">@entry.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Apply</button>
                </form>
            }
        </div>
    </div>
}

@{
    (RelayFunction Value, string Label)[] presetFunctions =
    [
        (RelayFunction.Heating, "Heating"), (RelayFunction.Ventilation, "Ventilation"),
        (RelayFunction.Light, "Light"), (RelayFunction.WaterPump, "Irrigation"),
    ];
    (SensorMetric Value, string Label)[] presetMetrics =
    [
        (SensorMetric.Temperature, "Temperature"), (SensorMetric.Humidity, "Humidity"),
        (SensorMetric.Moisture, "Moisture"), (SensorMetric.Light, "Light"), (SensorMetric.Co2, "Co2"),
    ];
    (ComparisonOperator Value, string Label)[] presetOperators =
    [
        (ComparisonOperator.LessThan, "<"), (ComparisonOperator.LessThanOrEqual, "<="),
        (ComparisonOperator.GreaterThan, ">"), (ComparisonOperator.GreaterThanOrEqual, ">="),
        (ComparisonOperator.Equal, "="),
    ];
}
<div class="card mb-3">
    <div class="card-body">
        <h6 class="fw-semibold">Day/Night targets</h6>
        <p class="text-secondary small">
            Generates two rules from one form - the same metric/comparison at a day threshold and a
            night threshold, each gated by a Schedule window (day window as given; night is its
            complement, wrapping past midnight). Fine-tune (or delete) the generated rules above
            afterward like any other rule. Astronomical (sunrise/sunset) day/night boundaries aren't
            wired into this preset yet - use a fixed time window.
        </p>
        <form asp-action="DayNightPresetAdd" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="idDeviceFarmUnitZone" value="@Model.Zone!.IDDeviceFarmUnitZone" />
            <div class="col-auto">
                <label class="form-label small mb-0">Function</label>
                <select name="Function" class="form-select form-select-sm">
                    @foreach (var (value, label) in presetFunctions)
                    {
                        <option value="@((int)value)">@label</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Metric</label>
                <select name="Metric" class="form-select form-select-sm">
                    @foreach (var (value, label) in presetMetrics)
                    {
                        <option value="@((int)value)">@label</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Operator</label>
                <select name="Operator" class="form-select form-select-sm">
                    @foreach (var (value, label) in presetOperators)
                    {
                        <option value="@((int)value)">@label</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Day value</label>
                <input type="number" step="any" name="DayValue" class="form-control form-control-sm" style="width:7rem" required />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Night value</label>
                <input type="number" step="any" name="NightValue" class="form-control form-control-sm" style="width:7rem" required />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Hysteresis</label>
                <input type="number" step="any" min="0" name="Hysteresis" class="form-control form-control-sm" style="width:6rem" value="0" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Day starts</label>
                <input type="time" name="DayStart" class="form-control form-control-sm" value="06:00" required />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Day ends</label>
                <input type="time" name="DayEnd" class="form-control form-control-sm" value="20:00" required />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Name prefix</label>
                <input type="text" name="NamePrefix" class="form-control form-control-sm" style="width:12rem" placeholder="e.g. Vegetative" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-outline-primary">Add day/night rules</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-3" id="manualActuateCard">
    <div class="card-body">
        <h6 class="fw-semibold">Manual actuate</h6>
        <p class="text-secondary small">
            Runs a function right now, bypassing automated rules (and, for WaterPump, the rain-skip
            veto) until it stops itself or you click Stop.
        </p>
        <partial name="_ManualActuateFunction" model="heatingModel" />
        <partial name="_ManualActuateFunction" model="ventilationModel" />
        <partial name="_ManualActuateFunction" model="irrigationModel" />
        <partial name="_ManualActuateFunction" model="screenModel" />
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h6 class="fw-semibold">Safety limits</h6>
        <p class="text-secondary small">
            A hard ceiling the device enforces AFTER any rule (or manual command above) decides a
            function should run, independent of what decided it. 0/blank disables it.
        </p>
        <form asp-action="SafetyLimitsUpdate" method="post" class="d-flex flex-wrap align-items-end gap-2">
            <input type="hidden" name="idDeviceFarmUnitZone" value="@Model.Zone!.IDDeviceFarmUnitZone" />
            <div>
                <label class="form-label small mb-0">WaterPump max run seconds</label>
                <input type="number" min="0" name="waterPumpMaxRunSeconds" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.WaterPumpMaxRunSeconds" />
            </div>
            <div>
                <label class="form-label small mb-0">WaterPump cooldown seconds</label>
                <input type="number" min="0" name="waterPumpCooldownSeconds" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.WaterPumpCooldownSeconds" />
            </div>
            <div>
                <label class="form-label small mb-0">Heating max run seconds</label>
                <input type="number" min="0" name="heatingMaxRunSeconds" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.HeatingMaxRunSeconds" />
            </div>
            <div>
                <label class="form-label small mb-0">Heating stale-sensor fail-safe</label>
                <select name="heatingFailSafePolicy" class="form-select form-select-sm" style="width:12rem">
                    <option value="@HeatingFailSafePolicyType.Hold" selected="@(Model.Zone.HeatingFailSafePolicy is null or HeatingFailSafePolicyType.Hold)">Hold, then force off (default)</option>
                    <option value="@HeatingFailSafePolicyType.Off" selected="@(Model.Zone.HeatingFailSafePolicy == HeatingFailSafePolicyType.Off)">Force off immediately</option>
                    <option value="@HeatingFailSafePolicyType.ScheduleOnly" selected="@(Model.Zone.HeatingFailSafePolicy == HeatingFailSafePolicyType.ScheduleOnly)">Fall back to schedule only</option>
                </select>
            </div>
            <div>
                <label class="form-label small mb-0">Ventilation max run seconds</label>
                <input type="number" min="0" name="ventilationMaxRunSeconds" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.VentilationMaxRunSeconds" />
            </div>
            <div class="form-check mb-1">
                <input type="checkbox" class="form-check-input" id="skipWaterPumpWhenRainPredicted" name="skipWaterPumpWhenRainPredicted" value="true" checked="@Model.Zone.SkipWaterPumpWhenRainPredicted" />
                <label class="form-check-label small" for="skipWaterPumpWhenRainPredicted">
                    Skip when rain predicted
                </label>
            </div>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>
        <p class="text-secondary small mt-1">
            Heating/Ventilation max run seconds also gate whether Manual actuate's Target mode is
            available above - Target mode has no other self-cap, so it needs one of these set first.
        </p>
        <p class="text-secondary small mt-1">
            When checked, this zone's WaterPump also stays off whenever the install-wide forecast
            (Server Settings &rarr; Weather) predicts rain - a second AND-NOT gate, independent of
            the safety limits above and applied after all WaterPump rules' OR.
        </p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h6 class="fw-semibold">Tank calibration</h6>
        <p class="text-secondary small">
            Translates this zone's raw WaterLevel readings into a fill percent/volume shown above,
            and drives the low-tank refill alert. Leave all three blank to disable tank tracking
            for this zone.
        </p>
        <form asp-action="TankCalibrationUpdate" method="post" class="d-flex flex-wrap align-items-end gap-2">
            <input type="hidden" name="idDeviceFarmUnitZone" value="@Model.Zone!.IDDeviceFarmUnitZone" />
            <div>
                <label class="form-label small mb-0">Tank capacity (liters)</label>
                <input type="number" min="0" step="any" name="tankCapacityLiters" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.TankCapacityLiters" />
            </div>
            <div>
                <label class="form-label small mb-0">Raw reading when empty</label>
                <input type="number" name="waterLevelRawEmpty" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.WaterLevelRawEmpty" />
            </div>
            <div>
                <label class="form-label small mb-0">Raw reading when full</label>
                <input type="number" name="waterLevelRawFull" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.WaterLevelRawFull" />
            </div>
            <div>
                <label class="form-label small mb-0">WaterPump min level (%)</label>
                <input type="number" min="0" max="100" step="any" name="waterPumpMinLevel" class="form-control form-control-sm" style="width:10rem" value="@Model.Zone.WaterPumpMinLevel" />
            </div>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>
        <p class="text-secondary small mt-1">
            WaterPump min level blocks the pump (Interval/Schedule/Manual included, not just Threshold)
            below this fill percent - dry-run protection. Needs the three calibration fields above set
            first; blank/0 leaves WaterPump unprotected, same as a Water Valve with no tank sensor.
        </p>
    </div>
</div>
