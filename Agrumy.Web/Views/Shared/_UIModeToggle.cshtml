@{
    bool simpleMode = User.GetUIMode() == UIMode.Simple;
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<form id="uiModeToggleForm" asp-controller="Profile" asp-action="ToggleUIMode" method="post" class="d-inline">
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    <button type="button" id="uiModeToggleBtn" class="btn btn-sm btn-outline-secondary" title="@(simpleMode ? "Simple view - click to switch to Advanced" : "Advanced view - click to switch to Simple")">
        @(simpleMode ? "Simple" : "Advanced")
    </button>
</form>
<script nonce="@Context.CspNonce()">
    document.getElementById('uiModeToggleBtn').addEventListener('click', () => document.getElementById('uiModeToggleForm').submit());
</script>
