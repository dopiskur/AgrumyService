@model Agrumy.Shared.Models.DeviceView

@{
    ViewData["Title"] = "Sensor data";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Sensor data: @Html.DisplayFor(model => model.Device!.DeviceName)</h3>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get">
            <input type="hidden" name="idDevice" value="@Model.Device!.IDDevice" />
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label" for="from">From</label>
                    <input type="datetime-local" id="from" name="from" value="@Model.SensorDataFrom?.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
                </div>
                <div class="col-auto">
                    <label class="form-label" for="to">To</label>
                    <input type="datetime-local" id="to" name="to" value="@Model.SensorDataTo?.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
                </div>
                <div class="col-auto">
                    <label class="form-label" for="bucket">Bucket</label>
                    <select id="bucket" name="bucket" class="form-select" asp-items="ViewBag.BucketList"></select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-success">Load data</button>
                </div>
            </div>
        </form>
    </div>
    <div class="card-footer">
        <a asp-controller="Device" asp-action="Fleet" class="btn btn-primary">Back</a>
    </div>
</div>

<partial name="_SensorCharts" model="Model" />
