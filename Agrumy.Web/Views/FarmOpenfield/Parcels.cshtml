@model CropParcelsViewModel
@{
    ViewData["Title"] = Model.Crop.SowingName;
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    bool canManage = hasAnyRole(RoleNames.DeviceManagers);
    bool isReadOnly = ViewBag.IsReadOnly is true;
    string statusBadge = Model.Crop.Status switch
    {
        GrowingCycleStatus.Planned => "text-bg-secondary",
        GrowingCycleStatus.Active => "text-bg-success",
        _ => "text-bg-dark",
    };
    bool phiPending = Model.EarliestHarvestDate is DateOnly ehd && ehd > DateOnly.FromDateTime(DateTime.UtcNow);
    const double nitrogenWarningThresholdKgPerHa = 170; // Detaljni dizajn R, "Bilanca N" default threshold
    // "Add event" type options, filtered by the sowing's current phase (D6 katalog tipova unosa).
    var eventTypes = Model.Crop.Status switch
    {
        GrowingCycleStatus.Planned => new[] { EntryType.Ploughing, EntryType.Discing, EntryType.Harrowing, EntryType.Subsoiling, EntryType.BaseFertilization, EntryType.SoilAnalysis, EntryType.Liming, EntryType.Other },
        GrowingCycleStatus.Active => new[] { EntryType.Fertilization, EntryType.PlantProtection, EntryType.Irrigation, EntryType.Weeding, EntryType.Pruning, EntryType.Observation, EntryType.Scouting, EntryType.Sampling, EntryType.Other },
        _ => new[] { EntryType.PostHarvestAnalysis, EntryType.Storage, EntryType.Sale, EntryType.Other },
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="ParcelsRegistry">Parcels</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Crop.SowingName</li>
    </ol>
</nav>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<div class="row g-3">
<div class="col-lg-7">
<div class="card">
    <div class="card-header d-flex align-items-center flex-wrap gap-2">
        <h3 class="card-title mb-0">
            @Model.Crop.SowingName <span class="text-secondary small">(@Model.Farm.DeviceFarmName)</span>
            <span class="badge @statusBadge">@Model.Crop.Status</span>
            @if (Model.EarliestHarvestDate is DateOnly earliestHarvestDate)
            {
                <span class="badge @(phiPending ? "text-bg-warning" : "text-bg-light text-dark")" title="Earliest date Harvest can be entered without an explicit confirmation (D13)">
                    Karenca do @earliestHarvestDate.ToString("yyyy-MM-dd")
                </span>
            }
            @if (Model.NitrogenBalanceKgPerHa is double nBalance)
            {
                <span class="badge @(nBalance > nitrogenWarningThresholdKgPerHa ? "text-bg-danger" : "text-bg-light text-dark")" title="Bilanca N - kg N/ha across every Fertilization entry">
                    N: @nBalance.ToString("0.#") kg/ha
                </span>
            }
        </h3>
        @if (canManage || isReadOnly)
        {
            <a asp-action="SowingRules" asp-route-idSowing="@Model.Crop.IDSowing" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-diagram-3"></i> Automation rules
            </a>
        }
        @if (canManage)
        {
            @if (Model.Crop.Status != GrowingCycleStatus.Closed)
            {
                <form asp-action="CropRename" method="post" class="d-flex gap-1">
                    <input type="hidden" name="idSowing" value="@Model.Crop.IDSowing" />
                    <input type="text" name="farmOpenfieldCropName" class="form-control form-control-sm" value="@Model.Crop.SowingName" required maxlength="100" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Rename</button>
                </form>
                <form asp-action="CropDelete" method="post" data-confirm="Delete this sowing?" class="ms-auto">
                    <input type="hidden" name="idSowing" value="@Model.Crop.IDSowing" />
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete sowing"><i class="bi bi-trash"></i></button>
                </form>
            }
        }
    </div>
    <div class="card-body">
        @if (Model.Crop.Status == GrowingCycleStatus.Planned)
        {
            <h5>Start sowing - pick free zones</h5>
            @if (Model.AvailableParcels.SelectMany(p => p.Zones).All(z => z.CurrentSowingID != null))
            {
                <p class="text-secondary small fst-italic">No free zones on this farm yet - add a parcel or close another sowing first.</p>
            }
            else if (canManage)
            {
                <form asp-action="SowingStart" method="post" class="mb-3">
                    <input type="hidden" name="idSowing" value="@Model.Crop.IDSowing" />
                    @foreach (var pz in Model.AvailableParcels)
                    {
                        <div class="mb-2">
                            <strong>@pz.Parcel.FarmParcelName</strong>
                            @foreach (var z in pz.Zones)
                            {
                                bool locked = z.CurrentSowingID != null;
                                <div class="form-check form-check-inline @(locked ? "text-secondary" : "")">
                                    <input class="form-check-input" type="checkbox" name="farmParcelZoneIds" value="@z.IDFarmParcelZone" id="zone-@z.IDFarmParcelZone" disabled="@locked" />
                                    <label class="form-check-label" for="zone-@z.IDFarmParcelZone">
                                        @z.FarmParcelZoneName @(locked ? "(held by another sowing)" : "")
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-play-fill"></i> Start sowing</button>
                </form>
            }
        }
        else if (Model.Crop.Status == GrowingCycleStatus.Active && canManage)
        {
            <details class="mb-3">
                <summary class="fw-semibold">Close sowing</summary>
                <form asp-action="SowingClose" method="post" class="row g-2 mt-2" style="max-width:40rem">
                    <input type="hidden" name="idSowing" value="@Model.Crop.IDSowing" />
                    <div class="col-6">
                        <label class="form-label small">Yield (kg)</label>
                        <input type="number" step="0.01" name="yieldKg" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Moisture %</label>
                        <input type="number" step="0.1" name="moisturePercent" class="form-control form-control-sm" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Quality grade</label>
                        <input type="text" name="qualityGrade" class="form-control form-control-sm" maxlength="40" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small">Note</label>
                        <textarea name="note" class="form-control form-control-sm" rows="2"></textarea>
                    </div>
                    @if (phiPending)
                    {
                        <div class="col-12 form-check">
                            <input type="checkbox" class="form-check-input" name="confirmEarlyHarvest" value="true" id="confirmEarlyHarvest" required />
                            <label class="form-check-label small" for="confirmEarlyHarvest">
                                I confirm harvesting before the karenca (pre-harvest interval) of @Model.EarliestHarvestDate?.ToString("yyyy-MM-dd") has passed.
                            </label>
                        </div>
                    }
                    <div class="col-12">
                        <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Close this sowing? Its zones become free again.">
                            <i class="bi bi-flag-fill"></i> Close sowing
                        </button>
                    </div>
                </form>
            </details>
        }

        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0">Zones</h5>
            @if (canManage && Model.Crop.Status != GrowingCycleStatus.Closed)
            {
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#manageParcelsModal">
                    <i class="bi bi-ui-checks-grid"></i> Manage parcels
                </button>
            }
        </div>
        @if (Model.Parcels.Count == 0)
        {
            <p class="text-secondary">No zones occupied yet.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var p in Model.Parcels)
                {
                    <div class="col-md-4">
                        <a asp-action="Parcel" asp-route-idFarmParcelZone="@p.IDFarmParcelZone" class="text-decoration-none text-reset">
                            <div class="small-box text-bg-info h-100">
                                <div class="inner">
                                    <h3 class="fs-4">@p.FarmParcelZoneName <partial name="_ZoneStatusBadge" model="(p.Status, p.ProblemAlerts)" /></h3>
                                    <p class="mb-2">@p.DeviceCount device@(p.DeviceCount == 1 ? "" : "s")</p>
                                    <partial name="_SensorAverages" model="new SensorSummaryViewModel { Averages = p.Averages, Trend = p.Trend }" />
                                </div>
                                <div class="small-box-icon"><i class="bi bi-flower1"></i></div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="card mt-3">
    <div class="card-header d-flex align-items-center flex-wrap gap-2">
        <h3 class="card-title mb-0">Sowing journal</h3>
        <a asp-action="PlantProtectionReport" asp-route-idSowing="@Model.Crop.IDSowing" class="btn btn-sm btn-outline-secondary ms-auto">
            <i class="bi bi-file-earmark-spreadsheet"></i> Evidencija SZB (CSV)
        </a>
    </div>
    <div class="card-body">
        @if (canManage && Model.Crop.Status != GrowingCycleStatus.Closed)
        {
            <details class="mb-3">
                <summary class="fw-semibold">+ Add event</summary>
                <form asp-action="FieldLogEntryAdd" method="post" class="row g-2 mt-2" style="max-width:40rem" id="fieldLogForm">
                    <input type="hidden" name="idSowing" value="@Model.Crop.IDSowing" />
                    <div class="col-6">
                        <label class="form-label small">Type</label>
                        <select name="EntryType" id="entryTypeSelect" class="form-select form-select-sm">
                            @foreach (var t in eventTypes)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Date</label>
                        <input type="date" name="Date" class="form-control form-control-sm" value="@DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="col-12 entrytype-fields" data-for="Fertilization,BaseFertilization">
                        <div class="row g-2">
                            <div class="col-4"><input type="text" name="Product" class="form-control form-control-sm" placeholder="Product" /></div>
                            <div class="col-2"><input type="number" step="0.1" name="NPercent" class="form-control form-control-sm" placeholder="N%" /></div>
                            <div class="col-2"><input type="number" step="0.1" name="PPercent" class="form-control form-control-sm" placeholder="P%" /></div>
                            <div class="col-2"><input type="number" step="0.1" name="KPercent" class="form-control form-control-sm" placeholder="K%" /></div>
                            <div class="col-4"><input type="number" step="0.1" name="DoseKgPerHa" class="form-control form-control-sm" placeholder="Dose kg/ha" /></div>
                            <div class="col-4"><input type="number" step="0.01" name="AreaHa" class="form-control form-control-sm" placeholder="Area ha" /></div>
                        </div>
                    </div>

                    <div class="col-12 entrytype-fields" data-for="SoilAnalysis">
                        <div class="row g-2">
                            <div class="col-3"><input type="number" step="0.1" name="PH" class="form-control form-control-sm" placeholder="pH" /></div>
                            <div class="col-3"><input type="number" step="0.1" name="HumusPercent" class="form-control form-control-sm" placeholder="Humus %" /></div>
                            <div class="col-3"><input type="number" step="0.1" name="P2O5" class="form-control form-control-sm" placeholder="P2O5" /></div>
                            <div class="col-3"><input type="number" step="0.1" name="K2O" class="form-control form-control-sm" placeholder="K2O" /></div>
                            <div class="col-3"><input type="number" step="0.1" name="NMin" class="form-control form-control-sm" placeholder="N-min" /></div>
                            <div class="col-3"><input type="number" step="1" name="DepthCm" class="form-control form-control-sm" placeholder="Depth cm" /></div>
                            <div class="col-6"><input type="text" name="Laboratory" class="form-control form-control-sm" placeholder="Laboratory" /></div>
                        </div>
                    </div>

                    <div class="col-12 entrytype-fields" data-for="PlantProtection">
                        <p class="text-secondary small mb-1">Legally required (evidencija SZB):</p>
                        <div class="row g-2">
                            <div class="col-6"><input type="text" name="ProductName" class="form-control form-control-sm" placeholder="Product name" /></div>
                            <div class="col-6"><input type="text" name="ActiveSubstance" class="form-control form-control-sm" placeholder="Active substance" /></div>
                            <div class="col-4"><input type="text" name="Dose" class="form-control form-control-sm" placeholder="Dose/concentration" /></div>
                            <div class="col-4"><input type="number" step="0.01" name="TreatedAreaHa" class="form-control form-control-sm" placeholder="Treated area ha" /></div>
                            <div class="col-4"><input type="number" step="1" name="PhiDays" class="form-control form-control-sm" placeholder="Karenca (days)" /></div>
                            <div class="col-6"><input type="text" name="Reason" class="form-control form-control-sm" placeholder="Reason (pest/disease/weed)" /></div>
                            <div class="col-6"><input type="text" name="Applicator" class="form-control form-control-sm" placeholder="Applicator" /></div>
                            <div class="col-12"><input type="text" name="WeatherConditions" class="form-control form-control-sm" placeholder="Weather conditions (optional)" /></div>
                        </div>
                    </div>

                    <div class="col-12 entrytype-fields" data-for="Irrigation">
                        <div class="row g-2">
                            <div class="col-3"><input type="number" step="0.1" name="AmountMm" class="form-control form-control-sm" placeholder="mm" /></div>
                            <div class="col-3"><input type="number" step="0.1" name="AmountM3" class="form-control form-control-sm" placeholder="m3" /></div>
                            <div class="col-3"><input type="number" step="1" name="DurationMinutes" class="form-control form-control-sm" placeholder="Duration (min)" /></div>
                            <div class="col-3"><input type="text" name="Source" class="form-control form-control-sm" placeholder="Source" /></div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small">Note</label>
                        <textarea name="Note" class="form-control form-control-sm" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Add event</button>
                    </div>
                </form>
            </details>
            <script nonce="@Context.CspNonce()">
                (function () {
                    var select = document.getElementById('entryTypeSelect');
                    if (!select) return;
                    function apply() {
                        document.querySelectorAll('#fieldLogForm .entrytype-fields').forEach(function (el) {
                            var types = el.getAttribute('data-for').split(',');
                            el.hidden = types.indexOf(select.value) === -1;
                        });
                    }
                    select.addEventListener('change', apply);
                    apply();
                })();
            </script>
        }

        @if (Model.LogEntries.Count == 0)
        {
            <p class="text-secondary small fst-italic">No entries yet.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead><tr><th>Date</th><th>Type</th><th>Note</th><th></th></tr></thead>
                <tbody>
                    @foreach (var entry in Model.LogEntries.OrderByDescending(e => e.DateUtc))
                    {
                        <tr>
                            <td>@entry.DateUtc.ToString("yyyy-MM-dd")</td>
                            <td>@entry.EntryType @(entry.IsClosingEntry ? "(closing)" : "")</td>
                            <td>@entry.Note</td>
                            <td>
                                @if (canManage)
                                {
                                    <form asp-action="FieldLogEntryDelete" method="post" class="d-inline" data-confirm="Delete this entry?">
                                        <input type="hidden" name="idFieldLogEntry" value="@entry.IDFieldLogEntry" />
                                        <input type="hidden" name="idSowing" value="@Model.Crop.IDSowing" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
</div>

<div class="col-lg-5">
    <partial name="_SatelliteMap" model="new SatelliteMapViewModel { Scope = Agrumy.Shared.Models.SatelliteMapScope.Sowing, Id = Model.Crop.IDSowing!.Value, CanManage = canManage }" />
</div>
</div>

@if (canManage && Model.Crop.Status != GrowingCycleStatus.Closed)
{
    <div class="modal fade" id="manageParcelsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header flex-wrap gap-2">
                    <h5 class="modal-title me-auto">Manage parcels</h5>
                    <button type="button" class="btn btn-sm btn-outline-primary manage-parcels-toggle" data-picker="parcel">+ Add parcel</button>
                    <button type="button" class="btn btn-sm btn-outline-primary manage-parcels-toggle" data-picker="group">+ Add parcel group</button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="manage-parcels-picker d-none mb-3" data-picker="parcel">
                        <input type="search" class="form-control form-control-sm mb-2 manage-parcels-picker-filter" placeholder="Search parcels...">
                        <div class="border rounded" style="max-height:12rem;overflow-y:auto">
                            <table class="table table-sm table-hover mb-0"><tbody class="manage-parcels-picker-body"></tbody></table>
                        </div>
                    </div>
                    <div class="manage-parcels-picker d-none mb-3" data-picker="group">
                        <input type="search" class="form-control form-control-sm mb-2 manage-parcels-picker-filter" placeholder="Search parcel groups...">
                        <div class="border rounded" style="max-height:12rem;overflow-y:auto">
                            <table class="table table-sm table-hover mb-0"><tbody class="manage-parcels-picker-body"></tbody></table>
                        </div>
                    </div>

                    <div class="manage-parcels-groups-block mb-3 d-none">
                        <h6>Parcel groups</h6>
                        <input type="search" class="form-control form-control-sm mb-2 manage-groups-filter" placeholder="Search...">
                        <div class="border rounded" style="max-height:10rem;overflow-y:auto">
                            <table class="table table-sm mb-0"><tbody class="manage-groups-body"></tbody></table>
                        </div>
                    </div>

                    <h6>Parcels</h6>
                    <input type="search" class="form-control form-control-sm mb-2 manage-zones-filter" placeholder="Search parcels...">
                    <div class="border rounded" style="max-height:18rem;overflow-y:auto">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Ready</th><th>Parcel</th><th>Group</th><th></th><th></th></tr></thead>
                            <tbody class="manage-zones-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="assignToGroupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Assign to group</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-grid gap-2 assign-to-group-body"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="removeParcelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Remove parcel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body d-grid gap-2 remove-parcel-body"></div>
            </div>
        </div>
    </div>

    <form asp-action="SowingReleaseZone" method="post" class="d-none" id="formSowingReleaseZone">
        <input type="hidden" name="idSowing" value="@Model.Crop.IDSowing" />
        <input type="hidden" name="idFarmParcelZone" class="release-zone-id" />
    </form>
    <form asp-action="SowingReleaseGroup" method="post" class="d-none" id="formSowingReleaseGroup">
        <input type="hidden" name="idSowing" value="@Model.Crop.IDSowing" />
        <input type="hidden" name="idFarmParcelGroupCrop" class="release-group-id" />
    </form>
    <form asp-action="SowingStart" method="post" class="d-none" id="formSowingAddZone">
        <input type="hidden" name="idSowing" value="@Model.Crop.IDSowing" />
        <input type="hidden" name="farmParcelZoneIds" class="add-zone-id" />
    </form>
    <form asp-action="SowingAddGroup" method="post" class="d-none" id="formSowingAddGroup">
        <input type="hidden" name="idSowing" value="@Model.Crop.IDSowing" />
        <input type="hidden" name="idFarmParcelGroupCrop" class="add-group-id" />
    </form>
    <form asp-action="ParcelGroupAddMember" method="post" class="d-none" id="formParcelGroupAddMember">
        <input type="hidden" name="idFarmParcelGroupCrop" class="assign-group-id" />
        <input type="hidden" name="idFarmParcel" class="assign-parcel-id" />
        <input type="hidden" name="returnUrl" value="@Url.Action("Parcels", new { idSowing = Model.Crop.IDSowing })" />
    </form>
    <form asp-action="ParcelGroupRemoveMember" method="post" class="d-none" id="formParcelGroupRemoveMember">
        <input type="hidden" name="idFarmParcelGroupCrop" class="ungroup-group-id" />
        <input type="hidden" name="idFarmParcel" class="ungroup-parcel-id" />
        <input type="hidden" name="returnUrl" value="@Url.Action("Parcels", new { idSowing = Model.Crop.IDSowing })" />
    </form>

    <script type="application/json" id="manageParcelsData">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            zones = Model.AvailableParcels.SelectMany(pz => pz.Zones.Select(z => new
            {
                id = z.IDFarmParcelZone,
                parcelId = pz.Parcel.IDFarmParcel,
                parcelName = pz.Parcel.FarmParcelName,
                zoneName = z.FarmParcelZoneName,
                ready = z.ReadyForSeason,
                inSowing = z.CurrentSowingID == Model.Crop.IDSowing,
                locked = z.CurrentSowingID != null && z.CurrentSowingID != Model.Crop.IDSowing,
            })),
            groups = Model.ParcelGroups.Select(g => new { id = g.IDFarmParcelGroupCrop, name = g.Name, memberParcelIds = g.MemberParcelIds }),
        }, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))
    </script>
    <script nonce="@Context.CspNonce()">
        (function () {
            var data = JSON.parse(document.getElementById('manageParcelsData').textContent);
            var groupByParcelId = {};
            data.groups.forEach(function (g) {
                (g.memberParcelIds || []).forEach(function (pid) { groupByParcelId[pid] = g; });
            });

            function filterRows(input, body) {
                input.addEventListener('input', function () {
                    var q = input.value.trim().toLowerCase();
                    body.querySelectorAll('tr').forEach(function (row) {
                        row.hidden = q.length > 0 && row.getAttribute('data-search').indexOf(q) === -1;
                    });
                });
            }

            function submitHidden(formId, fieldClass, value) {
                var form = document.getElementById(formId);
                form.querySelector('.' + fieldClass).value = value;
                form.submit();
            }

            // ---- Ready toggle (same endpoint as the Parcels registry, no dialog) ----
            var antiForgeryToken = document.querySelector('#formSowingReleaseZone input[name="__RequestVerificationToken"]').value;
            function setReady(idFarmParcelZone, ready, checkbox) {
                fetch('@Url.Action("ParcelReadyForSeasonSet")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': antiForgeryToken },
                    body: 'idFarmParcelZone=' + encodeURIComponent(idFarmParcelZone) + '&ready=' + ready,
                }).then(function (r) { if (!r.ok) { checkbox.checked = !ready; } });
            }

            // ---- Main "Parcels" table (zones currently in this sowing) ----
            var zonesBody = document.querySelector('.manage-zones-body');
            var groupsBlock = document.querySelector('.manage-parcels-groups-block');
            var groupsBody = document.querySelector('.manage-groups-body');

            function renderZonesAndGroups() {
                var inSowing = data.zones.filter(function (z) { return z.inSowing; });
                zonesBody.innerHTML = '';
                inSowing.forEach(function (z) {
                    var group = groupByParcelId[z.parcelId];
                    var label = z.parcelName === z.zoneName ? z.zoneName : (z.parcelName + ' - ' + z.zoneName);
                    var tr = document.createElement('tr');
                    tr.setAttribute('data-search', label.toLowerCase());
                    tr.innerHTML =
                        '<td><div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch"' + (z.ready ? ' checked' : '') + '></div></td>' +
                        '<td>' + label.replace(/</g, '&lt;') + '</td>' +
                        '<td>' + (group ? '<span class="badge text-bg-secondary">' + group.name.replace(/</g, '&lt;') + '</span>' : '<button type="button" class="btn btn-sm btn-outline-secondary" data-assign>Assign to group</button>') + '</td>' +
                        '<td class="text-end"><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Parcel")?idFarmParcelZone=' + z.id + '">View</a></td>' +
                        '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" data-remove>Remove</button></td>';
                    tr.querySelector('input[type=checkbox]').addEventListener('change', function (e) { setReady(z.id, e.target.checked, e.target); });
                    var assignBtn = tr.querySelector('[data-assign]');
                    if (assignBtn) { assignBtn.addEventListener('click', function () { openAssignToGroup(z); }); }
                    tr.querySelector('[data-remove]').addEventListener('click', function () { openRemoveParcel(z, group); });
                    zonesBody.appendChild(tr);
                });

                var groupsInSowing = data.groups
                    .map(function (g) { return { g: g, count: inSowing.filter(function (z) { return groupByParcelId[z.parcelId] === g; }).length }; })
                    .filter(function (x) { return x.count > 0; });
                groupsBlock.classList.toggle('d-none', groupsInSowing.length === 0);
                groupsBody.innerHTML = '';
                groupsInSowing.forEach(function (x) {
                    var tr = document.createElement('tr');
                    tr.setAttribute('data-search', x.g.name.toLowerCase());
                    tr.innerHTML = '<td>' + x.g.name.replace(/</g, '&lt;') + '</td>' +
                        '<td class="text-secondary small">' + x.count + ' parcel(s) in this sowing</td>' +
                        '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" data-remove-group>Remove</button></td>';
                    tr.querySelector('[data-remove-group]').addEventListener('click', function () {
                        if (confirm('Remove parcel group "' + x.g.name + '" from this sowing? Every parcel it contributed is released.')) {
                            submitHidden('formSowingReleaseGroup', 'release-group-id', x.g.id);
                        }
                    });
                    groupsBody.appendChild(tr);
                });
            }

            function openAssignToGroup(zone) {
                var body = document.querySelector('.assign-to-group-body');
                body.innerHTML = '';
                if (data.groups.length === 0) {
                    body.innerHTML = '<p class="text-secondary small mb-0">No parcel groups on this farm yet.</p>';
                } else {
                    data.groups.forEach(function (g) {
                        var btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-outline-primary';
                        btn.textContent = g.name;
                        btn.addEventListener('click', function () {
                            document.querySelector('.assign-parcel-id').value = zone.parcelId;
                            submitHidden('formParcelGroupAddMember', 'assign-group-id', g.id);
                        });
                        body.appendChild(btn);
                    });
                }
                new bootstrap.Modal(document.getElementById('assignToGroupModal')).show();
            }

            function openRemoveParcel(zone, group) {
                var body = document.querySelector('.remove-parcel-body');
                body.innerHTML = '';
                if (group) {
                    var removeGroupBtn = document.createElement('button');
                    removeGroupBtn.type = 'button';
                    removeGroupBtn.className = 'btn btn-outline-danger';
                    removeGroupBtn.textContent = 'Remove parcel group "' + group.name + '"';
                    removeGroupBtn.addEventListener('click', function () { submitHidden('formSowingReleaseGroup', 'release-group-id', group.id); });
                    body.appendChild(removeGroupBtn);

                    var removeFromGroupBtn = document.createElement('button');
                    removeFromGroupBtn.type = 'button';
                    removeFromGroupBtn.className = 'btn btn-outline-secondary';
                    removeFromGroupBtn.textContent = 'Remove parcel from the parcel group';
                    removeFromGroupBtn.addEventListener('click', function () {
                        document.querySelector('.ungroup-parcel-id').value = zone.parcelId;
                        submitHidden('formParcelGroupRemoveMember', 'ungroup-group-id', group.id);
                    });
                    body.appendChild(removeFromGroupBtn);
                } else {
                    var removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.className = 'btn btn-outline-danger';
                    removeBtn.textContent = 'Remove this parcel from the sowing';
                    removeBtn.addEventListener('click', function () { submitHidden('formSowingReleaseZone', 'release-zone-id', zone.id); });
                    body.appendChild(removeBtn);
                }
                new bootstrap.Modal(document.getElementById('removeParcelModal')).show();
            }

            // ---- "Add parcel" / "Add parcel group" pickers ----
            document.querySelectorAll('.manage-parcels-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var kind = btn.getAttribute('data-picker');
                    var target = document.querySelector('.manage-parcels-picker[data-picker="' + kind + '"]');
                    var wasVisible = !target.classList.contains('d-none');
                    document.querySelectorAll('.manage-parcels-picker').forEach(function (block) { block.classList.add('d-none'); });
                    if (!wasVisible) { target.classList.remove('d-none'); }
                });
            });

            function fillParcelPicker() {
                var body = document.querySelector('.manage-parcels-picker[data-picker="parcel"] .manage-parcels-picker-body');
                body.innerHTML = '';
                data.zones.filter(function (z) { return !z.inSowing && !z.locked; }).forEach(function (z) {
                    var label = z.parcelName === z.zoneName ? z.zoneName : (z.parcelName + ' - ' + z.zoneName);
                    var tr = document.createElement('tr');
                    tr.setAttribute('data-search', label.toLowerCase());
                    tr.innerHTML = '<td>' + label.replace(/</g, '&lt;') + '</td><td class="text-end"><button type="button" class="btn btn-sm btn-primary">Add</button></td>';
                    tr.querySelector('button').addEventListener('click', function () { submitHidden('formSowingAddZone', 'add-zone-id', z.id); });
                    body.appendChild(tr);
                });
            }
            function fillGroupPicker() {
                var body = document.querySelector('.manage-parcels-picker[data-picker="group"] .manage-parcels-picker-body');
                body.innerHTML = '';
                data.groups.forEach(function (g) {
                    var tr = document.createElement('tr');
                    tr.setAttribute('data-search', g.name.toLowerCase());
                    tr.innerHTML = '<td>' + g.name.replace(/</g, '&lt;') + '</td><td class="text-end"><button type="button" class="btn btn-sm btn-primary">Add</button></td>';
                    tr.querySelector('button').addEventListener('click', function () { submitHidden('formSowingAddGroup', 'add-group-id', g.id); });
                    body.appendChild(tr);
                });
            }

            document.querySelectorAll('.manage-parcels-picker-filter').forEach(function (input) {
                filterRows(input, input.closest('.manage-parcels-picker').querySelector('.manage-parcels-picker-body'));
            });
            filterRows(document.querySelector('.manage-zones-filter'), zonesBody);
            filterRows(document.querySelector('.manage-groups-filter'), groupsBody);

            renderZonesAndGroups();
            fillParcelPicker();
            fillGroupPicker();
        })();
    </script>
}
