@model ParcelViewModel
@{
    var parcel = Model.Parcel;
    ViewData["Title"] = parcel.FarmParcelZoneName;
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    bool canManage = hasAnyRole(RoleNames.DeviceManagers);
    bool hasController = Model.Devices.Any(d => d.ControllerCapable);
    var ruleEditorModel = new RuleEditorViewModel
    {
        Scope = RuleScope.Parcel,
        ScopeId = parcel.IDFarmParcelZone,
        Rules = Model.Rules,
        RedirectActionName = "Parcel",
    };

    DeviceManualOverride? ActiveFor(RelayFunction f) => Model.ManualOverrides.FirstOrDefault(o => o.RelayFunction == f);
    var heatingModel = new ManualActuateFunctionViewModel
    {
        ScopeId = parcel.IDFarmParcelZone!.Value, IsParcelLevel = true, RelayFunction = RelayFunction.Heating, Label = "Heating",
        MaxRunSeconds = parcel.HeatingMaxRunSeconds, AllowedTargetMetrics = [SensorMetric.Temperature],
        Active = ActiveFor(RelayFunction.Heating), DisplayTimeZone = Model.DisplayTimeZone,
    };
    var ventilationModel = new ManualActuateFunctionViewModel
    {
        ScopeId = parcel.IDFarmParcelZone!.Value, IsParcelLevel = true, RelayFunction = RelayFunction.Ventilation, Label = "Ventilation",
        MaxRunSeconds = parcel.VentilationMaxRunSeconds, AllowedTargetMetrics = [SensorMetric.Temperature, SensorMetric.Humidity],
        Active = ActiveFor(RelayFunction.Ventilation), DisplayTimeZone = Model.DisplayTimeZone,
    };
    var irrigationModel = new ManualActuateFunctionViewModel
    {
        ScopeId = parcel.IDFarmParcelZone!.Value, IsParcelLevel = true, RelayFunction = RelayFunction.WaterPump, Label = "Irrigation",
        MaxRunSeconds = parcel.WaterPumpMaxRunSeconds, AllowedTargetMetrics = [SensorMetric.Moisture],
        Active = ActiveFor(RelayFunction.WaterPump), DisplayTimeZone = Model.DisplayTimeZone,
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="DeviceFarmUnit" asp-action="Farms">Farms</a></li>
        @if (Model.Crop is { } crop)
        {
            <li class="breadcrumb-item"><a asp-action="Parcels" asp-route-idSowing="@crop.IDSowing">@crop.SowingName</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">@parcel.FarmParcelZoneName</li>
    </ol>
</nav>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
}
@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}
@if (TempData["Warning"] is string scopeWarning)
{
    <div class="alert alert-info">@scopeWarning</div>
}

@if (canManage)
{
    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
        <form asp-action="ScanParcel" method="post" class="d-inline">
            <input type="hidden" name="ParcelID" value="@parcel.IDFarmParcelZone" />
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-broadcast"></i> Scan for new devices</button>
        </form>
    </div>
    @if (Model.DiscoveredDevices.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">Discovered devices</h3>
            </div>
            <div class="card-body">
                <partial name="_DiscoveredDevicesRows" model="Model.DiscoveredDevices" />
            </div>
        </div>
    }
}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">@parcel.FarmParcelZoneName</h3>
        @if (canManage)
        {
            <div class="float-end d-flex align-items-center gap-2">
                @if (!hasController)
                {
                    <a asp-action="ParcelAssignPicker" asp-route-idFarmParcelZone="@parcel.IDFarmParcelZone" asp-route-controllerCapable="true" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-cpu"></i> Add Controller
                    </a>
                }
                <a asp-action="ParcelAssignPicker" asp-route-idFarmParcelZone="@parcel.IDFarmParcelZone" asp-route-controllerCapable="false" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-broadcast"></i> Add Sensor
                </a>
                <form asp-action="ParcelRename" method="post" class="d-flex gap-1">
                    <input type="hidden" name="idFarmParcelZone" value="@parcel.IDFarmParcelZone" />
                    <input type="text" name="farmOpenfieldCropParcelName" class="form-control form-control-sm" value="@parcel.FarmParcelZoneName" required maxlength="120" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Rename</button>
                </form>
                <form asp-action="ParcelDelete" method="post" onsubmit="return confirm('Delete this parcel? Its devices are unassigned, not deleted.');">
                    <input type="hidden" name="idFarmParcelZone" value="@parcel.IDFarmParcelZone" />
                    <input type="hidden" name="idSowing" value="@Model.Crop?.IDSowing" />
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete parcel"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        }
    </div>
    <div class="card-body">
        @if (Model.Devices.Count == 0)
        {
            <p class="text-secondary">No devices assigned yet.</p>
        }
        else
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Device</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Devices)
                    {
                        <tr>
                            <td><a asp-controller="Device" asp-action="Details" asp-route-idDevice="@d.IDDevice">@d.DeviceName</a></td>
                            <td>@(d.IsVirtual ? "Virtual" : d.Online ? "Online" : "Offline")</td>
                            <td class="text-end">
                                @if (canManage)
                                {
                                    <form asp-action="Remove" method="post" class="d-inline" onsubmit="return confirm('Remove this device from the parcel?');">
                                        <input type="hidden" name="idDevice" value="@d.IDDevice" />
                                        <input type="hidden" name="idFarmParcelZone" value="@parcel.IDFarmParcelZone" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (canManage)
{
    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">Safety limits &amp; tank calibration</h3></div>
        <div class="card-body">
            <form asp-action="SafetyLimitsUpdate" method="post" class="row g-3">
                <input type="hidden" name="idFarmParcelZone" value="@parcel.IDFarmParcelZone" />
                <div class="col-md-3">
                    <label class="form-label small">WaterPump max run (s)</label>
                    <input type="number" name="waterPumpMaxRunSeconds" class="form-control form-control-sm" value="@parcel.WaterPumpMaxRunSeconds" min="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">WaterPump cooldown (s)</label>
                    <input type="number" name="waterPumpCooldownSeconds" class="form-control form-control-sm" value="@parcel.WaterPumpCooldownSeconds" min="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Heating max run (s)</label>
                    <input type="number" name="heatingMaxRunSeconds" class="form-control form-control-sm" value="@parcel.HeatingMaxRunSeconds" min="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Ventilation max run (s)</label>
                    <input type="number" name="ventilationMaxRunSeconds" class="form-control form-control-sm" value="@parcel.VentilationMaxRunSeconds" min="0" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="skipWaterPumpWhenRainPredicted" value="true" checked="@parcel.SkipWaterPumpWhenRainPredicted" id="skipRain" />
                        <label class="form-check-label small" for="skipRain">Skip watering when rain predicted</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Heating fail-safe policy</label>
                    <select name="heatingFailSafePolicy" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<HeatingFailSafePolicyType>()">
                        <option value="">-- none --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Tank capacity (L)</label>
                    <input type="number" step="0.1" name="tankCapacityLiters" class="form-control form-control-sm" value="@parcel.TankCapacityLiters" min="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Water level - empty (raw)</label>
                    <input type="number" name="waterLevelRawEmpty" class="form-control form-control-sm" value="@parcel.WaterLevelRawEmpty" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Water level - full (raw)</label>
                    <input type="number" name="waterLevelRawFull" class="form-control form-control-sm" value="@parcel.WaterLevelRawFull" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">WaterPump min level (%)</label>
                    <input type="number" step="0.1" name="waterPumpMinLevel" class="form-control form-control-sm" value="@parcel.WaterPumpMinLevel" min="0" max="100" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-sm btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
}

@if (canManage)
{
    <p class="text-end">
        <a asp-controller="DeviceFarmUnit" asp-action="Index" asp-route-idFarmParcelZone="@parcel.IDFarmParcelZone" class="small">
            <i class="bi bi-magic"></i> Build this parcel's dashboard in the wizard
        </a>
    </p>
}

@if (hasController)
{
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="fw-semibold">Manual actuate</h6>
            <p class="text-secondary small">
                Overrides this parcel's automation rules for one function for a set duration (or a target
                reading, if a MaxRunSeconds safety cap is configured below) until it stops itself or you
                click Stop.
            </p>
            <partial name="_ManualActuateFunction" model="heatingModel" />
            <partial name="_ManualActuateFunction" model="ventilationModel" />
            <partial name="_ManualActuateFunction" model="irrigationModel" />
        </div>
    </div>

    <partial name="_RuleEditor" model="ruleEditorModel" />
}

<div class="mt-3">
    <partial name="_SatelliteMap" model="new SatelliteMapViewModel { Scope = Agrumy.Shared.Models.SatelliteMapScope.Zone, Id = parcel.IDFarmParcelZone!.Value, OnlyReliableDefault = false, CanManage = canManage }" />
</div>

<div class="card mt-3">
    <div class="card-header d-flex align-items-center gap-2 flex-wrap">
        <h3 class="card-title mb-0">Satellite / soil-moisture trend</h3>
        <select class="form-select form-select-sm" style="width:auto" id="satSeriesIndex">
            <option value="1">Ndvi</option>
            <option value="2" selected>Ndmi</option>
            <option value="3">Ndwi</option>
            <option value="4">Ndsi</option>
        </select>
        <div class="form-check form-switch ms-auto mb-0">
            <input class="form-check-input" type="checkbox" id="satSeriesShowMoisture" checked>
            <label class="form-check-label small" for="satSeriesShowMoisture">Overlay soil moisture</label>
        </div>
    </div>
    <div class="card-body">
        <div id="satSeriesChart" style="height:280px;"></div>
        <p class="text-secondary small fst-italic mt-2" id="satSeriesEmpty" hidden>No satellite history yet for this zone.</p>
    </div>
</div>

<script src="~/lib/echarts/echarts.min.js"></script>
<script nonce="@Context.CspNonce()">
    document.addEventListener('DOMContentLoaded', function () {
        const chart = echarts.init(document.getElementById('satSeriesChart'));
        const select = document.getElementById('satSeriesIndex');
        const empty = document.getElementById('satSeriesEmpty');
        const showMoisture = document.getElementById('satSeriesShowMoisture');
        const idZone = @parcel.IDFarmParcelZone;

        // Pairs the satellite index with the zone's own device moisture readings on a second y-axis, aligned by day, instead of the satellite-only trend this chart shipped with.
        async function loadSeries() {
            const response = await fetch(`/FarmOpenfield/SatelliteSeries?idFarmParcelZone=${idZone}&index=${select.value}&onlyReliable=true`);
            const points = response.ok ? await response.json() : [];
            if (points.length === 0) {
                empty.hidden = false;
                chart.clear();
                return;
            }
            empty.hidden = true;
            const dates = points.map(p => p.sceneDateUtc);
            const indexName = select.options[select.selectedIndex].text;

            let moisturePoints = [];
            if (showMoisture.checked) {
                const moistureResponse = await fetch(`/FarmOpenfield/MoistureSeries?idFarmParcelZone=${idZone}&from=${dates[0]}&to=${dates[dates.length - 1]}`);
                moisturePoints = moistureResponse.ok ? await moistureResponse.json() : [];
            }

            const series = [{ type: 'line', name: indexName, yAxisIndex: 0, data: points.map(p => p.mean) }];
            const yAxis = [{ type: 'value', name: indexName }];
            if (moisturePoints.length > 0) {
                const moistureByDate = new Map(moisturePoints.map(p => [p.date, p.moisture]));
                series.push({ type: 'line', name: 'Soil moisture (%)', yAxisIndex: 1, connectNulls: true, data: dates.map(d => moistureByDate.get(d) ?? null) });
                yAxis.push({ type: 'value', name: 'Moisture %', min: 0, max: 100 });
            }

            // notMerge - toggling the moisture overlay changes the y-axis/series count, a merged setOption would leave a stale second axis behind.
            chart.setOption({
                tooltip: { trigger: 'axis' },
                legend: { show: series.length > 1 },
                xAxis: { type: 'category', data: dates },
                yAxis,
                series,
            }, true);
        }
        select.addEventListener('change', loadSeries);
        showMoisture.addEventListener('change', loadSeries);
        loadSeries();
    });
</script>

<div class="modal fade" id="registerDeviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RegisterDiscoveredDeviceParcel" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Register discovered device</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="DiscoveredApMac" id="registerApMac" />
                    <input type="hidden" name="ParcelID" value="@parcel.IDFarmParcelZone" />
                    <div class="mb-3">
                        <label class="form-label" for="registerDeviceName">Name (optional)</label>
                        <input type="text" name="DeviceName" id="registerDeviceName" class="form-control" maxlength="128" />
                    </div>
                    <partial name="_WifiConfigFields" model="Model.WifiConfigs" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@Context.CspNonce()">
        document.addEventListener('DOMContentLoaded', function () {
            var registerModal = document.getElementById('registerDeviceModal');
            if (registerModal)
            {
                registerModal.addEventListener('show.bs.modal', function (event) {
                    document.getElementById('registerApMac').value = event.relatedTarget.getAttribute('data-ap-mac');
                });
            }
        });
    </script>
}
