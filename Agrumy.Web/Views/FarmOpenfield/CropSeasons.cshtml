@model CropSeasonsIndexViewModel
@{
    ViewData["Title"] = "Crop";
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    bool canManage = hasAnyRole(RoleNames.DeviceManagers);
}

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

@if (canManage)
{
    @if (Model.Farms.Count == 0)
    {
        <p class="text-secondary">
            No Open-Field farms yet - create one from a <a asp-controller="FarmGroup" asp-action="Index">Farm Group</a> first.
        </p>
    }
    else if (Model.CatalogCrops.Count == 0)
    {
        <p class="text-secondary">
            No crops in the Horticulture Catalog yet - a Global Admin needs to add at least one (wheat/corn
            variety) before a new sowing can be started.
        </p>
    }
    else
    {
        <div class="sowing-add-wizard mb-4">
            <button type="button" class="btn btn-primary sowing-add-toggle"><i class="bi bi-plus-lg"></i> New sowing</button>
            <div class="card mt-2 sowing-add-form" hidden>
                <div class="card-header"><h3 class="card-title mb-0">New sowing</h3></div>
                <div class="card-body">
                    <form asp-action="CropAdd" method="post" class="row g-3">
                        @if (Model.Farms.Count > 1)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Farm</label>
                                <select name="idFarm" class="form-select sowing-farm-select" required>
                                    @foreach (var farm in Model.Farms)
                                    {
                                        <option value="@farm.IDDeviceFarm">@farm.DeviceFarmName</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="idFarm" value="@Model.Farms[0].IDDeviceFarm" />
                        }
                        <div class="col-md-4">
                            <label class="form-label">Crop / variety</label>
                            <select name="farmOpenfieldCropName" class="form-select" required>
                                @foreach (var crop in Model.CatalogCrops.OrderBy(c => c.Name))
                                {
                                    <option value="@crop.Name">@crop.Name@(string.IsNullOrEmpty(crop.ClassCode) ? "" : $" ({crop.ClassCode})")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Variety note (optional)</label>
                            <input type="text" name="variety" class="form-control" placeholder="e.g. own seed lot" maxlength="100" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Start date</label>
                            <input type="date" name="startDate" class="form-control" style="max-width:16rem" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Expected end date</label>
                            <input type="date" name="expectedEndDate" class="form-control" style="max-width:16rem" required />
                            <div class="form-text">An estimate, not a hard deadline - closing the sowing is a separate step whenever harvest actually happens.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Parcels for this sowing <span class="text-muted">(optional - pick individually and/or a saved group; leave empty to assign parcels later)</span></label>
                            @foreach (var farm in Model.Farms)
                            {
                                int idFarm = farm.IDDeviceFarm!.Value;
                                IList<FarmParcelWithZonesViewModel> farmParcels = Model.AvailableParcelsByFarm.TryGetValue(idFarm, out var fp) ? fp : [];
                                IList<FarmParcelGroupCrop> farmGroups = Model.ParcelGroupsByFarm.TryGetValue(idFarm, out var fg) ? fg : [];
                                <div class="sowing-farm-parcels row g-3" data-farm-id="@idFarm" hidden="@(Model.Farms.Count > 1 && idFarm != Model.Farms[0].IDDeviceFarm)">
                                    @if (farmParcels.Count == 0 && farmGroups.Count == 0)
                                    {
                                        <div class="col-12"><p class="text-secondary small fst-italic mb-0">No parcels on this farm yet.</p></div>
                                    }
                                    else
                                    {
                                        @if (farmGroups.Count > 0)
                                        {
                                            <div class="col-md-6">
                                                <div class="border rounded p-2" style="max-height:12rem;overflow-y:auto">
                                                    @foreach (var group in farmGroups)
                                                    {
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" name="farmParcelGroupCropIds" value="@group.IDFarmParcelGroupCrop" id="group-@group.IDFarmParcelGroupCrop" />
                                                            <label class="form-check-label" for="group-@group.IDFarmParcelGroupCrop">
                                                                @group.Name <span class="text-secondary small">(@group.MemberParcelIds.Count parcel(s))</span>
                                                            </label>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        <div class="col-md-6">
                                            <div class="border rounded p-2" style="max-height:12rem;overflow-y:auto">
                                                @foreach (var pz in farmParcels)
                                                {
                                                    <div class="mb-1">
                                                        <strong class="small">@pz.Parcel.FarmParcelName</strong>
                                                        @foreach (var z in pz.Zones)
                                                        {
                                                            bool locked = z.CurrentSowingID != null;
                                                            <div class="form-check form-check-inline @(locked ? "text-secondary" : "")">
                                                                <input class="form-check-input" type="checkbox" name="farmParcelZoneIds" value="@z.IDFarmParcelZone" id="wizard-zone-@z.IDFarmParcelZone" disabled="@locked" />
                                                                <label class="form-check-label" for="wizard-zone-@z.IDFarmParcelZone">
                                                                    @z.FarmParcelZoneName @(locked ? "(occupied)" : "")
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Start planning this sowing</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <script nonce="@Context.CspNonce()">
            (function () {
                var wizard = document.currentScript.previousElementSibling;
                var toggle = wizard.querySelector('.sowing-add-toggle');
                var form = wizard.querySelector('.sowing-add-form');
                toggle.addEventListener('click', function () { form.hidden = !form.hidden; });

                var farmSelect = wizard.querySelector('.sowing-farm-select');
                if (farmSelect) {
                    var blocks = wizard.querySelectorAll('.sowing-farm-parcels');
                    farmSelect.addEventListener('change', function () {
                        blocks.forEach(function (block) {
                            block.hidden = block.getAttribute('data-farm-id') !== farmSelect.value;
                        });
                    });
                }
            })();
        </script>
    }
}

@if (Model.Sowings.Count == 0)
{
    <p class="text-secondary">No crop seasons yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var s in Model.Sowings.OrderByDescending(s => s.StartDate))
        {
            string badge = s.Status switch
            {
                GrowingCycleStatus.Planned => "text-bg-secondary",
                GrowingCycleStatus.Active => "text-bg-success",
                _ => "text-bg-dark",
            };
            DeviceFarm? sowingFarm = Model.Farms.FirstOrDefault(f => f.IDDeviceFarm == s.FarmID);
            string? farmGroupName = sowingFarm?.FarmGroupID is int idGroup && Model.FarmGroupNames.TryGetValue(idGroup, out var fgName) ? fgName : null;
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                    <a asp-action="Parcels" asp-route-idSowing="@s.IDSowing">@s.SowingName</a>
                    @if (farmGroupName != null)
                    {
                        <span class="text-secondary small ms-2">@farmGroupName</span>
                    }
                </span>
                <span class="badge @badge">@s.Status</span>
            </li>
        }
    </ul>
}
