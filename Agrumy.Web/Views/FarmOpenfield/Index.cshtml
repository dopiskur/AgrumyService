@model FarmOpenfieldIndexViewModel
@{
    ViewData["Title"] = "Open-Field farming";
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    bool canManage = hasAnyRole(RoleNames.DeviceManagers);
}

<h1 class="h3 mb-3">Open-Field farming</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<p class="text-secondary">
    Farm register - Crop Seasons and the Parcels registry live on their own pages now, this is
    just the list of Open-Field farms.
</p>

@if (canManage)
{
    <form asp-controller="DeviceFarmUnit" asp-action="FarmOpenfieldAdd" method="post" class="d-flex gap-2 mb-3">
        <input type="text" name="deviceFarmName" class="form-control form-control-sm" placeholder="New Open-Field farm name" required maxlength="100" style="max-width:18rem" />
        <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add Farm</button>
    </form>
}

@if (Model.Farms.Count == 0)
{
    <p class="text-secondary">No Open-Field farms yet.</p>
}

@foreach (var farm in Model.Farms)
{
    <div class="card mb-3">
        <div class="card-body d-flex align-items-center gap-2">
            <h3 class="card-title mb-0">@farm.DeviceFarmName</h3>
            <a asp-action="FarmSatellite" asp-route-idFarm="@farm.IDDeviceFarm" class="btn btn-sm btn-outline-secondary ms-auto"><i class="bi bi-globe"></i> Satellite</a>
        </div>
    </div>
}
