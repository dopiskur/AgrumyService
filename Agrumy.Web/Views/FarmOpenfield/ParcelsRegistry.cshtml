@model ParcelsRegistryViewModel
@{
    ViewData["Title"] = "Parcels";
    Func<string, bool> hasAnyRole = csv => csv.Split(',').Any(User.IsInRole);
    bool canManage = hasAnyRole(RoleNames.DeviceManagers);
    Func<ParcelAreaSummaryViewModel, string, string> areaLine = (summary, label) =>
    {
        if (summary.TotalCount == 0)
        {
            return $"No {label} yet.";
        }
        string total = summary.TotalHectares.ToString("0.##");
        return summary.WithAreaCount == summary.TotalCount
            ? $"{total} ha across {summary.TotalCount} {label}"
            : $"{total} ha across {summary.WithAreaCount} of {summary.TotalCount} {label} ({summary.TotalCount - summary.WithAreaCount} with no area recorded yet)";
    };
}

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h6 class="card-title">Total area</h6>
        <p class="mb-1"><i class="bi bi-flower1 me-1"></i> Crop: @areaLine(Model.CropAreaSummary, "parcels")</p>
        <p class="mb-1"><i class="bi bi-apple me-1"></i> Fruit: no Fruit Plantation module yet.</p>
        <p class="mb-0"><i class="bi bi-house-door me-1"></i> Greenhouse: @areaLine(Model.GreenhouseAreaSummary, "units")</p>
    </div>
</div>

<h4>Crop</h4>
<p class="text-secondary">
    Every Open-Field parcel (and each of its zones, if split) with its readiness for the current season.
    A parcel starts a new season "Not ready" - confirm pre-season field prep (ploughing, discing,
    fertilizing...) is done, then toggle it to Ready.
</p>

@if (canManage)
{
    @if (Model.Farms.Count == 0)
    {
        <p class="text-secondary">
            No Open-Field farms yet - <a asp-controller="FarmGroup" asp-action="Index">add one</a> before adding a parcel.
        </p>
    }
    else
    {
        <form asp-action="FarmParcelAdd" method="post" class="d-flex gap-2 mb-3 flex-wrap">
            @if (Model.Farms.Count > 1)
            {
                <select name="idFarm" class="form-select form-select-sm" style="max-width:16rem" required>
                    @foreach (var farm in Model.Farms)
                    {
                        <option value="@farm.IdFarm">@farm.FarmName</option>
                    }
                </select>
            }
            else
            {
                <input type="hidden" name="idFarm" value="@Model.Farms[0].IdFarm" />
            }
            <input type="text" name="farmParcelName" class="form-control form-control-sm" placeholder="New parcel name" required maxlength="120" style="max-width:16rem" />
            <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add Parcel</button>
        </form>
    }
}

@if (canManage && Model.GroupSections.Any(s => s.Parcels.Count > 0))
{
    <div class="card mb-4">
        <div class="card-header"><h3 class="card-title mb-0">Parcel Groups</h3></div>
        <div class="card-body">
            <p class="text-secondary small">
                A named, reusable set of parcels within one farm - pick one from the "New sowing" wizard
                to start a sowing on the whole group in one step instead of picking zones individually
                each season.
            </p>
            @foreach (var farmSection in Model.GroupSections.Where(s => s.Parcels.Count > 0))
            {
                @foreach (var group in farmSection.Groups)
                {
                    <details class="mb-2">
                        <summary>
                            @group.Name <span class="text-secondary small">(@group.MemberParcelIds.Count parcel(s))</span>
                        </summary>
                        <div class="ps-3 pt-2">
                            @foreach (var parcel in farmSection.Parcels)
                            {
                                bool isMember = group.MemberParcelIds.Contains(parcel.IDFarmParcel!.Value);
                                <form asp-action="@(isMember ? "ParcelGroupRemoveMember" : "ParcelGroupAddMember")" method="post" class="d-inline">
                                    <input type="hidden" name="idFarmParcelGroupCrop" value="@group.IDFarmParcelGroupCrop" />
                                    <input type="hidden" name="idFarmParcel" value="@parcel.IDFarmParcel" />
                                    <button type="submit" class="btn btn-sm @(isMember ? "btn-outline-success" : "btn-outline-secondary") mb-1">
                                        <i class="bi @(isMember ? "bi-check-square" : "bi-square")"></i> @parcel.FarmParcelName
                                    </button>
                                </form>
                            }
                            <form asp-action="ParcelGroupDelete" method="post" class="d-inline ms-2">
                                <input type="hidden" name="idFarmParcelGroupCrop" value="@group.IDFarmParcelGroupCrop" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Delete this parcel group?"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </details>
                }
                <form asp-action="ParcelGroupAdd" method="post" class="d-flex gap-2 mb-3">
                    <input type="hidden" name="idFarm" value="@farmSection.IdFarm" />
                    <input type="text" name="name" class="form-control form-control-sm" placeholder="New group name" required maxlength="120" style="max-width:16rem" />
                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap"><i class="bi bi-plus-lg"></i> Add Parcel Group</button>
                </form>
            }
        </div>
    </div>
}

@if (Model.Rows.Count == 0)
{
    <p class="text-secondary">No parcels yet.</p>
}
else
{
    <div class="table-responsive">
        <table id="parcelsTable" class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Parcels</th>
                    <th>Status</th>
                    <th>Parcel</th>
                    <th>Boundary</th>
                    <th>Zone</th>
                    <th>Occupancy</th>
                    <th>Season readiness</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.Rows.GroupBy(r => r.Parcel.IDFarmParcel))
                {
                    var first = group.First();
                    int zoneCount = group.Count();
                    <tr>
                        <td>
                            @if (first.IdFarmGroup is int idGroup)
                            {
                                <a asp-controller="FarmGroup" asp-action="Details" asp-route-id="@idGroup">@first.FarmGroupName</a>
                            }
                            else
                            {
                                <span class="text-secondary">No farm groups defined</span>
                            }
                        </td>
                        <td>
                            @if (canManage && Model.AvailableFarmGroups.Count > 0)
                            {
                                <form asp-action="AssignFarmToGroup" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="idFarm" value="@first.IdFarm" />
                                    <select name="idFarmGroup" class="form-select form-select-sm" style="max-width:10rem" required>
                                        <option value="" selected="@(first.IdFarmGroup == null ? "selected" : null)" disabled>Choose group</option>
                                        @foreach (var g in Model.AvailableFarmGroups)
                                        {
                                            <option value="@g.IDFarmGroup" selected="@(g.IDFarmGroup == first.IdFarmGroup ? "selected" : null)">@g.Name</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">@(first.IdFarmGroup is int ? "Reassign" : "Assign")</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </td>
                        <td>@first.Parcel.FarmParcelName</td>
                        <td>
                            <a asp-action="FarmParcelDetails" asp-route-idFarmParcel="@first.Parcel.IDFarmParcel" title="Boundary and zone map">
                                <i class="bi bi-map"></i>
                                @if (first.Parcel.AreaHectares is double ha)
                                {
                                    <text>@ha.ToString("0.##") ha</text>
                                }
                                else
                                {
                                    <text>draw boundary</text>
                                }
                            </a>
                        </td>
                        <td>
                            @if (zoneCount > 1)
                            {
                                <a asp-action="FarmParcelDetails" asp-route-idFarmParcel="@first.Parcel.IDFarmParcel" title="View all zones for this parcel">@zoneCount</a>
                            }
                            else
                            {
                                @zoneCount
                            }
                        </td>
                        <td>
                            @if (first.Zone.CurrentSowingID != null)
                            {
                                <span class="badge text-bg-success">occupied</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">free</span>
                            }
                        </td>
                        <td>
                            @if (canManage)
                            {
                                <div class="form-check form-switch mb-0 d-inline-flex align-items-center gap-2">
                                    <input class="form-check-input parcel-ready-toggle" type="checkbox" role="switch"
                                           data-id-farm-parcel-zone="@first.Zone.IDFarmParcelZone"
                                           checked="@(first.Zone.ReadyForSeason ? "checked" : null)" />
                                    <span class="badge @(first.Zone.ReadyForSeason ? "text-bg-success" : "text-bg-danger") ready-badge">
                                        @(first.Zone.ReadyForSeason ? "Ready" : "Not ready")
                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="badge @(first.Zone.ReadyForSeason ? "text-bg-success" : "text-bg-danger")">
                                    @(first.Zone.ReadyForSeason ? "Ready" : "Not ready")
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h4 class="mt-4">Fruit</h4>
<p class="text-secondary fst-italic">Fruit Plantation module isn't built yet.</p>

<h4 class="mt-4">Greenhouse</h4>
@if (Model.GreenhouseRows.Count == 0)
{
    <p class="text-secondary">No Greenhouse units yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Farm Group</th>
                    <th>Unit</th>
                    <th>Area</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.GreenhouseRows)
                {
                    <tr>
                        <td>
                            @if (row.IdFarmGroup is int idGroup)
                            {
                                <a asp-controller="FarmGroup" asp-action="Details" asp-route-id="@idGroup">@row.FarmGroupName</a>
                            }
                            else if (row.IdFarm is not int idFarm)
                            {
                                <span class="text-secondary">—</span>
                            }
                            else if (!canManage)
                            {
                                <span class="text-secondary">Unassigned</span>
                            }
                            else if (Model.AvailableFarmGroups.Count == 0)
                            {
                                <span class="text-secondary small">No Farm Groups yet - <a asp-controller="FarmGroup" asp-action="Index">create one</a></span>
                            }
                            else
                            {
                                <form asp-action="AssignFarmToGroup" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="idFarm" value="@idFarm" />
                                    <select name="idFarmGroup" class="form-select form-select-sm" style="max-width:10rem" required>
                                        <option value="" selected disabled>Choose group</option>
                                        @foreach (var g in Model.AvailableFarmGroups)
                                        {
                                            <option value="@g.IDFarmGroup">@g.Name</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Assign</button>
                                </form>
                            }
                        </td>
                        <td>
                            <a asp-controller="DeviceFarmUnit" asp-action="Zones" asp-route-idDeviceFarmUnit="@row.Unit.IDDeviceFarmUnit">@row.Unit.DeviceFarmUnitName</a>
                        </td>
                        <td>
                            @if (row.Unit.AreaHectares is double ha)
                            {
                                @(ha.ToString("0.##") + " ha")
                            }
                            else
                            {
                                <span class="text-secondary">not set</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<form id="antiForgeryHolder">@Html.AntiForgeryToken()</form>

<div class="modal fade" id="readyForSeasonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Mark as ready</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Do you wish to populate preparation dates (ploughing, discing, fertilizing...) first?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="readyForSeasonSkip">Skip</button>
                <button type="button" class="btn btn-primary" id="readyForSeasonYes">Yes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_DataTableScripts" model="@("parcelsTable")" />
    <script src="~/js/parcel-registry.js"></script>
    <script nonce="@Context.CspNonce()">
        document.addEventListener('DOMContentLoaded', function () {
            initParcelReadyToggles({
                setUrl: '@Url.Action("ParcelReadyForSeasonSet")',
                parcelDetailsUrlTemplate: '@Url.Action("Parcel", new { idFarmParcelZone = "__ID__" })',
                antiForgeryToken: document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '',
            });
        });
    </script>
}
