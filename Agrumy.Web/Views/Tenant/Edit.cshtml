@model Agrumy.Shared.Models.Tenant
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Edit Tenant</h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="IDTenant" class="form-label"></label>
                <p class="form-control-plaintext">@Html.DisplayFor(m => m.IDTenant)</p>
                @Html.HiddenFor(m => m.IDTenant)
            </div>
            <div class="mb-3">
                <label asp-for="TenantName" class="form-label"></label>
                <input asp-for="TenantName" class="form-control" required />
                <span asp-validation-for="TenantName" class="text-danger"></span>
            </div>

            <div class="mb-3" style="max-width:24rem">
                <label asp-for="ScheduleTimeZone" class="form-label"></label>
                <select asp-for="ScheduleTimeZone" asp-items="(IEnumerable<SelectListItem>)ViewBag.TimeZones" class="form-select"></select>
                <span asp-validation-for="ScheduleTimeZone" class="text-danger"></span>
                <div class="form-text">
                    Local wall-clock zone this tenant's schedule-mode relay windows (Device &rarr;
                    Controller &rarr; Schedules) are evaluated against. Not set = windows evaluate as
                    UTC.
                </div>
            </div>

            <div class="mb-0 row" style="max-width:24rem">
                <div class="col">
                    <label asp-for="Latitude" class="form-label"></label>
                    <input asp-for="Latitude" type="number" step="any" min="-90" max="90" class="form-control" />
                    <span asp-validation-for="Latitude" class="text-danger"></span>
                </div>
                <div class="col">
                    <label asp-for="Longitude" class="form-label"></label>
                    <input asp-for="Longitude" type="number" step="any" min="-180" max="180" class="form-control" />
                    <span asp-validation-for="Longitude" class="text-danger"></span>
                </div>
                <div class="form-text">
                    This tenant's own site location for astronomical (sunrise/sunset) schedule
                    conditions, and for its rain-skip/frost forecast below. Leave both blank to use
                    the server-wide default (Server Settings &rarr; Weather).
                </div>
            </div>

            @{ var weatherState = (Agrumy.Shared.Models.TenantWeatherState)ViewBag.WeatherState; }
            <div class="mb-3">
                <p class="mb-1">
                    <strong>Rain forecast:</strong>
                    @if (weatherState.WeatherCheckedAtUtc is DateTimeOffset weatherCheckedAt)
                    {
                        <span class="badge @(weatherState.WeatherRainPredicted ? "text-bg-info" : "text-bg-secondary")">
                            @(weatherState.WeatherRainPredicted ? "Rain predicted" : "No rain predicted")
                        </span>
                        <span class="text-secondary small">last checked @weatherCheckedAt.ToString("u")</span>
                    }
                    else
                    {
                        <span class="text-secondary small">not checked yet</span>
                    }
                </p>
                <p class="mb-0">
                    <strong>Frost forecast:</strong>
                    @if (weatherState.FrostCheckedAtUtc is DateTimeOffset frostCheckedAt)
                    {
                        <span class="badge @(weatherState.FrostPredicted ? "text-bg-danger" : "text-bg-secondary")">
                            @(weatherState.FrostPredicted ? $"Frost predicted (~{weatherState.FrostPredictedHoursAhead}h)" : "No frost predicted")
                        </span>
                        <span class="text-secondary small">last checked @frostCheckedAt.ToString("u")</span>
                    }
                    else
                    {
                        <span class="text-secondary small">not checked yet</span>
                    }
                </p>
            </div>

            <div class="mb-3" style="max-width:12rem">
                <label asp-for="RecycleBinRetentionDays" class="form-label"></label>
                <input asp-for="RecycleBinRetentionDays" class="form-control" />
                <span asp-validation-for="RecycleBinRetentionDays" class="text-danger"></span>
                <div class="form-text">
                    How many days a deleted Farm/Device stays restorable in this tenant's Recycle
                    Bin before it's marked for permanent removal. Leave blank to use the
                    server-wide default (Server Settings &rarr; Recycle Bin). Ignored while a
                    Quota governs this tenant (Tenants list &rarr; Configure limits) - the
                    quota's own Recycle Bin period applies instead.
                </div>
            </div>

            <div class="mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
