@model IEnumerable<Agrumy.Shared.Models.Tenant>

@{
    ViewData["Title"] = "Tenants";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Tenants</h3>
        @if (User.IsInRole(RoleNames.GlobalAdmin))
        {
            <div class="card-tools">
                <a asp-action="Import" class="btn btn-sm btn-secondary">Import</a>
                <a asp-action="Create" class="btn btn-sm btn-info">Create New</a>
            </div>
        }
    </div>
    <div class="card-body table-responsive p-0">
        <table id="tenantsTable" class="table table-hover">
            <thead>
                <tr>
                    <th class="d-none d-md-table-cell">
                        @Html.DisplayNameFor(model => model.IDTenant)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TenantName)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="d-none d-md-table-cell">
                        @Html.DisplayFor(modelItem => item.IDTenant)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TenantName)
                    </td>
                    <td>
                        @if (User.IsInRole(RoleNames.GlobalAdmin))
                        {
                            <div class="d-flex align-items-center gap-1">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Tenant actions">
                                    <a asp-action="Edit" asp-route-idTenant="@item.IDTenant" class="btn btn-primary" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                                    @if (item.IDTenant != 0)
                                    {
                                        <a asp-action="Quota" asp-route-idTenant="@item.IDTenant" class="btn btn-outline-primary" title="Configure limits" aria-label="Configure limits"><i class="bi bi-speedometer2"></i></a>
                                    }
                                    <button type="submit" form="export-form-@item.IDTenant" class="btn btn-outline-secondary" title="Export" aria-label="Export"><i class="bi bi-download"></i></button>
                                    @if (item.IDTenant != 0)
                                    {
                                        <a asp-action="Delete" asp-route-idTenant="@item.IDTenant" class="btn btn-danger" title="Delete" aria-label="Delete"><i class="bi bi-trash"></i></a>
                                    }
                                </div>
                                <form id="export-form-@item.IDTenant" asp-action="Export" method="get" class="d-flex align-items-center">
                                    <input type="hidden" name="idTenant" value="@item.IDTenant" />
                                    <div class="form-check form-check-inline m-0" title="Include this tenant's full sensor data history in the export - can be large and slow for a long-running installation">
                                        <input class="form-check-input" type="checkbox" name="includeSensorData" value="true" id="includeSensorData-@item.IDTenant" />
                                        <label class="form-check-label small text-muted" for="includeSensorData-@item.IDTenant">+ sensor data</label>
                                    </div>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_DataTableScripts" model="@("tenantsTable")" />
}
