@model IList<api.Models.SimulationSession>

@{
    ViewData["Title"] = "Simulations";
}

<h1>Simulations</h1>
<p class="text-muted">
    "Add Simulation" first, then add existing (physical) or new virtual devices into it - all
    simulation controls now live here, not on individual device pages. Every session has a hard
    48-hour cutoff: past that, any physical device in it automatically returns to its real
    sensor readings even if nobody stops the session manually.
</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

@* Name only here; duration is chosen when the session is actually started, inside its own Details page. *@
<form asp-action="Create" method="post" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label" for="simName">Name</label>
        <input type="text" id="simName" name="name" class="form-control" required maxlength="128" placeholder="e.g. Irrigation rule test" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Add Simulation</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Started</th>
            <th>Expires</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var session in Model)
        {
            // A session with no StartedAtUtc yet was only just created, never started.
            bool notStarted = session.StartedAtUtc == null;
            bool running = !notStarted && session.StoppedAtUtc == null && session.ExpiresAtUtc > DateTimeOffset.UtcNow;
            <tr>
                <td><a asp-action="Details" asp-route-idSimulationSession="@session.IDSimulationSession">@session.Name</a></td>
                <td>@(session.StartedAtUtc?.ToString("u") ?? "-")</td>
                <td>@(session.ExpiresAtUtc?.ToString("u") ?? "-")</td>
                <td>
                    @if (notStarted)
                    {
                        <span class="badge text-bg-info">Not started</span>
                    }
                    else if (running)
                    {
                        <span class="badge text-bg-success">Running</span>
                    }
                    else if (session.StoppedAtUtc != null)
                    {
                        <span class="badge text-bg-secondary">Stopped</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Expired</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-idSimulationSession="@session.IDSimulationSession" class="btn btn-outline-secondary btn-sm">Open</a>
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete simulation \'@session.Name\'? Any member physical device returns to its real readings immediately. This cannot be undone.');">
                        <input type="hidden" name="idSimulationSession" value="@session.IDSimulationSession" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-muted">No simulations yet.</td></tr>
        }
    </tbody>
</table>
