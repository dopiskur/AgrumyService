@model IList<api.Models.SimulationSession>

@{
    ViewData["Title"] = "Simulations";
}

<h1>Simulations</h1>
<p class="text-muted">
    "Add Simulation" first, then add existing (physical) or new virtual devices into it - all
    simulation controls now live here, not on individual device pages. Every session has a hard
    48-hour cutoff: past that, any physical device in it automatically returns to its real
    sensor readings even if nobody stops the session manually.
</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}

<form asp-action="Create" method="post" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label" for="simName">Name</label>
        <input type="text" id="simName" name="name" class="form-control" required maxlength="128" placeholder="e.g. Irrigation rule test" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="simDurationPreset">Duration</label>
        <select id="simDurationPreset" class="form-select" onchange="document.getElementById('simDurationMinutes').value = this.value === 'custom' ? '' : this.value; document.getElementById('simCustomDurationWrap').style.display = this.value === 'custom' ? 'block' : 'none';">
            <option value="5">5 minutes</option>
            <option value="15">15 minutes</option>
            <option value="30">30 minutes</option>
            <option value="60">1 hour</option>
            <option value="360">6 hours</option>
            <option value="720">12 hours</option>
            <option value="1440" selected>24 hours</option>
            <option value="2880">48 hours (maximum)</option>
            <option value="custom">Custom...</option>
        </select>
    </div>
    <div class="col-auto" id="simCustomDurationWrap" style="display:none">
        <label class="form-label" for="simDurationMinutesInput">Custom minutes</label>
        <input type="number" id="simDurationMinutesInput" class="form-control" min="1" max="2880"
               oninput="document.getElementById('simDurationMinutes').value = this.value" />
    </div>
    <input type="hidden" id="simDurationMinutes" name="durationMinutes" value="1440" />
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Add Simulation</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Started</th>
            <th>Expires</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var session in Model)
        {
            bool ended = session.StoppedAtUtc != null || session.ExpiresAtUtc <= DateTimeOffset.UtcNow;
            <tr>
                <td><a asp-action="Details" asp-route-idSimulationSession="@session.IDSimulationSession">@session.Name</a></td>
                <td>@session.StartedAtUtc.ToString("u")</td>
                <td>@session.ExpiresAtUtc.ToString("u")</td>
                <td>
                    @if (!ended)
                    {
                        <span class="badge text-bg-success">Running</span>
                    }
                    else if (session.StoppedAtUtc != null)
                    {
                        <span class="badge text-bg-secondary">Stopped</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Expired</span>
                    }
                </td>
                <td><a asp-action="Details" asp-route-idSimulationSession="@session.IDSimulationSession" class="btn btn-outline-secondary btn-sm">Open</a></td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-muted">No simulations yet.</td></tr>
        }
    </tbody>
</table>
