@model Agrumy.Shared.Models.SimulationSession
@using Agrumy.Shared.Models

@{
    ViewData["Title"] = Model.Name;
    // A session with no StartedAtUtc yet was only just created, never started; Stopped/expired are both "not currently running" but past a real start, so the form below reads "Resume" instead of "Start".
    bool notStarted = Model.StartedAtUtc == null;
    bool running = !notStarted && Model.StoppedAtUtc == null && Model.ExpiresAtUtc > DateTimeOffset.UtcNow;
    bool everStarted = Model.StartedAtUtc != null;
    var fleet = (IList<DeviceFleetStatus>)ViewBag.Fleet;
    var memberIds = Model.Devices.Select(d => d.IDDevice).ToHashSet();
    var candidates = fleet.Where(f => !memberIds.Contains(f.IDDevice)).ToList();
    var virtualCandidates = candidates.Where(f => f.IsVirtual).ToList();
    var physicalCandidates = candidates.Where(f => !f.IsVirtual).ToList();
    var ruleEditorModel = new Agrumy.Web.ViewModels.RuleEditorViewModel
    {
        Scope = Agrumy.Web.ViewModels.RuleScope.Simulation,
        ScopeId = Model.IDSimulationSession,
        Rules = (IList<DeviceFarmUnitZoneRule>)ViewBag.Rules,
        RedirectActionName = "Details",
    };
    var groups = (IList<SimulationGroup>)ViewBag.Groups;
    var units = (IList<DeviceFarmUnit>)ViewBag.Units;
    var zones = (IList<DeviceFarmUnitZone>)ViewBag.Zones;
    var arables = (IList<Sowing>)ViewBag.Arables;
    var parcels = (IList<FarmParcelZone>)ViewBag.Parcels;
    bool isReadOnly = ViewBag.IsReadOnly is true;

    // One number input per overridable metric, blank = no override for that metric - same 13 fields DeviceSimulation itself has, just without the per-device slider (a group covers several devices at once, a single slider position wouldn't mean the same thing for all of them).
    Microsoft.AspNetCore.Html.IHtmlContent GroupMetricField(string name, string label, string unit, (double Min, double Max) range, double? current = null, string formId = "groupAddForm")
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"""
        <div class="col-auto">
            <label class="form-label small mb-0">{label} <span class="text-secondary">({unit})</span></label>
            <input type="number" step="any" min="{range.Min}" max="{range.Max}" name="{name}" form="{formId}" class="form-control form-control-sm" style="width:8rem" value="{current}" placeholder="off" />
        </div>
        """);
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

<h1>@Model.Name</h1>
<p class="text-muted">
    @if (notStarted)
    {
        <text>Not started yet.</text>
    }
    else
    {
        <text>Started @Model.StartedAtUtc!.Value.ToString("u"), expires @Model.ExpiresAtUtc!.Value.ToString("u")</text>
        @if (Model.StoppedAtUtc != null)
        {
            <text> - stopped @Model.StoppedAtUtc.Value.ToString("u")</text>
        }
    }
</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning">@error</div>
}
@if (TempData["Info"] is string info)
{
    <div class="alert alert-info">@info</div>
}

@if (!isReadOnly)
{
if (running)
{
    <form asp-action="Stop" method="post" class="mb-3" data-confirm="Stop this simulation now? Every member device returns to its real readings immediately.">
        <input type="hidden" name="idSimulationSession" value="@Model.IDSimulationSession" />
        <button type="submit" class="btn btn-outline-danger" data-action="stop">Stop simulation</button>
    </form>
}
else
{
    <form asp-action="Start" method="post" class="row g-2 align-items-end mb-3">
        <input type="hidden" name="idSimulationSession" value="@Model.IDSimulationSession" />
        <div class="col-auto">
            <label class="form-label" for="simDurationPreset">Duration</label>
            <select id="simDurationPreset" class="form-select">
                <option value="5">5 minutes</option>
                <option value="15">15 minutes</option>
                <option value="30">30 minutes</option>
                <option value="60">1 hour</option>
                <option value="360">6 hours</option>
                <option value="720">12 hours</option>
                <option value="1440" selected>24 hours</option>
                <option value="2880">48 hours (maximum)</option>
                <option value="custom">Custom...</option>
            </select>
        </div>
        <div class="col-auto" id="simCustomDurationWrap" style="display:none">
            <label class="form-label" for="simDurationMinutesInput">Custom minutes</label>
            <input type="number" id="simDurationMinutesInput" class="form-control" min="1" max="2880" />
        </div>
        <input type="hidden" id="simDurationMinutes" name="durationMinutes" value="1440" />
        <div class="col-auto">
            <button type="submit" class="btn btn-primary" data-action="start">@(everStarted ? "Resume simulation" : "Start simulation")</button>
        </div>
    </form>
}
}

<h4>Devices in this simulation</h4>
<table class="table">
    <thead>
        <tr>
            <th>Device</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var device in Model.Devices)
        {
            <tr>
                <td><a asp-controller="Device" asp-action="Details" asp-route-idDevice="@device.IDDevice">@device.DeviceName</a></td>
                <td>
                    <a asp-controller="Device" asp-action="Simulation" asp-route-idDevice="@device.IDDevice" asp-route-idSimulationSession="@Model.IDSimulationSession" class="btn btn-outline-primary btn-sm">Configure overrides</a>
                    @if (!isReadOnly)
                    {
                        <form asp-action="RemoveDevice" method="post" class="d-inline">
                            <input type="hidden" name="idSimulationSession" value="@Model.IDSimulationSession" />
                            <input type="hidden" name="idDevice" value="@device.IDDevice" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm" data-action="delete">Remove</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Devices.Count == 0)
        {
            <tr><td colspan="2" class="text-muted">No devices yet.</td></tr>
        }
    </tbody>
</table>

<h4 class="mt-4">Whole Units/Zones in this simulation</h4>
<p class="text-secondary small">
    One override value set fanned out to every device that belonged to the Unit/Zone at the moment
    it was added - a bulk alternative to adding devices one at a time below. A device added to the
    Unit/Zone afterward is not swept in automatically; add it individually if you need it too.
</p>
<table class="table">
    <thead>
        <tr>
            <th>Scope</th>
            <th>Devices</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in groups)
        {
            string editFormId = $"groupEditForm{g.IDSimulationGroup}";
            <tr>
                <td>@g.Scope: @g.ScopeName</td>
                <td>@g.MemberDeviceCount</td>
                <td>
                    @if (!isReadOnly)
                    {
                    <details class="d-inline">
                        <summary class="btn btn-outline-primary btn-sm" style="cursor:pointer;display:inline-block;">Edit values</summary>
                        <form id="@editFormId" asp-action="SessionGroupUpdate" method="post" class="row g-2 align-items-end mt-2 p-2 border rounded">
                            <input type="hidden" name="idSimulationSession" value="@Model.IDSimulationSession" form="@editFormId" />
                            <input type="hidden" name="idGroup" value="@g.IDSimulationGroup" form="@editFormId" />
                        </form>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @GroupMetricField("Temperature", "Temperature", "&deg;C", SimulationMetricRange.Temperature, g.Temperature, editFormId)
                            @GroupMetricField("SoilTemperature", "Soil temp", "&deg;C", SimulationMetricRange.SoilTemperature, g.SoilTemperature, editFormId)
                            @GroupMetricField("Humidity", "Humidity", "%", SimulationMetricRange.Humidity, g.Humidity, editFormId)
                            @GroupMetricField("Battery", "Battery", "%", SimulationMetricRange.Battery, g.Battery, editFormId)
                            @GroupMetricField("Moisture", "Moisture", "%", SimulationMetricRange.Moisture, g.Moisture, editFormId)
                            @GroupMetricField("Light", "Light", "lux", SimulationMetricRange.Light, g.Light, editFormId)
                            @GroupMetricField("Co2", "CO2", "ppm", SimulationMetricRange.Co2, g.Co2, editFormId)
                            @GroupMetricField("Tvoc", "TVOC", "ppb", SimulationMetricRange.Tvoc, g.Tvoc, editFormId)
                            @GroupMetricField("Barometer", "Barometer", "Pa", SimulationMetricRange.Barometer, g.Barometer, editFormId)
                            @GroupMetricField("LiquidPH", "Liquid pH", "pH", SimulationMetricRange.LiquidPH, g.LiquidPH, editFormId)
                            @GroupMetricField("RainLevel", "Rain level", "", SimulationMetricRange.RainLevel, g.RainLevel, editFormId)
                            @GroupMetricField("WaterLevel", "Water level", "", SimulationMetricRange.WaterLevel, g.WaterLevel, editFormId)
                            @GroupMetricField("Wind", "Wind", "", SimulationMetricRange.Wind, g.Wind, editFormId)
                            <div class="col-auto">
                                <button type="submit" form="@editFormId" class="btn btn-sm btn-primary">Save</button>
                            </div>
                        </div>
                    </details>
                    <form asp-action="SessionGroupDelete" method="post" class="d-inline" data-confirm="Remove this group? Every member device it added returns to its real readings.">
                        <input type="hidden" name="idSimulationSession" value="@Model.IDSimulationSession" />
                        <input type="hidden" name="idGroup" value="@g.IDSimulationGroup" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm" data-action="delete">Remove</button>
                    </form>
                    }
                </td>
            </tr>
        }
        @if (groups.Count == 0)
        {
            <tr><td colspan="3" class="text-muted">No whole Units/Zones added yet.</td></tr>
        }
    </tbody>
</table>

@if (!isReadOnly)
{
<details class="mb-3">
    <summary class="btn btn-outline-primary btn-sm" style="cursor:pointer;display:inline-block;">+ Add whole Unit/Zone</summary>
    <form id="groupAddForm" asp-action="SessionGroupAdd" method="post" class="mt-2 p-2 border rounded">
        <input type="hidden" name="idSimulationSession" value="@Model.IDSimulationSession" />
    </form>
    <div class="row g-2 align-items-end mt-2">
        <div class="col-auto">
            <label class="form-label small mb-0">Scope</label>
            <select name="Scope" form="groupAddForm" id="groupScopeSelect" class="form-select form-select-sm">
                <option value="@((int)HierarchyNodeKind.Unit)">Whole Unit</option>
                <option value="@((int)HierarchyNodeKind.Zone)" selected>Whole Zone</option>
                <option value="@((int)HierarchyNodeKind.Sowing)">Whole Arable</option>
                <option value="@((int)HierarchyNodeKind.FarmParcelZone)">Whole Parcel</option>
            </select>
        </div>
        <div class="col-auto" id="groupUnitTargetWrap" style="display:none">
            <label class="form-label small mb-0">Unit</label>
            <select name="ScopeID" form="groupAddForm" id="groupUnitTargetSelect" class="form-select form-select-sm" disabled>
                @foreach (var u in units)
                {
                    <option value="@u.IDDeviceFarmUnit">@u.DeviceFarmUnitName</option>
                }
            </select>
        </div>
        <div class="col-auto" id="groupZoneTargetWrap">
            <label class="form-label small mb-0">Zone</label>
            <select name="ScopeID" form="groupAddForm" id="groupZoneTargetSelect" class="form-select form-select-sm">
                @foreach (var z in zones)
                {
                    <option value="@z.IDDeviceFarmUnitZone">@z.DeviceFarmUnitZoneName</option>
                }
            </select>
        </div>
        <div class="col-auto" id="groupArableTargetWrap" style="display:none">
            <label class="form-label small mb-0">Arable</label>
            <select name="ScopeID" form="groupAddForm" id="groupArableTargetSelect" class="form-select form-select-sm" disabled>
                @foreach (var c in arables)
                {
                    <option value="@c.IDSowing">@c.SowingName</option>
                }
            </select>
        </div>
        <div class="col-auto" id="groupParcelTargetWrap" style="display:none">
            <label class="form-label small mb-0">Parcel</label>
            <select name="ScopeID" form="groupAddForm" id="groupParcelTargetSelect" class="form-select form-select-sm" disabled>
                @foreach (var p in parcels)
                {
                    <option value="@p.IDFarmParcelZone">@p.FarmParcelZoneName</option>
                }
            </select>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-2">
        @GroupMetricField("Temperature", "Temperature", "&deg;C", SimulationMetricRange.Temperature)
        @GroupMetricField("SoilTemperature", "Soil temp", "&deg;C", SimulationMetricRange.SoilTemperature)
        @GroupMetricField("Humidity", "Humidity", "%", SimulationMetricRange.Humidity)
        @GroupMetricField("Battery", "Battery", "%", SimulationMetricRange.Battery)
        @GroupMetricField("Moisture", "Moisture", "%", SimulationMetricRange.Moisture)
        @GroupMetricField("Light", "Light", "lux", SimulationMetricRange.Light)
        @GroupMetricField("Co2", "CO2", "ppm", SimulationMetricRange.Co2)
        @GroupMetricField("Tvoc", "TVOC", "ppb", SimulationMetricRange.Tvoc)
        @GroupMetricField("Barometer", "Barometer", "Pa", SimulationMetricRange.Barometer)
        @GroupMetricField("LiquidPH", "Liquid pH", "pH", SimulationMetricRange.LiquidPH)
        @GroupMetricField("RainLevel", "Rain level", "", SimulationMetricRange.RainLevel)
        @GroupMetricField("WaterLevel", "Water level", "", SimulationMetricRange.WaterLevel)
        @GroupMetricField("Wind", "Wind", "", SimulationMetricRange.Wind)
        <div class="col-auto">
            <button type="submit" form="groupAddForm" class="btn btn-sm btn-primary" data-action="add">Add to simulation</button>
        </div>
    </div>
</details>
}

<script nonce="@Context.CspNonce()">
    (function () {
        var scopeSelect = document.getElementById('groupScopeSelect');
        if (!scopeSelect) { return; }
        var groups = {};
        groups['@((int)HierarchyNodeKind.Unit)'] = { wrap: document.getElementById('groupUnitTargetWrap'), select: document.getElementById('groupUnitTargetSelect') };
        groups['@((int)HierarchyNodeKind.Zone)'] = { wrap: document.getElementById('groupZoneTargetWrap'), select: document.getElementById('groupZoneTargetSelect') };
        groups['@((int)HierarchyNodeKind.Sowing)'] = { wrap: document.getElementById('groupArableTargetWrap'), select: document.getElementById('groupArableTargetSelect') };
        groups['@((int)HierarchyNodeKind.FarmParcelZone)'] = { wrap: document.getElementById('groupParcelTargetWrap'), select: document.getElementById('groupParcelTargetSelect') };
        function updateVisibility() {
            Object.keys(groups).forEach(function (key) {
                var isActive = key === scopeSelect.value;
                groups[key].wrap.style.display = isActive ? '' : 'none';
                groups[key].select.disabled = !isActive;
            });
        }
        scopeSelect.addEventListener('change', updateVisibility);
        updateVisibility();
    })();
    (function () {
        var preset = document.getElementById('simDurationPreset');
        var minutes = document.getElementById('simDurationMinutes');
        var customWrap = document.getElementById('simCustomDurationWrap');
        var customInput = document.getElementById('simDurationMinutesInput');
        if (!preset) { return; }
        preset.addEventListener('change', function () {
            var isCustom = preset.value === 'custom';
            minutes.value = isCustom ? '' : preset.value;
            customWrap.style.display = isCustom ? 'block' : 'none';
        });
        customInput.addEventListener('input', function () {
            minutes.value = customInput.value;
        });
    })();
</script>

@* Devices can be added/removed regardless of running/stopped/not-started state. Virtual devices persist independently of any one session now - "Add virtual device" offers reusing an existing one alongside creating a fresh one, same as how a physical device is only ever picked from the existing fleet. *@
@if (!isReadOnly)
{
<div class="mb-3 d-flex gap-2">
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addVirtualDeviceModal">Add virtual device</button>
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addPhysicalDeviceModal">Add physical device</button>
</div>
}

<div class="modal fade" id="addVirtualDeviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add virtual device</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="CreateVirtualDevice" method="post" class="mb-3">
                    <input type="hidden" name="idSimulationSession" value="@Model.IDSimulationSession" />
                    <button type="submit" class="btn btn-outline-primary" disabled="@isReadOnly" data-action="add">Add new virtual device</button>
                </form>
                <hr />
                <form asp-action="AddDevice" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="idSimulationSession" value="@Model.IDSimulationSession" />
                    <div class="col-auto">
                        <label class="form-label" for="addVirtualDeviceSelect">Or reuse an existing one</label>
                        <select name="idDevice" id="addVirtualDeviceSelect" class="form-select" required disabled="@(virtualCandidates.Count == 0)">
                            @if (virtualCandidates.Count == 0)
                            {
                                <option value="">No existing virtual devices available</option>
                            }
                            else
                            {
                                <option value="">Choose an existing virtual device...</option>
                                @foreach (var candidate in virtualCandidates)
                                {
                                    <option value="@candidate.IDDevice">@candidate.DeviceName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary" disabled="@(isReadOnly || virtualCandidates.Count == 0)" data-action="add">Add to simulation</button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addPhysicalDeviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add physical device</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="AddDevice" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="idSimulationSession" value="@Model.IDSimulationSession" />
                    <div class="col-auto">
                        <select name="idDevice" class="form-select" required disabled="@(physicalCandidates.Count == 0)">
                            @if (physicalCandidates.Count == 0)
                            {
                                <option value="">No existing physical devices available</option>
                            }
                            else
                            {
                                <option value="">Choose an existing device...</option>
                                @foreach (var candidate in physicalCandidates)
                                {
                                    <option value="@candidate.IDDevice">@candidate.DeviceName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary" disabled="@(isReadOnly || physicalCandidates.Count == 0)" data-action="add">Add to simulation</button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-4">Simulation-scoped rules</h4>
<p class="text-secondary small">
    Evaluated ahead of a member device's real Zone/Unit/Farm/Global rules while this session is
    active, falling back to that real hierarchy for anything not covered here - lets you test rule
    logic against this session's simulated readings without it silently doing nothing, or (for
    whatever you don't override here) still reaching a real notification/relay outside the simulation.
</p>
@if (running)
{
    <div class="alert alert-warning">
        <strong>Simulation Mode: safety rules suspended.</strong> For any relay function you add a rule for
        below, the real hierarchy's safety rule (e.g. frost-guard) does NOT OR in alongside it while this
        session is running - on purpose, so you can actually test whether that safety rule fires (e.g.
        simulate cold and check heating turns on), instead of it silently masking the result.
    </div>
}
<partial name="_RuleEditor" model="ruleEditorModel" />

<a asp-action="Index" class="btn btn-link mt-3">Back to simulations</a>
