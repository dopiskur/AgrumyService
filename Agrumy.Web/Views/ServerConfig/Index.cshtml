@model Agrumy.Shared.Models.ServerConfig

@{
    ViewData["Title"] = "Server Settings";
    bool isReadOnly = ViewBag.IsReadOnly is true;
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Server Settings</h3>
    </div>
    <div class="card-body">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <fieldset disabled="@isReadOnly">
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-health" type="button" role="tab">Server Health</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-device-defaults" type="button" role="tab">Device Defaults</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-accounts" type="button" role="tab">Accounts</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-database" type="button" role="tab">Database</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-weather" type="button" role="tab">Weather</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-gateway" type="button" role="tab">Gateway</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-mqtt" type="button" role="tab">MQTT Transport</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-email" type="button" role="tab">Email</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-webhook" type="button" role="tab">Webhook</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-odata" type="button" role="tab">Power BI</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-arkod" type="button" role="tab">ARKOD</button>
                </li>
            </ul>
            <div class="tab-content border border-top-0 rounded-bottom p-3 mb-3">
                <div class="tab-pane fade show active" id="tab-health" role="tabpanel">
                    <p class="text-secondary">
                        Passive connectivity status for external dependencies currently enabled in the tabs below - refreshes automatically every 30s.
                    </p>
                    <div id="serverHealthContainer">
                        @await Html.PartialAsync("_ServerHealth", (IReadOnlyList<ServerHealthEntry>)ViewBag.ServerHealth)
                    </div>
                </div>

                    <div class="tab-pane fade" id="tab-device-defaults" role="tabpanel">
                    <form asp-action="SaveDeviceDefaults">
                    <h6 class="fw-semibold">Config heartbeat</h6>
                    <div class="mb-0" style="max-width:16rem">
                        <label asp-for="ConfigHeartbeatHours" class="form-label"></label>
                        <input asp-for="ConfigHeartbeatHours" class="form-control" />
                        <span asp-validation-for="ConfigHeartbeatHours" class="text-danger"></span>
                        <div class="form-text">
                            Resends a device's full config even when its ConfigVersion hasn't changed, so a
                            DST transition, a timezone edit, or a rain-skip flip still reaches it - 0 disables
                            this and relies on ConfigVersion alone.
                        </div>
                    </div>
                    <hr />
                    <h6 class="fw-semibold">Relay hysteresis</h6>
                    <p class="text-secondary">
                        Dead-zone defaults a newly-added device's Controller config is seeded with.
                        Changing these has no effect on devices that already exist -
                        edit those individually under Device &rarr; Controller.
                    </p>
                    <div class="mb-3">
                        <label asp-for="WaterLevelHysteresis" class="form-label"></label>
                        <input asp-for="WaterLevelHysteresis" class="form-control" />
                        <span asp-validation-for="WaterLevelHysteresis" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TemperatureHysteresis" class="form-label"></label>
                        <input asp-for="TemperatureHysteresis" class="form-control" />
                        <span asp-validation-for="TemperatureHysteresis" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="HumidityHysteresis" class="form-label"></label>
                        <input asp-for="HumidityHysteresis" class="form-control" />
                        <span asp-validation-for="HumidityHysteresis" class="text-danger"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="LightHysteresis" class="form-label"></label>
                        <input asp-for="LightHysteresis" class="form-control" />
                        <span asp-validation-for="LightHysteresis" class="text-danger"></span>
                    </div>

                    <hr />
                    <h6 class="fw-semibold">Zone Rules</h6>
                    <p class="text-secondary small">
                        Max automation rules a zone can hold (Zone &rarr; Automation rules). Hard ceiling
                        is 32 regardless of this value - past that the device firmware silently drops
                        extra rules.
                    </p>
                    <div class="mb-0">
                        <label asp-for="MaxRulesPerZone" class="form-label"></label>
                        <input asp-for="MaxRulesPerZone" class="form-control" style="width:10rem" />
                        <span asp-validation-for="MaxRulesPerZone" class="text-danger"></span>
                    </div>
                    <hr />
                    <h6 class="fw-semibold">Water pump safety</h6>
                    <p class="text-secondary">
                        Water pump safety limits: a hard ceiling the device enforces
                        AFTER whichever mode (threshold/interval/schedule) decides the pump should
                        run, independent of it. 0 disables either one. These are only the defaults
                        seeded onto a newly-added device - edit an existing device's own values
                        under Device &rarr; Controller &rarr; Safety Limits.
                    </p>
                    <div class="mb-3">
                        <label asp-for="WaterPumpMaxRunSeconds" class="form-label"></label>
                        <input asp-for="WaterPumpMaxRunSeconds" class="form-control" />
                        <span asp-validation-for="WaterPumpMaxRunSeconds" class="text-danger"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="WaterPumpCooldownSeconds" class="form-label"></label>
                        <input asp-for="WaterPumpCooldownSeconds" class="form-control" />
                        <span asp-validation-for="WaterPumpCooldownSeconds" class="text-danger"></span>
                    </div>
                    <div class="mt-3">
                        @if (!isReadOnly)
                        {
                            <input type="submit" value="Save" class="btn btn-primary" data-action="save" />
                        }
                    </div>
                    </form>
                    </div>

                    <div class="tab-pane fade" id="tab-accounts" role="tabpanel">
                    <form asp-action="SaveAccounts">
                    <p class="text-secondary">
                        Minimum minutes a user must wait between "resend activation email" requests.
                    </p>
                    <div class="mb-3">
                        <label asp-for="ActivationResendCooldownMinutes" class="form-label"></label>
                        <input asp-for="ActivationResendCooldownMinutes" class="form-control" />
                        <span asp-validation-for="ActivationResendCooldownMinutes" class="text-danger"></span>
                    </div>
                    <p class="text-secondary">
                        Enforced whenever a user sets a new password (registration, admin reset, self
                        change) - never against an existing password already on file.
                    </p>
                    <div class="mb-3" style="width:10rem">
                        <label asp-for="PasswordMinLength" class="form-label"></label>
                        <input asp-for="PasswordMinLength" class="form-control" />
                        <span asp-validation-for="PasswordMinLength" class="text-danger"></span>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="PasswordRequireComplexity" class="form-check-input" />
                        <label asp-for="PasswordRequireComplexity" class="form-check-label"></label>
                    </div>
                    <p class="text-secondary">
                        How long a device registration PIN (Fleet -&gt; Add New Device) stays valid - a
                        leaked/screen-shotted PIN is usable for this long. Fixed presets, not free-text.
                    </p>
                    <div class="mb-0" style="max-width:16rem">
                        <label asp-for="DevicePinValidMinutes" class="form-label"></label>
                        <select asp-for="DevicePinValidMinutes" class="form-select">
                            <option value="5">5 minutes</option>
                            <option value="15">15 minutes</option>
                            <option value="60">1 hour</option>
                            <option value="120">2 hours</option>
                            <option value="360">6 hours</option>
                            <option value="720">12 hours</option>
                            <option value="1440">24 hours</option>
                        </select>
                    </div>
                    <div class="mt-3">
                        @if (!isReadOnly)
                        {
                            <input type="submit" value="Save" class="btn btn-primary" data-action="save" />
                        }
                    </div>
                    </form>
                    </div>

                <div class="tab-pane fade" id="tab-database" role="tabpanel">
                    <ul class="nav nav-pills mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#subtab-retention" type="button" role="tab">Data Retention</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#subtab-archiving" type="button" role="tab">Data Archiving</button>
                        </li>
                    </ul>
                    <div class="tab-content">
                    <div class="tab-pane fade show active" id="subtab-retention" role="tabpanel">
                    <form asp-action="SaveDataRetention">
                    <p class="text-secondary">
                        Automatic sensor data retention. PostgreSQL/TimescaleDB
                        installs enforce this through a native retention policy (whole chunks
                        dropped in the background); MariaDB/MySQL installs enforce it through a
                        daily purge job that deletes rows older than the
                        cutoff. Not set = no automatic retention - data accumulates until purged
                        manually below.
                    </p>
                    <div class="mb-0">
                        <label asp-for="SensorDataRetentionDays" class="form-label"></label>
                        <input asp-for="SensorDataRetentionDays" class="form-control" />
                        <span asp-validation-for="SensorDataRetentionDays" class="text-danger"></span>
                    </div>

                    <div class="mb-3" style="max-width:12rem">
                        <label asp-for="SatelliteRasterRetentionDays" class="form-label"></label>
                        <input asp-for="SatelliteRasterRetentionDays" class="form-control" />
                        <span asp-validation-for="SatelliteRasterRetentionDays" class="text-danger"></span>
                        <div class="form-text">How long a rendered satellite index PNG stays on disk; tenants can override this on their satellite settings.</div>
                    </div>
                    <hr />

                    <h5>Recycle Bin</h5>
                    <p class="text-secondary">
                        A deleted Farm/Device (and its Units/Zones, if it's a Farm) stays
                        restorable from the <a asp-controller="RecycleBin" asp-action="Index">Recycle Bin</a>
                        for this many days by default - individual tenants can set their own
                        retention on their Tenant settings page instead. Past that, it's marked
                        for permanent removal, but is STILL restorable until the purge cycle
                        below actually runs.
                    </p>
                    <div class="mb-3" style="max-width:12rem">
                        <label asp-for="RecycleBinRetentionDays" class="form-label">Default retention (days)</label>
                        <input asp-for="RecycleBinRetentionDays" class="form-control" />
                        <span asp-validation-for="RecycleBinRetentionDays" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="PurgeOrphanedSensorDataScheduleEnabled" class="form-check-input" />
                        <label asp-for="PurgeOrphanedSensorDataScheduleEnabled" class="form-check-label"></label>
                    </div>
                    <div class="mt-3">
                        @if (!isReadOnly)
                        {
                            <input type="submit" value="Save" class="btn btn-primary" data-action="save" />
                        }
                    </div>
                    </form>
                    <hr />
                    <p class="text-secondary">
                        Permanently removes every Farm/Device already marked for purge (Recycle
                        Bin retention elapsed, or an admin's "Delete permanently now"/"Empty
                        Recycle Bin" action) - including its sensorData, config, and everything
                        else tied to it. Irreversible once this runs. Independent of the schedule
                        toggle, this can also be run manually right now.
                    </p>
                    <button type="button" id="purgeOrphanedButton" class="btn btn-outline-danger">Run Recycle Bin Purge Cycle</button>
                    <div id="purgeOrphanedStatus" class="mt-2"></div>

                    <hr />

                    <h5>Manual Data Maintenance</h5>
                    <p class="text-secondary">
                        Applies to sensor telemetry older than the selected threshold, across every
                        device. <strong>Optimize</strong> downsamples it to 5-minute averages
                        (outliers excluded) in place - the data stays, just less precise.
                        <strong>Purge</strong> deletes it completely, with no way to recover it.
                        Both run in the background - this page does not wait for them to finish.
                    </p>
                    <div class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label class="form-label" for="dataMaintenanceThreshold">Older than</label>
                            <select id="dataMaintenanceThreshold" class="form-select">
                                <option value="90">90 days</option>
                                <option value="180">180 days</option>
                                <option value="365" selected>365 days</option>
                                <option value="730">730 days</option>
                                <option value="1825">5 years</option>
                                <option value="3650">10 years</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="button" id="dataMaintenanceOptimize" class="btn btn-outline-primary">Optimize Old Data</button>
                        </div>
                        <div class="col-auto">
                            <button type="button" id="dataMaintenancePurge" class="btn btn-outline-danger">Purge Old Data</button>
                        </div>
                    </div>
                    <div id="dataMaintenanceStatus" class="mt-2"></div>
                    </div>

                    <div class="tab-pane fade" id="subtab-archiving" role="tabpanel">
                        <p class="text-secondary">
                            MariaDB/MySQL only (PostgreSQL/TimescaleDB installs use
                            their own native tiered storage instead, see Data Retention). Moves
                            sensorData rows past the cutoff below to a separate database instead of
                            deleting them - opt-in, inactive until a connection is successfully
                            tested and saved. This section saves on its own, separately from the
                            Data Retention form.
                        </p>
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="archiveEnabledToggle" @(Model.ArchiveEnabled ? "checked" : null) />
                            <label class="form-check-label" for="archiveEnabledToggle">Enable database archiving</label>
                        </div>

                        <div id="archiveConfigSection" style="display:@(Model.ArchiveEnabled ? "block" : "none")">
                            <div class="mb-3" style="max-width:20rem">
                                <label class="form-label" for="archiveCutoffModeSelect">Archive cutoff mode</label>
                                <select id="archiveCutoffModeSelect" class="form-select">
                                    <option value="0" selected="@(Model.ArchiveCutoffMode == ArchiveCutoffMode.Calendar ? "selected" : null)">Calendar (archive two years back every Jan 1)</option>
                                    <option value="1" selected="@(Model.ArchiveCutoffMode == ArchiveCutoffMode.CustomDate ? "selected" : null)">Custom date</option>
                                    <option value="2" selected="@(Model.ArchiveCutoffMode == ArchiveCutoffMode.CustomRollingDays ? "selected" : null)">Rolling window (older than N days)</option>
                                </select>
                            </div>
                            <div class="mb-3" id="archiveCustomDateField" style="max-width:16rem; display:@(Model.ArchiveCutoffMode == ArchiveCutoffMode.CustomDate ? "block" : "none")">
                                <label class="form-label" for="archiveCustomDateInput">Custom cutoff date</label>
                                <input type="date" id="archiveCustomDateInput" class="form-control" value="@(Model.ArchiveCustomCutoffDate?.ToString("yyyy-MM-dd"))" />
                                <div class="form-text">Everything before this date (UTC) is archived - a one-time cutoff, not a moving window.</div>
                            </div>
                            <div class="mb-3" id="archiveRollingDaysField" style="max-width:16rem; display:@(Model.ArchiveCutoffMode == ArchiveCutoffMode.CustomRollingDays ? "block" : "none")">
                                <label class="form-label" for="archiveRollingDaysSelect">Archive data older than</label>
                                <select id="archiveRollingDaysSelect" class="form-select">
                                    <option value="90" selected="@(Model.ArchiveCustomRollingDays == 90 ? "selected" : null)">90 days</option>
                                    <option value="180" selected="@(Model.ArchiveCustomRollingDays == 180 ? "selected" : null)">180 days</option>
                                    <option value="365" selected="@(Model.ArchiveCustomRollingDays == 365 ? "selected" : null)">365 days</option>
                                </select>
                            </div>

                            @if (Model.ArchiveLastRunAtUtc is DateTimeOffset archiveLastRun)
                            {
                                <p class="text-secondary small">Last archive run: @archiveLastRun.ToString("u")</p>
                            }

                            <hr />

                            <div id="archiveCredentialsConfigured" style="display:@(!string.IsNullOrEmpty(Model.ArchiveHost) ? "block" : "none")">
                                <p class="mb-2">
                                    Archive database: <code>@Model.ArchiveUsername@("@")@Model.ArchiveHost:@Model.ArchivePort/@Model.ArchiveDatabaseName</code>
                                </p>
                                <button type="button" id="archiveChangeButton" class="btn btn-outline-secondary btn-sm">Change archive database</button>
                            </div>

                            <div id="archiveCredentialsForm" style="display:@(string.IsNullOrEmpty(Model.ArchiveHost) ? "block" : "none")">
                                <div class="row g-2">
                                    <div class="col-sm-4">
                                        <label class="form-label" for="archiveHostInput">Host</label>
                                        <input type="text" id="archiveHostInput" class="form-control" value="@Model.ArchiveHost" />
                                    </div>
                                    <div class="col-sm-2">
                                        <label class="form-label" for="archivePortInput">Port</label>
                                        <input type="number" id="archivePortInput" class="form-control" value="@(Model.ArchivePort ?? 3306)" />
                                    </div>
                                    <div class="col-sm-3">
                                        <label class="form-label" for="archiveDatabaseNameInput">Database name</label>
                                        <input type="text" id="archiveDatabaseNameInput" class="form-control" value="@Model.ArchiveDatabaseName" />
                                    </div>
                                    <div class="col-sm-3">
                                        <label class="form-label" for="archiveUsernameInput">Username</label>
                                        <input type="text" id="archiveUsernameInput" class="form-control" value="@Model.ArchiveUsername" />
                                    </div>
                                </div>
                                <div class="mb-2 mt-2" style="max-width:20rem">
                                    <label class="form-label" for="archivePasswordInput">Password</label>
                                    <input type="password" id="archivePasswordInput" class="form-control" autocomplete="new-password" />
                                    <div class="form-text">Leave blank to keep the currently stored password (only meaningful when editing other fields on an already-configured archive).</div>
                                </div>
                                <button type="button" id="archiveTestButton" class="btn btn-outline-secondary btn-sm">Test connection</button>
                                <button type="button" id="archiveSaveButton" class="btn btn-outline-primary btn-sm">Save</button>
                                <button type="button" id="archiveCancelButton" class="btn btn-link btn-sm" style="display:@(!string.IsNullOrEmpty(Model.ArchiveHost) ? "inline-block" : "none")">Cancel</button>
                            </div>
                            <div id="archiveStatus" class="mt-2"></div>
                        </div>

                        <div id="archiveDisabledSaveRow" class="mt-2" style="display:@(Model.ArchiveEnabled ? "none" : "block")">
                            <button type="button" id="archiveSaveDisabledButton" class="btn btn-outline-secondary btn-sm">Save</button>
                            <div class="form-text">No connection test needed to disable archiving.</div>
                        </div>
                    </div>
                    </div>
                </div>

                    <div class="tab-pane fade" id="tab-weather" role="tabpanel">
                    <form asp-action="SaveWeather">
                    <p class="text-secondary">
                        When a zone's WaterPump has "Skip when rain predicted" checked
                        (Zone page &rarr; Automation rules), it also stays off whenever the forecast
                        for the location below predicts rain - regardless of what its Threshold/
                        Interval/Schedule rules decide. Requires an OpenWeatherMap API key configured
                        server-side (<code>Weather:ApiKey</code>) - the location/interval/threshold
                        below are inert until both that key AND a location are set.
                    </p>
                    <div class="mb-2">
                        <button type="button" id="weatherUseMyLocation" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-geo-alt"></i> My Location
                        </button>
                        <span id="weatherLocationStatus" class="text-secondary small ms-2"></span>
                    </div>
                    <div id="weatherLocationMap" class="mb-3 rounded border" style="height:320px"></div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="WeatherLocationLat" class="form-label"></label>
                            <input asp-for="WeatherLocationLat" class="form-control" placeholder="e.g. 45.815" />
                            <span asp-validation-for="WeatherLocationLat" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="WeatherLocationLon" class="form-label"></label>
                            <input asp-for="WeatherLocationLon" class="form-control" placeholder="e.g. 15.982" />
                            <span asp-validation-for="WeatherLocationLon" class="text-danger"></span>
                        </div>
                        <div class="form-text">Click the map, drag the marker, use "My Location", or type coordinates directly - all four stay in sync.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="WeatherPollIntervalMinutes" class="form-label"></label>
                        <input asp-for="WeatherPollIntervalMinutes" class="form-control" style="max-width:12rem" />
                        <span asp-validation-for="WeatherPollIntervalMinutes" class="text-danger"></span>
                        <div class="form-text">Takes effect within a minute of saving - no restart needed.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="WeatherRainSkipThreshold" class="form-label"></label>
                        <input asp-for="WeatherRainSkipThreshold" class="form-control" style="max-width:12rem" />
                        <span asp-validation-for="WeatherRainSkipThreshold" class="text-danger"></span>
                        <div class="form-text">Forecast rain probability (%) at or above which watering is skipped.</div>
                    </div>
                    <hr />
                    @{ var weatherState = (Agrumy.Shared.Models.TenantWeatherState)ViewBag.WeatherState; }
                    <p class="mb-0">
                        <strong>Current forecast</strong> <span class="text-secondary small">(default tenant - each tenant has its own on its Tenant Edit page):</span>
                        @if (weatherState.WeatherCheckedAtUtc is DateTimeOffset checkedAt)
                        {
                            <span class="badge @(weatherState.WeatherRainPredicted ? "text-bg-info" : "text-bg-secondary")">
                                @(weatherState.WeatherRainPredicted ? "Rain predicted" : "No rain predicted")
                            </span>
                            <span class="text-secondary small">last checked @checkedAt.ToString("u")</span>
                        }
                        else
                        {
                            <span class="text-secondary small">not checked yet</span>
                        }
                    </p>
                    <hr />
                    <p class="text-secondary">
                        <strong>Frost early warning</strong> uses the same location/API key above -
                        an alert fires once, hours ahead, when the forecast's coldest bucket in the
                        lookahead window is at or below the temperature threshold AND cloudiness/wind
                        are both low enough for radiative frost (clear, calm nights lose heat fastest).
                        Sent to Global admins.
                    </p>
                    <div class="mb-3">
                        <label asp-for="FrostLookaheadHours" class="form-label"></label>
                        <input asp-for="FrostLookaheadHours" class="form-control" style="max-width:12rem" />
                        <span asp-validation-for="FrostLookaheadHours" class="text-danger"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-4">
                            <label asp-for="FrostTempThresholdC" class="form-label"></label>
                            <input asp-for="FrostTempThresholdC" class="form-control" />
                            <span asp-validation-for="FrostTempThresholdC" class="text-danger"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="FrostCloudinessMaxPercent" class="form-label"></label>
                            <input asp-for="FrostCloudinessMaxPercent" class="form-control" />
                            <span asp-validation-for="FrostCloudinessMaxPercent" class="text-danger"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="FrostWindMaxMetersPerSecond" class="form-label"></label>
                            <input asp-for="FrostWindMaxMetersPerSecond" class="form-control" />
                            <span asp-validation-for="FrostWindMaxMetersPerSecond" class="text-danger"></span>
                        </div>
                    </div>
                    <p class="mb-0">
                        <strong>Current forecast</strong> <span class="text-secondary small">(default tenant - each tenant has its own on its Tenant Edit page):</span>
                        @if (weatherState.FrostCheckedAtUtc is DateTimeOffset frostCheckedAt)
                        {
                            <span class="badge @(weatherState.FrostPredicted ? "text-bg-danger" : "text-bg-secondary")">
                                @(weatherState.FrostPredicted ? $"Frost predicted (~{weatherState.FrostPredictedHoursAhead}h)" : "No frost predicted")
                            </span>
                            <span class="text-secondary small">last checked @frostCheckedAt.ToString("u")</span>
                        }
                        else
                        {
                            <span class="text-secondary small">not checked yet</span>
                        }
                    </p>
                    <div class="mt-3">
                        @if (!isReadOnly)
                        {
                            <input type="submit" value="Save" class="btn btn-primary" data-action="save" />
                        }
                    </div>
                    </form>
                    </div>

                    <div class="tab-pane fade" id="tab-gateway" role="tabpanel">
                    <form asp-action="SaveGateway">
                    <p class="text-secondary">
                        Agrumy.Gateway forwards other devices' traffic through
                        <code>POST /api/Gateway/Batch</code> instead of reporting its own sensors - a
                        local WiFi repeater (devices keep their own ApiKey, Gateway is a transparent
                        forwarder), a LoRa/ChirpStack gateway, or a LoRa private-protocol gateway
                        (RadioLib raw PHY over a serial-attached radio-frontend board, no ChirpStack
                        dependency) - the latter two map devices by DevEUI/node address on the
                        <a asp-controller="Gateway" asp-action="Index">Gateway Devices</a> page.
                        Disabled here means GatewayApiController.Batch rejects every call, registered
                        gateways included.
                    </p>
                    <div class="form-check mb-3">
                        <input asp-for="GatewayEnabled" class="form-check-input" />
                        <label asp-for="GatewayEnabled" class="form-check-label"></label>
                    </div>
                    <div class="mb-3" style="max-width:20rem">
                        <label asp-for="GatewayMode" class="form-label"></label>
                        <select asp-for="GatewayMode" class="form-select" asp-items="Html.GetEnumSelectList<Agrumy.Shared.Models.GatewayMode>()"></select>
                        <div class="form-text">
                            Realtime forwards every entry immediately. Aggregated holds entries up to
                            the wait window below before flushing as one batch - only meaningful for
                            a LoRa gateway's decoupled uplink/downlink cycle, a WiFi repeater has no
                            use for it since the device is already blocked waiting on the connection.
                        </div>
                    </div>
                    <div class="mb-0" style="max-width:12rem">
                        <label asp-for="GatewayWaitWindowSeconds" class="form-label"></label>
                        <input asp-for="GatewayWaitWindowSeconds" class="form-control" />
                        <span asp-validation-for="GatewayWaitWindowSeconds" class="text-danger"></span>
                    </div>
                    <div class="mt-3">
                        @if (!isReadOnly)
                        {
                            <input type="submit" value="Save" class="btn btn-primary" data-action="save" />
                        }
                    </div>
                    </form>
                    </div>

                    <div class="tab-pane fade" id="tab-mqtt" role="tabpanel">
                    <form asp-action="SaveMqtt">
                    <p class="text-secondary">
                        Opt-in, alongside the normal HTTP/JWT poll cycle, not a
                        replacement of it. When enabled, a newly-queued command is also published
                        immediately to this broker so a persistently-connected device can act on it
                        before its next poll - OTA/registration/firmware distribution stay on HTTP.
                    </p>
                    <div class="form-check mb-3">
                        <input asp-for="MqttTransportEnabled" class="form-check-input" />
                        <label asp-for="MqttTransportEnabled" class="form-check-label"></label>
                    </div>
                    <div class="mb-3" style="max-width:20rem">
                        <label asp-for="MqttBrokerHost" class="form-label"></label>
                        <input asp-for="MqttBrokerHost" class="form-control" />
                    </div>
                    <div class="mb-3" style="max-width:12rem">
                        <label asp-for="MqttBrokerPort" class="form-label"></label>
                        <input asp-for="MqttBrokerPort" class="form-control" />
                        <span asp-validation-for="MqttBrokerPort" class="text-danger"></span>
                    </div>
                    <div class="mb-3" style="max-width:20rem">
                        <label asp-for="MqttUsername" class="form-label"></label>
                        <input asp-for="MqttUsername" class="form-control" />
                    </div>
                    <div class="mb-0" style="max-width:20rem">
                        <label asp-for="MqttPassword" class="form-label"></label>
                        <input asp-for="MqttPassword" type="password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">Leave blank to keep the currently stored password.</div>
                    </div>
                    <div class="mt-3">
                        @if (!isReadOnly)
                        {
                            <input type="submit" value="Save" class="btn btn-primary" data-action="save" />
                        }
                    </div>
                    </form>
                    </div>

                    <div class="tab-pane fade" id="tab-email" role="tabpanel">
                    <form asp-action="SaveEmail">
                    <p class="text-secondary">
                        SMTP delivery for alert/activation emails - replaces the old
                        appsettings-only configuration, so it's editable here without server file
                        access. Save this tab first, then use "Send test email" below to confirm the
                        connection actually works.
                    </p>
                    <div class="form-check mb-3">
                        <input asp-for="EmailEnabled" class="form-check-input" />
                        <label asp-for="EmailEnabled" class="form-check-label"></label>
                    </div>
                    <div class="mb-3" style="max-width:20rem">
                        <label asp-for="EmailHost" class="form-label"></label>
                        <input asp-for="EmailHost" class="form-control" />
                    </div>
                    <div class="mb-3" style="max-width:12rem">
                        <label asp-for="EmailPort" class="form-label"></label>
                        <input asp-for="EmailPort" class="form-control" />
                        <span asp-validation-for="EmailPort" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="EmailUseStartTls" class="form-check-input" />
                        <label asp-for="EmailUseStartTls" class="form-check-label"></label>
                        <div class="form-text">On (587, default) for STARTTLS, off (465) for implicit TLS.</div>
                    </div>
                    <div class="mb-3" style="max-width:20rem">
                        <label asp-for="EmailUsername" class="form-label"></label>
                        <input asp-for="EmailUsername" class="form-control" />
                    </div>
                    <div class="mb-3" style="max-width:20rem">
                        <label asp-for="EmailPassword" class="form-label"></label>
                        <input asp-for="EmailPassword" type="password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">Leave blank to keep the currently stored password.</div>
                    </div>
                    <div class="mb-3" style="max-width:20rem">
                        <label asp-for="EmailFromAddress" class="form-label"></label>
                        <input asp-for="EmailFromAddress" class="form-control" />
                    </div>
                    <div class="mb-0" style="max-width:20rem">
                        <label asp-for="EmailFromName" class="form-label"></label>
                        <input asp-for="EmailFromName" class="form-control" />
                    </div>

                    <div class="mt-3">
                        @if (!isReadOnly)
                        {
                            <input type="submit" value="Save" class="btn btn-primary" data-action="save" />
                        }
                    </div>
                    <hr />
                    <div class="mb-0" style="max-width:24rem">
                        <label class="form-label" for="testEmailRecipient">Send test email to</label>
                        <div class="input-group">
                            <input type="email" id="testEmailRecipient" class="form-control" placeholder="you@example.com" />
                            <button type="button" id="testEmailButton" class="btn btn-outline-secondary">Send test email</button>
                        </div>
                        <div id="testEmailStatus" class="mt-2"></div>
                    </div>
                    </form>
                    </div>

                    <div class="tab-pane fade" id="tab-webhook" role="tabpanel">
                    <form asp-action="SaveWebhook">
                    <p class="text-secondary">
                        Sends a signed HTTP POST to an external URL for every alert - replaces the old
                        appsettings-only configuration, so it's editable here without server file
                        access. Save this tab first, then use "Send test webhook" below to confirm the
                        endpoint actually receives it.
                    </p>
                    <div class="form-check mb-3">
                        <input asp-for="WebhookEnabled" class="form-check-input" />
                        <label asp-for="WebhookEnabled" class="form-check-label"></label>
                    </div>
                    <div class="mb-3" style="max-width:28rem">
                        <label asp-for="WebhookUrl" class="form-label"></label>
                        <input asp-for="WebhookUrl" class="form-control" placeholder="https://example.com/agrumy-hook" />
                        <div class="form-text">Must be https://.</div>
                    </div>
                    <div class="mb-0" style="max-width:20rem">
                        <label asp-for="WebhookSecret" class="form-label"></label>
                        <input asp-for="WebhookSecret" type="password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">Leave blank to keep the currently stored secret. Used to sign each POST body (X-Agrumy-Signature, HMAC-SHA256).</div>
                    </div>

                    <div class="mt-3">
                        @if (!isReadOnly)
                        {
                            <input type="submit" value="Save" class="btn btn-primary" data-action="save" />
                        }
                    </div>
                    <hr />
                    <div class="mb-0">
                        <button type="button" id="testWebhookButton" class="btn btn-outline-secondary">Send test webhook</button>
                        <div id="testWebhookStatus" class="mt-2"></div>
                    </div>

                    <hr />
                    <h6 class="text-uppercase text-secondary small">SSRF allowlist</h6>
                    <p class="text-secondary small">
                        The Webhook URL above is blocked by default if it points at a private/LAN address
                        or isn't https - add an exact hostname or a CIDR range (e.g.
                        <code>192.168.1.0/24</code>) here to relax either check for an internal endpoint
                        you trust. This list is webhook-only; the Firmware page's Custom repository
                        allowlist is separate. Added/removed immediately, independent of this tab's own
                        Save button above.
                    </p>
                    @{ var webhookAllowlist = (ViewBag.WebhookSsrfAllowlist as IReadOnlyList<Agrumy.Shared.Models.SsrfAllowlistEntry>) ?? []; }
                    @if (webhookAllowlist.Count > 0)
                    {
                        <table class="table table-sm align-middle" style="max-width:40rem">
                            <thead>
                                <tr>
                                    <th>Hostname / CIDR</th>
                                    <th>Allow private</th>
                                    <th>Allow http</th>
                                    @if (!isReadOnly)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in webhookAllowlist)
                                {
                                    <tr>
                                        <td><code>@entry.Pattern</code></td>
                                        <td>@(entry.AllowPrivateNetwork ? "Yes" : "-")</td>
                                        <td>@(entry.AllowInsecureHttp ? "Yes" : "-")</td>
                                        @if (!isReadOnly)
                                        {
                                            <td><button type="button" class="btn btn-sm btn-outline-danger webhook-allowlist-delete" data-id="@entry.Id"><i class="bi bi-trash"></i></button></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    @if (!isReadOnly)
                    {
                        <div class="row g-3 align-items-end mb-0" style="max-width:40rem">
                            <div class="col-md-6">
                                <label class="form-label">Hostname or CIDR</label>
                                <input type="text" id="webhookAllowlistPattern" class="form-control" placeholder="192.168.1.50 or 192.168.1.0/24" />
                            </div>
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input type="checkbox" id="webhookAllowlistAllowPrivate" class="form-check-input" />
                                    <label class="form-check-label" for="webhookAllowlistAllowPrivate">Allow private</label>
                                </div>
                                <div class="form-check">
                                    <input type="checkbox" id="webhookAllowlistAllowHttp" class="form-check-input" />
                                    <label class="form-check-label" for="webhookAllowlistAllowHttp">Allow http</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <button type="button" id="webhookAllowlistAddButton" class="btn btn-outline-primary"><i class="bi bi-plus-lg"></i> Add</button>
                            </div>
                            <div class="col-12">
                                <div id="webhookAllowlistStatus" class="mt-2"></div>
                            </div>
                        </div>
                    }
                    </form>
                    </div>

                    <div class="tab-pane fade" id="tab-odata" role="tabpanel">
                    <form asp-action="SaveOData">
                    <p class="text-secondary">
                        A read-only OData v4 feed of this install's own sensor readings, scoped to the
                        signed-in account's organization the same way every other endpoint is - Power BI's
                        native "OData feed" connector understands $filter/$select/$orderby/$top natively
                        against it, no manual Power Query M transforms needed (unlike the plain "Web"
                        connector against the regular REST endpoints).
                    </p>
                    <div class="form-check mb-3">
                        <input asp-for="ODataEnabled" class="form-check-input" />
                        <label asp-for="ODataEnabled" class="form-check-label"></label>
                    </div>
                    <div class="mt-3">
                        @if (!isReadOnly)
                        {
                            <input type="submit" value="Save" class="btn btn-primary" data-action="save" />
                        }
                    </div>
                    @{ var odataUrl = $"{(ViewBag.ApiServiceUrl as string)?.TrimEnd('/')}/api/odata/SensorData"; }
                    <div class="mb-0">
                        <label class="form-label">Feed URL</label>
                        <div class="input-group" style="max-width:40rem">
                            <input type="text" class="form-control" value="@odataUrl" readonly />
                        </div>
                        <div class="form-text">
                            Paste this into Power BI's "Get Data &rarr; OData feed" dialog. This endpoint
                            takes the same JWT bearer token as the rest of the API, not a username/password
                            Power BI's connector understands natively - choose its "Web API" credential
                            type and supply an <code>Authorization</code> header with
                            <code>Bearer &lt;token&gt;</code>, where the token comes from
                            <code>POST /api/User/Login</code>. The token expires like any normal login
                            session, so it needs pasting in again periodically - not a set-and-forget
                            connection. Disabled above, this URL answers 404.
                        </div>
                    </div>
                    </form>
                    </div>

                    <div class="tab-pane fade" id="tab-arkod" role="tabpanel">
                    <form asp-action="SaveArkod">
                    <p class="text-secondary">
                        The Open-Field parcel boundary editor's primary ARKOD lookup
                        ("Find ARKOD parcel by click") queries APPRRR's public WMS directly from the
                        browser and needs nothing configured here. This section is the offline/secondary
                        path: a local mirror of APPRRR's whole-Croatia ARKOD parcel GeoPackage (weekly
                        refreshed upstream, roughly 900&nbsp;MB) that keeps "Look up this ID" working with
                        no outbound internet at request time.
                    </p>
                    <div class="form-check mb-3">
                        <input asp-for="ArkodGeoPackageSyncEnabled" class="form-check-input" />
                        <label asp-for="ArkodGeoPackageSyncEnabled" class="form-check-label"></label>
                        <div class="form-text">Off by default - a weekly ~900 MB download is a real resource commitment, not something a fresh install should opt into silently.</div>
                    </div>
                    <p class="text-secondary small mb-1">
                        Last synced:
                        <span id="arkodGeoPackageLastSynced">@(Model.ArkodGeoPackageSyncedAtUtc is DateTimeOffset syncedAt ? syncedAt.ToString("u") : "never")</span>
                        @if (!isReadOnly)
                        {
                            <button type="button" id="arkodGeoPackageSyncNowBtn" class="btn btn-sm btn-outline-primary ms-2">Sync now</button>
                        }
                    </p>
                    <p class="text-secondary small fst-italic mb-3" id="arkodGeoPackageSyncNowStatus" hidden></p>
                    <div class="mt-3">
                        @if (!isReadOnly)
                        {
                            <input type="submit" value="Save" class="btn btn-primary" data-action="save" />
                        }
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Manual upload (offline deployments)</label>
                        <div class="input-group" style="max-width:40rem">
                            <input type="file" id="arkodGeoPackageFile" class="form-control" accept=".gpkg" />
                            <button type="button" id="arkodGeoPackageUploadBtn" class="btn btn-outline-primary">Upload</button>
                        </div>
                        <div class="form-text">
                            For a server with no outbound internet: download the GeoPackage yourself from
                            APPRRR's public download page on another machine, then upload it here - same
                            end result as the automatic sync above.
                        </div>
                        <p class="text-secondary small fst-italic mt-2" id="arkodGeoPackageUploadStatus" hidden></p>
                    </div>
                    </form>
                    </div>

            </div>
        </fieldset>
    </div>
</div>

<script nonce="@Context.CspNonce()">
    document.addEventListener('DOMContentLoaded', function () {
        const uploadBtn = document.getElementById('arkodGeoPackageUploadBtn');
        const fileInput = document.getElementById('arkodGeoPackageFile');
        const status = document.getElementById('arkodGeoPackageUploadStatus');
        if (!uploadBtn) {
            return;
        }
        uploadBtn.addEventListener('click', async () => {
            const file = fileInput.files[0];
            if (!file) {
                return;
            }
            status.hidden = false;
            status.textContent = `Uploading ${file.name} (${(file.size / 1e6).toFixed(0)} MB) - this can take a while...`;
            uploadBtn.disabled = true;
            const formData = new FormData();
            formData.append('file', file);
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            try {
                const response = await fetch('/ServerConfig/ArkodGeoPackageUpload', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: formData,
                });
                status.textContent = response.ok ? 'Uploaded - reload the page to see the updated "Last synced" time.' : 'Upload failed.';
            } catch (err) {
                status.textContent = 'Upload failed (network error).';
            } finally {
                uploadBtn.disabled = false;
            }
        });

        const syncNowBtn = document.getElementById('arkodGeoPackageSyncNowBtn');
        const syncNowStatus = document.getElementById('arkodGeoPackageSyncNowStatus');
        const lastSyncedSpan = document.getElementById('arkodGeoPackageLastSynced');
        if (!syncNowBtn) {
            return;
        }
        syncNowBtn.addEventListener('click', async () => {
            syncNowStatus.hidden = false;
            syncNowStatus.textContent = 'Checking upstream (HEAD request) - only re-downloads if it changed...';
            syncNowBtn.disabled = true;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            try {
                const response = await fetch('/ServerConfig/ArkodGeoPackageSyncNow', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                });
                if (!response.ok) {
                    syncNowStatus.textContent = 'Sync failed.';
                } else {
                    const result = await response.json();
                    if (!result.syncEnabled) {
                        syncNowStatus.textContent = 'Sync is disabled - enable it above and Save first.';
                    } else {
                        syncNowStatus.textContent = result.downloaded
                            ? 'Downloaded a new GeoPackage from APPRRR.'
                            : 'Already up to date - upstream has not changed.';
                        if (result.lastSyncedUtc && lastSyncedSpan) {
                            lastSyncedSpan.textContent = new Date(result.lastSyncedUtc).toISOString().replace('T', ' ').slice(0, 19) + 'Z';
                        }
                    }
                }
            } catch (err) {
                syncNowStatus.textContent = 'Sync failed (network error).';
            } finally {
                syncNowBtn.disabled = false;
            }
        });
    });
</script>

<div class="modal fade" id="purgeConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Purge</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    This permanently deletes sensor data older than the selected threshold -
                    nothing is kept, not even a downsampled aggregate. This cannot be undone.
                </p>
                <label class="form-label" for="purgeConfirmPhrase">Type <code>PURGE</code> to confirm</label>
                <input type="text" id="purgeConfirmPhrase" class="form-control" autocomplete="off" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="purgeConfirmSubmit" class="btn btn-danger" disabled>Purge</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="purgeOrphanedConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Recycle Bin Purge Cycle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    This permanently deletes every Farm/Device already marked for purge (retention
                    elapsed, or an admin's "Delete permanently now"/"Empty Recycle Bin" action) -
                    including sensorData, config, and everything else tied to it. This cannot be undone.
                </p>
                <label class="form-label" for="purgeOrphanedConfirmPhrase">Type <code>PURGE</code> to confirm</label>
                <input type="text" id="purgeOrphanedConfirmPhrase" class="form-control" autocomplete="off" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="purgeOrphanedConfirmSubmit" class="btn btn-danger" disabled>Purge</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
}

@section Scripts {
    <script src="~/js/data-maintenance.js"></script>
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/weather-location.js"></script>
    <script src="~/js/send-test-email.js"></script>
    <script src="~/js/send-test-webhook.js"></script>
    <script src="~/js/archive-settings.js"></script>
    <script src="~/js/webhook-ssrf-allowlist.js"></script>
    <script src="~/js/live-refresh.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            startLiveRefresh({
                url: '@Url.Action("Health")',
                applyHtml: function (html) {
                    document.getElementById('serverHealthContainer').innerHTML = html;
                },
                intervalMs: 30000
            });
            const activeTab = '@(ViewBag.ActiveTab as string)';
            const tabButton = activeTab ? document.querySelector('[data-bs-target="#tab-' + activeTab + '"]') : null;
            if (tabButton) {
                bootstrap.Tab.getOrCreateInstance(tabButton).show();
            }
        });
    </script>
}
