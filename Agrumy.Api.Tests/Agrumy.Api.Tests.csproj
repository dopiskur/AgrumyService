<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Agrumy.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Refit" Version="15.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agrumy.Api\Agrumy.Api.csproj" />
    <ProjectReference Include="..\Agrumy.Shared\Agrumy.Shared.csproj" />
    <ProjectReference Include="..\Agrumy.Rules\Agrumy.Rules.csproj" />
    <ProjectReference Include="..\Agrumy.Web\Agrumy.Web.csproj" />
    <ProjectReference Include="..\Agrumy.Gateway\Agrumy.Gateway.csproj" />
    <ProjectReference Include="..\tools\Agrumy.ContractGen\Agrumy.ContractGen.csproj" />
    <ProjectReference Include="..\tools\Agrumy.MqttCredentialSync\Agrumy.MqttCredentialSync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- firmware<->API contract schemas, validated by ContractTests.cs -->
    <None Include="..\contracts\device-api\*.json" Link="contracts\device-api\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- shared with AgrumyFirmware's test_native_threshold_logic - see the file's own header comment -->
    <None Update="TestVectors\threshold_vectors.csv" CopyToOutputDirectory="PreserveNewest" />
    <!-- shared with AgrumyFirmware's test_native_rule_tree_limits - see the file's own header comment -->
    <None Update="TestVectors\rule_tree_limits.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- independent role-per-endpoint source of truth for HttpEndpointTests - see its own header comment -->
    <None Update="TestVectors\role_endpoint_matrix.csv" CopyToOutputDirectory="PreserveNewest" />
    <!-- shared with AgrumyFirmware's test_native_lora_private_session_logic and contracts/lora-private-v2.vectors.json there - see LoRaPrivatePayloadCryptoTests.cs's own header comment -->
    <None Update="TestVectors\lora_private_v2_vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
